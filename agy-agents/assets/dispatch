#!/usr/bin/env bash
#
# Dispatch one task to the implementer model through the Antigravity CLI,
# headlessly. This is the only sanctioned way to call `agy` in this project.
#
# Four things about agy shape this whole script.
#
# First, `--add-dir` is not optional. agy's default CLI project has no
# resources attached (projectResources is {}), so a headless run gets a scratch
# workspace under ~/.gemini/antigravity-cli/scratch and every path in the
# prompt resolves to nothing. The init event still reports the real cwd, which
# makes this look like it worked: an early probe reported "not a git
# repository", "php is not recognized" and "scripts/gates: No such file", while
# status read SUCCESS.
#
# Second, it cannot be trusted by exit code. A tool call it is not permitted to
# make is *soft-denied*: the run continues, the process exits 0, `status` still
# reads SUCCESS, and the only trace is a notice on stderr. Verified with a
# probe whose every command was blocked; it exited 0, status SUCCESS, empty
# response. So this script parses the event stream and judges the run itself.
#
# Third, its permission system is inverted in headless mode.
# `permissions.allow` is honoured interactively but ignored under --print, so
# every allowed command is denied and the run lies about it. A fence that
# blocks the work and permits the lie is worse than none, so we run with
# --dangerously-skip-permissions and put a fence we control around it instead:
# .agy/tripwire, which records the surfaces the implementer must never touch,
# before and after the run.
#
# The flag lives in here, never in a bare command, so it cannot be used without
# the fence attached to it. If the fence will not arm, the dispatch does not
# happen.
#
# Fourth, it can do the work, write the report, make the commit, and then never
# emit its result event — trapped in an internal manage_task/schedule loop. No
# error, no stderr, process alive, and it will sit there until --print-timeout
# expires 45 minutes later. Observed on a run whose work was complete and
# committed two minutes in; the last event was a schedule call asking to be
# woken in 20 seconds, and the stream was still silent 16 minutes later.
# Nothing about the process distinguishes this from slow work — the tell is
# that the event stream stopped growing. Hence the watchdog: when the stream
# goes quiet for AGY_IDLE_TIMEOUT, kill agy and fall through to the report
# freshness check, the fence and the gates. A report written by this run, plus
# a clean fence, plus a green gate, is a pass regardless of how the process
# died.
#
# The watchdog catches the silent form of that. The chatty form keeps emitting
# events while it is stuck, so the stream never goes quiet and agy's own
# --print-timeout ends it instead: `timeout waiting for response` at 2711s wall
# against 364s of thread time, on a run that had already committed the work.
# Both forms end with no result event, and THAT is what the deferral keys on —
# not on whether we did the killing. Status, an empty response and an exit code
# from a session that died describe the death, not the work.
#
# ---------------------------------------------------------------------------
# MODEL GROUPS AND FALLBACK
#
# Antigravity meters two independent buckets, each with its own weekly and
# 5-hour limit:
#
#   GEMINI MODELS          Gemini Flash, Gemini Pro          <- primary
#   CLAUDE AND GPT MODELS  Claude Opus, Claude Sonnet, GPT   <- reserve
#
# Gemini is always tried first. The Claude group drains much faster for the
# same work, so it is a reserve and never a co-equal: we fall back only when
# Gemini's *weekly* limit is gone. A spent 5-hour window is not a reason to
# burn the reserve — it refreshes on its own within hours, so we report and
# hold instead.
#
# `agy` exposes quota only in its interactive panel; there is no subcommand to
# query it (`agy quota` produces nothing, and no quota verb appears in
# `agy --help`). So exhaustion is detected from the failure itself rather than
# polled in advance.
#
# Nothing about being in fallback is ever persisted. Every dispatch starts on
# Gemini again, which is what makes "switch back the moment it is available"
# automatic — there is no sticky flag that could strand you on the reserve.
#
# CAVEAT, and it is load-bearing: the classifier below is written against the
# vocabulary these errors normally use, not against a captured Antigravity
# exhaustion event. It is therefore deliberately conservative. A quota-shaped
# error that does not clearly say *weekly* does NOT trigger fallback; it stops
# and prints the raw text, so the first genuine occurrence tells you the exact
# string and this matcher gets corrected once. Use AGY_FALLBACK=force in the
# meantime — the interactive panel shows the real number.
# ---------------------------------------------------------------------------
#
# Usage:
#   .agy/dispatch 4                # runs <workspace>/task-4-dispatch.md
#   .agy/dispatch --file <path>    # runs an arbitrary prompt file
#   .agy/dispatch --continue 4     # resumes the last conversation
#
# Overrides (environment beats .agy/config):
#   AGY_MODEL, AGY_FALLBACK_MODEL, AGY_EFFORT, AGY_TIMEOUT, AGY_ARGS
#   AGY_SKIP_GATES=1               report only; do not run the gates
#   AGY_FALLBACK=auto|force|off    default auto
#     auto  - Gemini first; reserve only on a clear weekly exhaustion
#     force - go straight to the reserve (use when the panel already shows the
#             Gemini weekly bucket spent)
#     off   - never use the reserve; fail instead

set -uo pipefail

# Every refusal below ends here, and it prints a verdict block to do it.
#
# The exit status was always right — a missing dispatch file has exited 2 since
# the first version — but the status is the half of the signal that does not
# survive the way the harness actually gets run. `.agy/dispatch 3 | tee log`
# hands the caller tee's 0; so does a backgrounded wrapper that reports whether
# it managed to start the job. What reaches the reader is then one line of prose
# in a log that is otherwise shaped exactly like a clean run, and a controller
# scanning for the verdict block finds nothing wrong because it finds nothing.
#
# So a refusal produces the same block a finished run produces, and its first
# line is the one a controller reads first. Prose and status agree, and the
# prose is the copy that cannot be swallowed by a pipe.
die() { # die <exit-code> <headline> [extra lines...]
	code="$1"; headline="$2"; shift 2
	{
		printf -- '\n--- verdict --------------------------------------------------------\n'
		printf '  %-7s %s\n' run "DID NOT RUN — $headline"
		while [ $# -gt 0 ]; do printf '  %-7s %s\n' '' "$1"; shift; done
		printf '  %-7s %s\n' exit "$code"
		printf '\n  Nothing was dispatched: no model was called and the tree is untouched.\n'
	} >&2
	exit "$code"
}

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || \
	die 2 'not a git repository'
cd "$ROOT" || die 2 "cannot cd to the repository root ($ROOT)"

[ -f .agy/config ] || die 2 'no .agy/config' 'run the agy-agents installer in this repository'
# shellcheck disable=SC1091
. .agy/config

: "${AGY_WORKSPACE:=.agy/work}"
: "${AGY_GATES:=}"
: "${AGY_MODEL:=gemini-3.7-flash-high}"
: "${AGY_FALLBACK_MODEL:=claude-opus-4-6-thinking}"
: "${AGY_FALLBACK:=auto}"
: "${AGY_EFFORT:=high}"
: "${AGY_TIMEOUT:=45m}"

# The file every implementer and reviewer reads before anything else. Defaulted
# rather than required in .agy/config, so a config written by an older installer
# still finds it.
: "${AGY_CONTEXT:=$AGY_WORKSPACE/dispatch-context.md}"

# Seconds of event-stream silence before a run is presumed hung (failure 4).
# 300 is roughly six times the longest gap seen between events on a healthy
# run, where the gate — the slowest single tool call — takes about 50 seconds.
# 0 disables the watchdog.
: "${AGY_IDLE_TIMEOUT:=300}"
: "${AGY_IDLE_POLL:=15}"

# Total wall seconds before the run is presumed livelocked, whatever the stream
# is doing. The idle watchdog above measures *silence*, so it cannot see a model
# that has finished the work and then parked itself in a poll loop — one
# observed failure scheduled a 5-second wake to check its own verify task, never
# woke, and re-armed: the stream kept growing, the run stayed alive, and the
# fence, gates and verdict never printed because the wrapper was still waiting.
# The work had been committed eleven minutes earlier. A cap on elapsed time is
# the only control that sees this, because it asks nothing of the stream.
#
# 2700 is well past any healthy run observed (the longest legitimate implement
# phase measured under 20 minutes) and well short of an afternoon. Neither cap
# is a verdict: both hand the judgement to the fence, the gates and the report,
# all three of which are computable without the model's cooperation. 0 disables.
: "${AGY_MAX_WALL:=2700}"

LOGDIR="$AGY_WORKSPACE/logs"

case "$AGY_FALLBACK" in
	auto|force|off) ;;
	*) die 2 "AGY_FALLBACK must be auto, force or off (got '$AGY_FALLBACK')" ;;
esac

AGY="$(command -v agy 2>/dev/null)"
[ -n "$AGY" ] || AGY="$HOME/AppData/Local/agy/bin/agy.exe"
if [ ! -x "$AGY" ]; then
	die 127 "agy not found (looked for $AGY)" \
		'read reference/setup.md — the CLI is not installed or not on PATH'
fi

CONTINUE=""
if [ "${1:-}" = "--continue" ]; then
	CONTINUE="--continue"
	shift
fi

# The prompt stays one line on purpose: the implementer reads the same disk you
# do, so a dispatch points at a file rather than quoting it.
if [ "${1:-}" = "--file" ]; then
	[ -f "${2:-}" ] || die 2 "no such prompt file: ${2:-(none given)}"
	PROMPT="Read ${2} and execute it in full."
	PROMPT_FILE="$2"
	LABEL="$(basename "$2" | sed 's/\.[^.]*$//')"
	# A correction file is still a task. Every fix round is sent this way
	# (`--continue --file task-7-fix3.md`), and an empty REPORT gates off both
	# the report contract and the claims comparison — so the dispatches most
	# likely to be cutting corners were the only ones running unchecked, and
	# nothing said so. The label already carries the task number; recover the
	# report path from it, and fall back to none only when the prompt file is
	# not named after a task. Checks still require a report written during THIS
	# run, so a correction that does not touch it is skipped exactly as before.
	case "$LABEL" in
	task-[0-9]*)
		REPORT="$AGY_WORKSPACE/task-$(printf '%s' "$LABEL" |
			sed 's/^task-\([0-9][0-9]*\).*/\1/')-report.md" ;;
	*) REPORT="" ;;
	esac
elif [ -n "${1:-}" ]; then
	N="$1"
	DISPATCH="$AGY_WORKSPACE/task-$N-dispatch.md"
	[ -f "$DISPATCH" ] || die 2 "no dispatch file at $DISPATCH" \
		'write the brief there first — the implementer is told to read it'
	PROMPT="Read $DISPATCH and execute it in full."
	PROMPT_FILE="$DISPATCH"
	LABEL="task-$N"
	REPORT="$AGY_WORKSPACE/task-$N-report.md"
else
	die 2 'no task given' \
		'usage: .agy/dispatch [--continue] <task-number> | --file <path>'
fi

# ------------------------------------------------------- the brief must be real
# The installer writes dispatch-context.md and the task template from stubs full
# of {{PLACEHOLDER}} markers, and it cannot fill them — only the controller knows
# what goes in. Nothing used to check that it had. dispatch-context.md is the one
# file EVERY implementer and reviewer reads, so an unfilled one is inherited by
# every agent in the plan: they are told the language floor is
# "{{Language/runtime floor}}", read that as no constraint, and the gates cannot
# catch what was never specified.
#
# This refuses rather than warns. A warning on the noisiest line of a dispatch is
# a warning nobody reads, and the failure it guards against is silent by
# construction — the run will look perfect. Cost of the refusal is a minute of
# typing; cost of missing it is a milestone built against a brief that said
# PLACEHOLDER.
check_unfilled() { # <path> <what-it-is>
	local f="$1" what="$2" hits n
	if [ ! -f "$f" ]; then
		printf 'dispatch: no %s at %s\n' "$what" "$f" >&2
		printf '          Every agent on this plan reads it. Run the installer, or\n' >&2
		printf '          point AGY_CONTEXT at the file you use instead.\n' >&2
		return 1
	fi
	# Both shapes the templates leave behind: {{...}} markers, and the quoted
	# "fill this in" note the controller is told to delete once it is real.
	hits="$(grep -n -e '{{[^}]*}}' -e 'Delete this quote block' "$f" 2>/dev/null)"
	[ -n "$hits" ] || return 0
	n="$(printf '%s\n' "$hits" | wc -l | tr -d ' ')"
	printf 'dispatch: %s is still a template — %s unfilled line(s) in %s\n' "$what" "$n" "$f" >&2
	printf '%s\n' "$hits" | head -8 | sed 's/^/          /' >&2
	[ "$n" -gt 8 ] && printf '          … and %s more\n' "$((n - 8))" >&2
	return 1
}

unfilled=0
check_unfilled "$AGY_CONTEXT" 'the shared dispatch context' || unfilled=1
check_unfilled "$PROMPT_FILE" "this task's brief" || unfilled=1
if [ "$unfilled" -ne 0 ] && [ "${AGY_ALLOW_UNFILLED:-0}" != "1" ]; then
	printf '\ndispatch: REFUSING TO DISPATCH against an unfilled brief. The run would\n' >&2
	printf 'succeed, the gates would pass, and the constraint you meant to impose\n' >&2
	printf 'would simply not exist. Fill the lines above first.\n' >&2
	printf 'Deliberate — a real {{...}} in the text? AGY_ALLOW_UNFILLED=1.\n' >&2
	die 2 'the brief is still a template' 'see the unfilled lines listed above'
fi

# The trailer rule exists in two renderings: AGY_COAUTHOR, which the check after
# the run enforces, and the trailer block in the context, which is the only copy
# the model ever sees. The installer writes both from one value. Edit one of them
# afterwards — change the config, hand-edit the context, copy a context in from
# another project — and the model is now told a different rule from the one it
# will be judged by. Every run then fails on a trailer the implementer copied
# faithfully, and the diagnosis points at the implementer, which is the one place
# the fault is not.
#
# So it refuses here, before anything is dispatched, for the same reason the
# unfilled check does: the cost is one edit, and it is a configuration fault, not
# evidence about anybody's work.
#
# The comparison lowercases both sides through `tr` rather than asking grep for
# `-i`, and `-F` is not optional — an address contains `.`, which is a regex
# metacharacter, so a plain grep would match addresses that differ from this one.
# `grep -iF` is the obvious way to write that pair and it is the one shape that
# cannot be used: GNU grep 3.0 as shipped by Git for Windows ABORTS on `-i`
# combined with `-F` (SIGABRT, rc 134), and an aborting check inside `if !`
# reads as "no match" — so every dispatch on Windows would refuse. Either flag
# alone is fine. This is why the normalisation is done by hand, the same way the
# post-run attribution check does it.
if [ -n "${AGY_COAUTHOR:-}" ] && [ -f "$AGY_CONTEXT" ]; then
	ctx_addr="$(printf '%s' "$AGY_COAUTHOR" |
		sed -n 's/.*<\([^>]*\)>.*/\1/p' | tr 'A-Z' 'a-z')"
	[ -n "$ctx_addr" ] || ctx_addr="$(printf '%s' "$AGY_COAUTHOR" | tr 'A-Z' 'a-z')"
	if ! tr 'A-Z' 'a-z' <"$AGY_CONTEXT" | grep -qF -- "$ctx_addr"; then
		printf '\ndispatch: the context does not carry the co-author the harness checks.\n' >&2
		printf '  .agy/config wants   %s\n' "$AGY_COAUTHOR" >&2
		printf '  %s never names it.\n' "$AGY_CONTEXT" >&2
		printf '\nThe implementer copies the trailer out of that file, so it would be\n' >&2
		printf 'judged against a rule it was never given. Put the same address in\n' >&2
		printf 'both, or re-install to rewrite them from one value.\n' >&2
		die 2 'the co-author rule and the context disagree' \
			"config: $AGY_COAUTHOR" "context: $AGY_CONTEXT does not name it"
	fi
fi

mkdir -p "$LOGDIR"
STAMP="$(date +%Y%m%d-%H%M%S)"
BASE="$LOGDIR/$LABEL-$STAMP"
SNAP="$BASE.fence"

REPO_WIN="$(cygpath -w "$PWD" 2>/dev/null)" || REPO_WIN="$PWD"

printf 'dispatching  %s\n' "$LABEL"
# Which version of the skill wrote this file, stamped by the installer on every
# copy. Nothing in an installed repo recorded it before, and without it a stale
# install is indistinguishable from a current one: two field reports against
# this harness described behaviour that had been fixed several versions earlier,
# and the only way to establish that was to compare their script's line count
# against ours. A report that quotes this line is adjudicated in one read.
#
# If `{{SKILL_VERSION}}` appears here instead of a number, the asset was copied
# by hand rather than installed — worth seeing for exactly the same reason.
AGY_SKILL_VERSION='{{SKILL_VERSION}}'
printf 'skill        agy-agents %s\n' "$AGY_SKILL_VERSION"
# Which binary this resolved to, always, because on MSYS it is not always the
# one you think: a Windows-form PATH entry (C:\...) is accepted by `export` and
# then never searched, so the entry you added is skipped in silence and the next
# `agy` on PATH — the real, quota-spending one — answers instead. Printing the
# resolved path is the whole fix; you cannot misread an absolute path.
printf 'binary       %s\n' "$AGY"
# ------------------------------------------------------- --effort is Gemini-only
# `--effort` is a real session flag, and `agy --help` lists it without
# qualification — but only the Gemini models accept it. Claude and GPT reject it
# outright: the process exits within seconds having taken zero turns, which on
# the way past looks like a fast crash with no cause rather than a bad flag.
#
# Passing it unconditionally made the reserve path unrunnable in every repository
# this skill has ever installed. Nothing caught it because the fallback is rare,
# and when it did fire the symptom — a reserve attempt that dies instantly after
# a quota failure — is indistinguishable from the quota failure continuing.
#
# Keyed off the model string at the point of use, NOT off which config slot the
# model arrived in. AGY_MODEL and AGY_FALLBACK_MODEL may each hold either family:
# a repo that makes Claude primary and keeps Gemini as the reserve is a supported
# inversion, and the flag has to follow the model through it in both directions.
#
# An unrecognised model gets NO flag. A model that could have run at high effort
# and ran at default is a worse run; a model sent a flag it rejects is no run at
# all. Every model outside the Gemini line this skill has seen rejects it, so the
# default falls toward the side that still executes.
#
# This cannot be moved into configuration. `.agy/config` sets AGY_EFFORT with
# `:=`, which fires on null as well as unset, so `AGY_EFFORT=` re-supplies the
# default instead of clearing it — there is no value a user can put in that file
# that suppresses the flag. That dead end is why the key is the model name.
effort_args() { # <model> — the --effort flag pair, or nothing at all
	case "$1" in
		gemini*) printf -- '--effort %s' "$AGY_EFFORT" ;;
		*)       ;;
	esac
}

effort_label() { # <model> — what the banner is allowed to claim
	case "$1" in
		gemini*) printf 'effort %s' "$AGY_EFFORT" ;;
		*)       printf 'no --effort (rejected off the Gemini line)' ;;
	esac
}

if [ "$AGY_FALLBACK" = "force" ]; then
	FIRST_MODEL="$AGY_FALLBACK_MODEL"
	printf 'model        %s (RESERVE, forced) %s, timeout %s\n' "$FIRST_MODEL" "$(effort_label "$FIRST_MODEL")" "$AGY_TIMEOUT"
else
	FIRST_MODEL="$AGY_MODEL"
	printf 'model        %s (%s, timeout %s)\n' "$FIRST_MODEL" "$(effort_label "$FIRST_MODEL")" "$AGY_TIMEOUT"
fi
if [ "$AGY_IDLE_TIMEOUT" -gt 0 ]; then
	printf 'watchdog     kill after %ss of stream silence\n' "$AGY_IDLE_TIMEOUT"
fi
if [ "$AGY_MAX_WALL" -gt 0 ]; then
	printf 'wall cap     kill after %ss total, silent or not\n' "$AGY_MAX_WALL"
fi
printf 'log          %s.ndjson\n\n' "$BASE"
# Provisional. A fallback attempt writes to its own base, so the authoritative
# path is printed again in the verdict block once the run is over; $LOG_BASE is
# what tracks which one that turned out to be.
LOG_BASE="$BASE"

# For the report-freshness check on a watchdog-killed run: a report left over
# from an earlier dispatch must not be read as this run's output.
RUN_START="$(date +%s)"

# --------------------------------------------------------------- arm the fence
# Armed once, verified once at the end. When a fallback attempt runs, the same
# snapshot spans both attempts, so the fence covers everything either model did
# rather than only the last one.
printf -- '--- arming fence ---------------------------------------------------\n'
if ! bash .agy/tripwire snapshot "$SNAP"; then
	printf '\ndispatch: REFUSING TO DISPATCH. The fence would not arm, and this run\n' >&2
	printf 'auto-approves every tool call. Fix .agy/tripwire first.\n' >&2
	die 3 'the fence would not arm' 'the run auto-approves every tool call — unfenced is not an option'
fi

# ------------------------------------------------------- interrupted mid-flight
# From here on the model can move the tree, so from here on this script owes a
# verdict however it ends. Killed between the parser and the fence check it used
# to leave nothing at all: a .class with an empty status, no .gates.log, no
# .response.md, no verdict block — and a commit in history. On disk that is
# indistinguishable from a dispatch that never ran, except HEAD had moved, which
# is the one fact nobody was told. A silent exit after a commit is the same
# failure as a fence that says "clean" without checking: the reader is left with
# an account that reads like nothing happened.
#
# So an interrupt prints a verdict in the usual shape. It is neither a pass nor
# a failure but an unfinished run, and it says so — naming the only thing still
# knowable without the model's cooperation, which is what git holds.
VERDICT_PRINTED=0
AGY_CHILD_PID=""

on_interrupt() { # on_interrupt <signal-name> <exit-code>
	trap - INT TERM
	[ "$VERDICT_PRINTED" -eq 1 ] && exit "$2"

	# agy was started with & — a signal delivered to this script alone never
	# reaches it, and it would go on writing to the log after the verdict said
	# the run had stopped. Same TERM-then-KILL sequence the watchdog uses.
	if [ -n "$AGY_CHILD_PID" ] && kill -0 "$AGY_CHILD_PID" 2>/dev/null; then
		printf '\nINTERRUPT stopping agy (pid %s).\n' "$AGY_CHILD_PID"
		kill -TERM "$AGY_CHILD_PID" 2>/dev/null
		for _ in 1 2 3; do
			kill -0 "$AGY_CHILD_PID" 2>/dev/null || break
			sleep 1
		done
		kill -KILL "$AGY_CHILD_PID" 2>/dev/null
	fi

	int_was="$(awk -F'\t' '$1=="head"{print $2}' "$SNAP/git.txt" 2>/dev/null)"
	int_now="$(git rev-parse HEAD 2>/dev/null)"
	int_dirty="$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')"

	printf -- '\n--- verdict --------------------------------------------------------\n'
	printf '  %-7s %s\n' run "INTERRUPTED by $1 — this run did not finish"
	if [ -n "$int_was" ] && [ -n "$int_now" ] && [ "$int_was" != "$int_now" ]; then
		printf '  %-7s %s\n' landed \
			"$(git rev-list --count "$int_was..$int_now" 2>/dev/null || printf '?') commit(s) — THE TREE MOVED"
		printf '  %-7s %s\n' '' "$int_was..$int_now"
	elif [ "${int_dirty:-0}" -gt 0 ]; then
		printf '  %-7s %s\n' landed "no commit, $int_dirty uncommitted path(s)"
	else
		printf '  %-7s %s\n' landed 'nothing — no commit, clean tree'
	fi
	printf '  %-7s %s\n' fence 'NOT CHECKED'
	printf '  %-7s %s\n' gates 'NEVER RAN'
	printf '  %-7s %s\n' log "$LOG_BASE.ndjson"
	printf '  %-7s %s\n' exit "$2"
	printf '\n  Nothing here has been verified. The fence was armed and never\n'
	printf '  compared, so no guarded surface has been cleared; the gates never\n'
	printf '  ran, so nothing says the work is sound. If the tree moved, read that\n'
	printf '  diff before dispatching again — the next run starts from it.\n'
	printf '  Fence baseline kept at %s\n' "$SNAP"
	exit "$2"
}
trap 'on_interrupt SIGINT 130' INT
trap 'on_interrupt SIGTERM 143' TERM

# ------------------------------------------------------------------ one attempt
# $1 model, $2 output base, $3 extra continue flag ("" or "--continue")
run_attempt() {
	local model="$1" out="$2" cont="$3" started elapsed effort
	effort="$(effort_args "$model")"

	started=$SECONDS

	# --mode accept-edits because the default mode pauses for an interactive
	# diff review that a headless run has no way to answer.
	# shellcheck disable=SC2086
	"$AGY" --print "$PROMPT" \
		$cont \
		--add-dir "$REPO_WIN" \
		--output-format stream-json \
		--model "$model" \
		$effort \
		--mode accept-edits \
		--dangerously-skip-permissions \
		--print-timeout "$AGY_TIMEOUT" \
		${AGY_ARGS:-} \
		> "$out.ndjson" 2> "$out.stderr" &
	local agy_pid=$!
	# Visible to the interrupt handler, which has to stop it before reporting.
	AGY_CHILD_PID="$agy_pid"

	# Watchdog for failure 4. Size, not mtime: the stream is append-only so size
	# is monotone, and a one-second mtime granularity makes short gaps
	# unreadable. Both files count, so a run writing only to stderr still reads
	# as alive.
	local killed=0 idle=0 capped=0
	if [ "$AGY_IDLE_TIMEOUT" -gt 0 ] || [ "$AGY_MAX_WALL" -gt 0 ]; then
		local last_seen=-1 last_change now size n f began wall
		began="$(date +%s)"
		last_change="$began"
		while kill -0 "$agy_pid" 2>/dev/null; do
			sleep "$AGY_IDLE_POLL"
			now="$(date +%s)"

			# The wall cap is tested before the stream is read, because the run
			# it exists to catch is one whose stream looks perfectly healthy.
			wall=$(( now - began ))
			if [ "$AGY_MAX_WALL" -gt 0 ] && [ "$wall" -ge "$AGY_MAX_WALL" ]; then
				capped=1
				printf '\nWALL CAP  run alive for %ss (cap %ss) - killing agy (pid %s).\n' \
					"$wall" "$AGY_MAX_WALL" "$agy_pid"
				printf 'WALL CAP  the stream may still be moving; a model polling itself\n'
				printf 'WALL CAP  is not progress. The verdict now rests on the fence, the\n'
				printf 'WALL CAP  gates and the report.\n'
			else
				n=0
				for f in "$out.ndjson" "$out.stderr"; do
					[ -f "$f" ] && n=$(( n + $(wc -c < "$f" 2>/dev/null || echo 0) ))
				done
				size="$n"
				if [ "$size" != "$last_seen" ]; then
					last_seen="$size"; last_change="$now"; continue
				fi
				[ "$AGY_IDLE_TIMEOUT" -gt 0 ] || continue
				idle=$(( now - last_change ))
				[ "$idle" -lt "$AGY_IDLE_TIMEOUT" ] && continue
				killed=1
				printf '\nWATCHDOG  event stream silent for %ss - killing agy (pid %s).\n' "$idle" "$agy_pid"
				printf 'WATCHDOG  the verdict now rests on the fence, the gates and the report.\n'
			fi

			kill -TERM "$agy_pid" 2>/dev/null
			for _ in 1 2 3 4 5; do
				kill -0 "$agy_pid" 2>/dev/null || break
				sleep 2
			done
			kill -KILL "$agy_pid" 2>/dev/null
			break
		done
	fi

	wait "$agy_pid"
	local rc=$?
	AGY_CHILD_PID=""

	elapsed=$(( SECONDS - started ))

	node - "$out.ndjson" "$out.stderr" "$out.response.md" "$rc" "$out.class" "$elapsed" "$killed" "$idle" "$capped" <<'NODE'
const fs = require('fs');
const [ndjson, stderrPath, responsePath, agyCode, classPath, wall, killedArg, idleArg, cappedArg] =
	process.argv.slice(2);
const killed = killedArg === '1';
const capped = cappedArg === '1';

// Real event shape (verified against agy 1.1.12 — the published docs describe
// a flattened form that does not match the wire):
//   {"event":"init",        "init":        {model, cwd, tools:[...]}}
//   {"event":"step_update", "step_update": {step_index, state, step_type,
//                                           tool_name, tool_info:{name,
//                                           parameters, output, error}, usage}}
//   {"event":"result",      "result":      {status, response, num_turns, usage}}
const events = fs.readFileSync(ndjson, 'utf8')
	.split('\n').filter(Boolean)
	.map(l => { try { return JSON.parse(l); } catch { return null; } })
	.filter(Boolean);

const init = (events.find(e => e.event === 'init') || {}).init || {};
const resultEvent = events.find(e => e.event === 'result');
const result = (resultEvent || {}).result || {};

// No result event means the run was stopped, not that the work failed. Status,
// response and exit code are then artefacts of HOW it ended and are skipped.
//
// The trigger is the missing result event, NOT who did the stopping. The
// watchdog is only one way to arrive here: agy also dies on its own — its
// --print-timeout expiring, an internal error, a dropped connection — and when
// it does the stream was still moving, so the watchdog never fired. Keying the
// deferral on our own kill made that second case report PROBLEMS over a landed
// commit, a clean fence and green gates, on the strength of an exit code that
// only describes the death.
//
// Nothing else is relaxed: a denial, a tool error or zero tool calls still
// fails a stopped run, because each of those is recorded in the stream and is
// evidence of what actually happened.
const deferred = !resultEvent;

const tools = new Map();
const errors = [];
const denials = [];
const deniedCmds = [];
const ranCmds = [];

// A denial and the call that got through are two separate lines in the stream,
// and only their pairing carries the meaning. `cmd /c npm install` is not a
// different command from `npm install` — it is the same command wearing a
// wrapper that a literal-string deny rule cannot see (agy failure 5). Reduce
// both sides to the same shape so the pair becomes visible.
const norm = cmd => {
	let s = String(cmd).trim().replace(/^["']|["']$/g, '');
	// Wrappers nest: `cmd /c "bash -c 'npm install'"` is three deep.
	for (let i = 0; i < 4; i++) {
		const before = s;
		s = s
			.replace(/^(?:cmd(?:\.exe)?\s+\/[a-z]\s+|(?:ba|z|)sh\s+-c\s+|powershell(?:\.exe)?\s+(?:-\w+\s+)*-c(?:ommand)?\s+|npx\s+(?:--yes\s+|-y\s+)?|env\s+|sudo\s+)/i, '')
			.replace(/^["']|["']$/g, '')
			.trim();
		if (s === before) break;
	}
	const t = s.replace(/\s+/g, ' ').trim().split(' ').filter(Boolean);
	// Strip the path and extension off the executable: an absolute path is
	// another way to wear a different name for the same binary.
	if (t.length) t[0] = t[0].replace(/\\/g, '/').replace(/^.*\//, '').replace(/\.(exe|cmd|bat|ps1)$/i, '');
	return t.map(x => x.toLowerCase());
};
// Two tokens is the unit of intent: `npm install`, `git push`, `rm -rf`.
const head = cmd => norm(cmd).slice(0, 2).join(' ');

for (const e of events) {
	const s = e.step_update;
	if (!s || s.step_type !== 'tool' || s.state === 'ACTIVE') continue;
	const info = s.tool_info || {};
	const name = info.name || s.tool_name || 'unknown';
	const cmd = (info.parameters && (info.parameters.CommandLine || info.parameters.command)) || '';

	if (s.state === 'DONE') {
		tools.set(name, (tools.get(name) || 0) + 1);
		if (cmd) ranCmds.push(cmd);
	}

	if (info.error) {
		const msg = (info.error.message || info.error.type || 'error').replace(/\s+/g, ' ');
		// A denial should be impossible, since permissions are skipped. If one
		// appears anyway, the run is not what we think it is — so it stays a
		// hard failure rather than a warning.
		if (/denied permission|permission denied|not allowed|auto-denied/i.test(msg)) {
			denials.push(`${cmd || name}: ${msg}`.slice(0, 200));
			if (cmd) deniedCmds.push(cmd);
		} else {
			errors.push(`${name}${cmd ? ' [' + cmd + ']' : ''}: ${msg}`.slice(0, 200));
		}
	}
}

// Pair each denial with any call that completed under the same intent. This is
// the fact that distinguishes an incomplete run from a compromised one: the
// work described in the report happened, but outside the boundary you set.
const bypasses = [];
for (const d of deniedCmds) {
	const h = head(d);
	if (!h) continue;
	for (const r of ranCmds) {
		if (head(r) !== h) continue;
		bypasses.push(`denied: ${d}   ->   ran: ${r}`.slice(0, 200));
		break;
	}
}

const stderr = fs.existsSync(stderrPath) ? fs.readFileSync(stderrPath, 'utf8').trim() : '';
if (/auto-denied|permission/i.test(stderr) && !denials.length) denials.push(stderr.slice(0, 300));

const response = result.response || '';
if (response) fs.writeFileSync(responsePath, response);

const status = result.status || '';
// Quota is a separate question from deferral, and keys on a different fact. A
// run the WATCHDOG killed is never classified — that guarantee is what stops a
// hang from spending the scarce reserve group. But a run that died on its own
// still gets classified, because a genuine weekly exhaustion is one of the ways
// a session dies without a result event, and the evidence for it is on stderr.
const failed = !killed && (status !== 'SUCCESS' || Number(agyCode) !== 0);

// Quota classification. Only ever consulted on a FAILED run: a successful run
// whose report happens to discuss rate limiting must not be mistaken for an
// exhausted bucket. Conservative by design — see the header. `unknown` means
// "quota-shaped but it never said weekly", and does not authorise the reserve.
let quota = 'none';
let quotaRaw = '';
if (failed) {
	const parts = [JSON.stringify(result.error || ''), status, stderr, response.slice(0, 4000)];
	const hay = parts.join(' \n ').toLowerCase();
	if (/quota|rate.?limit|resource.?exhausted|\b429\b|too many requests|usage limit|limit reached|exhausted/.test(hay)) {
		if (/week/.test(hay)) quota = 'weekly';
		else if (/5.?hour|five.?hour|hourly/.test(hay)) quota = 'fivehour';
		else quota = 'unknown';
		quotaRaw = [JSON.stringify(result.error || ''), stderr].join(' ').replace(/\s+/g, ' ').trim().slice(0, 400);
	}
}

// Printed measurements are measurements the benchmark cannot read back. These
// are the same numbers the summary prints below; they live here so a scraper
// never has to re-derive them, and never has to guess a zero when it cannot.
const uw = result.usage || {};
const nz = v => (typeof v === 'number' && isFinite(v)) ? v : '';
// Every value is sanitised by the same rule, at the one place values enter the
// file. read_class is `sed -n 's/^key=//p' | head -1` — FIRST match wins — so a
// value carrying a newline injects rows that beat the genuine ones further
// down, and `status` comes straight off the agy stream. A lone \r does not
// split the row but corrupts the value in every reader downstream, which is why
// this collapses all whitespace rather than just \n. Rows are a list, not a
// template, so the next key someone adds cannot be the one that forgot.
const one = v => String(v === null || v === undefined ? '' : v).replace(/\s+/g, ' ').trim();
const classRows = [
	['quota', quota],
	['tools', tools.size],
	['status', status],
	['killed', killed ? 1 : 0],
	['idle', idleArg || 0],
	['capped', capped ? 1 : 0],
	['deferred', deferred ? 1 : 0],
	['wall', wall],
	['tokens_in', nz(uw.input_tokens)],
	['tokens_out', nz(uw.output_tokens)],
	['tokens_think', nz(uw.thinking_tokens)],
	['tokens_total', nz(uw.total_tokens)],
	['model', init.model],
	['raw', quotaRaw],
];
fs.writeFileSync(classPath, classRows.map(([k, v]) => `${k}=${one(v)}\n`).join(''));

const u = result.usage || {};
const pad = s => String(s).padEnd(13);
console.log(pad('status'), status || '(none)');
console.log(pad('model'), init.model || '(unknown)');
// Wall clock is measured by the caller. result.duration_seconds is NOT the run:
// on a --continue it reports time since the *thread* started, which read
// 21286s for a 246s run. Keep both, clearly labelled.
console.log(pad('duration'), `${wall}s wall / ${result.duration_seconds ?? '?'}s thread-elapsed`);
// num_turns is agy's own bookkeeping and is not a count of what the run did:
// runs reporting `1 turns` have carried two dozen recorded tool calls. Printed
// alone it reads as a one-shot answer, which is the opposite of what happened,
// so it never shares a line with a measurement again. The tool total beside it
// is ours, counted off the stream.
const toolCalls = [...tools.values()].reduce((a, b) => a + b, 0);
console.log(pad('turns'), `${result.num_turns ?? '?'} (agy's own count — not a measure of the work; the tool total is)`);
console.log(pad('tokens'), `in ${u.input_tokens ?? '?'}  out ${u.output_tokens ?? '?'}  think ${u.thinking_tokens ?? '?'}  total ${u.total_tokens ?? '?'}`);
console.log(pad('tools'), tools.size
	? `${toolCalls} call(s) — ` + [...tools].map(([n, c]) => `${n}x${c}`).join('  ')
	: deferred ? 'NONE recorded — but the stream was cut off; see the report and the diff'
	           : 'NONE — the run touched nothing');
// A stream that stops mid-flight is a floor, not a total. Presented as a run
// summary it reads as proof the implementer wrote nothing — next to a commit
// that is on disk. Say which of the two it is.
if (deferred) console.log(pad(''), 'floor, not a total — the stream ended before the run did');
if (quota !== 'none') {
	console.log(pad('quota'), quota === 'weekly'   ? 'WEEKLY bucket exhausted'
	                        : quota === 'fivehour' ? '5-hour window exhausted (refreshes on its own)'
	                        :                        'quota-shaped error, bucket UNCLEAR');
	if (quotaRaw) console.log(pad(''), quotaRaw);
}

let problems = 0;
const fail = (headline, lines) => {
	problems++;
	console.log('\nFAIL  ' + headline);
	(lines || []).slice(0, 15).forEach(l => console.log('      - ' + l));
};

if (bypasses.length) {
	fail(`${bypasses.length} denied command(s) then ran under another name — BYPASS.`, bypasses);
	console.log('      The boundary held and the implementer walked around it. The work');
	console.log('      happened somewhere you did not authorise, and the report will');
	console.log('      describe it as done — accurately. Treat the whole report as');
	console.log('      unverified, and fix the boundary before re-running.');
}
if (denials.length) {
	fail(`${denials.length} tool call(s) BLOCKED despite --dangerously-skip-permissions.`, denials);
	console.log('      The run still exited 0 with status SUCCESS. Report is unreliable.');
}
if (deferred) {
	console.log(capped
		? `\nNOTE  the wall cap killed this run after ${wall}s. The stream was still`
			+ '\n      moving, so the idle watchdog had nothing to see — a model that'
			+ '\n      finishes and then polls itself looks identical to one working.'
		: killed
		? `\nNOTE  watchdog killed this run after ${idleArg}s of stream silence.`
		: '\nNOTE  the session ended before its result event — agy stopped on its own.');
	console.log('      status, response and exit code are not judged; the evidence');
	console.log('      is now the fence, the gates and the report on disk.');
} else if (status !== 'SUCCESS') {
	fail('status is not SUCCESS', result.error ? [JSON.stringify(result.error)] : []);
}
if (errors.length) fail(`${errors.length} tool error(s)`, errors);
if (!tools.size) fail(deferred
	? 'no tool calls recorded before the stream ended — nothing evidences any work'
	: 'no tool calls recorded — the implementer answered without doing the work');
if (!deferred && !response.trim()) fail('empty response — the implementer produced no report');
if (!deferred && Number(agyCode) !== 0) fail(`agy exited ${agyCode}`);

process.exit(problems ? 1 : 0);
NODE
	return $?
}

# ------------------------------------------------------------------- attempt 1
printf -- '\n--- run report -----------------------------------------------------\n'
run_attempt "$FIRST_MODEL" "$BASE" "$CONTINUE"
stream_rc=$?

USED_MODEL="$FIRST_MODEL"
FELL_BACK=0
HANDOVER=""

read_class() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }

# The attempt that actually decided the outcome. A fallback overwrites nothing,
# it writes its own class file, so the watchdog state must be read from the
# last attempt rather than the first.
LAST_CLASS="$BASE.class"

quota_class="$(read_class "$BASE.class" quota)"
tools_used="$(read_class "$BASE.class" tools)"

# ------------------------------------------------------------------- attempt 2
# Only a clear weekly exhaustion opens the reserve. A spent 5-hour window waits
# it out; an unclear quota error stops and shows its raw text.
if [ "$stream_rc" -ne 0 ] && [ "$AGY_FALLBACK" = "auto" ]; then
	case "$quota_class" in
	weekly)
		printf -- '\n--- falling back to the reserve group -------------------------------\n'
		printf 'The Gemini WEEKLY bucket is spent. Switching to %s.\n' "$AGY_FALLBACK_MODEL"
		printf 'This group drains fast — the next dispatch starts on Gemini again.\n\n'

		# A run that already touched the tree must be handed over, not restarted:
		# a cold retry would redo half-finished work on top of itself.
		HANDOVER_FLAG="$CONTINUE"
		if [ "${tools_used:-0}" != "0" ]; then
			HANDOVER_FLAG="--continue"
			HANDOVER="mid-run: Gemini had already made ${tools_used} tool call(s) before the wall"
			printf 'NOTE  %s.\n' "$HANDOVER"
			printf '      Resuming the thread so the reserve continues rather than restarts.\n\n'
		fi

		run_attempt "$AGY_FALLBACK_MODEL" "$BASE.reserve" "$HANDOVER_FLAG"
		stream_rc=$?
		LAST_CLASS="$BASE.reserve.class"
		USED_MODEL="$AGY_FALLBACK_MODEL"
		FELL_BACK=1
		# The header's log line named the attempt that hit the wall. Everything
		# from here — the event stream and the implementer's own narrative —
		# lives under a different base, and the path already on screen now
		# points at a failed run.
		LOG_BASE="$BASE.reserve"
		;;
	fivehour)
		printf -- '\n--- holding --------------------------------------------------------\n'
		printf 'The Gemini 5-hour window is spent but the weekly bucket is not. Holding:\n'
		printf 'that window refreshes within hours, and the reserve group is scarcer\n'
		printf 'than the wait. Re-run this dispatch after the refresh, or override with\n'
		printf 'AGY_FALLBACK=force if you need it done now.\n'
		;;
	unknown)
		printf -- '\n--- holding --------------------------------------------------------\n'
		printf 'A quota-shaped error came back that does not say which bucket it is.\n'
		printf 'Not spending the reserve on a guess. The raw text is in the run report\n'
		printf 'above and in %s.\n' "$BASE.class"
		printf 'If the interactive panel shows the weekly bucket spent, re-run with\n'
		printf 'AGY_FALLBACK=force — and fix the matcher in .agy/dispatch.\n'
		;;
	esac
fi

# ------------------------------------------------- report freshness (deferred)
# On a deferred run the response never arrived, so the report on disk is the
# only account of what happened. It has to be THIS run's report: a stale one
# left by an earlier dispatch would otherwise sail through on a clean fence and
# a green gate, which is the exact shape of a run that did nothing at all.
WATCHDOG_KILLED="$(read_class "$LAST_CLASS" killed)"
DEFERRED="$(read_class "$LAST_CLASS" deferred)"
WATCHDOG_IDLE="$(read_class "$LAST_CLASS" idle)"
WALL_CAPPED="$(read_class "$LAST_CLASS" capped)"

# Freshness is computed on every run, not just a deferred one: a report is only
# evidence about THIS dispatch if this dispatch wrote it. Only the deferred path
# fails on it, because there the report is the sole account of the work.
REPORT_FRESH=0
if [ -n "$REPORT" ] && [ -f "$REPORT" ] \
	&& [ "$(stat -c %Y "$REPORT" 2>/dev/null || echo 0)" -ge "$RUN_START" ]; then
	REPORT_FRESH=1
fi

if [ "$DEFERRED" = "1" ] && [ -n "$REPORT" ]; then
	printf -- '\n--- report freshness -----------------------------------------------\n'
	if [ ! -f "$REPORT" ]; then
		printf 'FAIL  no report at %s.\n' "$REPORT"
		printf '      The run stopped and left no account of itself.\n'
		stream_rc=1
	elif [ "$REPORT_FRESH" != "1" ]; then
		printf 'FAIL  %s predates this run.\n' "$REPORT"
		printf '      It is a leftover from an earlier dispatch, not this one.\n'
		stream_rc=1
	else
		printf 'ok    %s was written during this run.\n' "$REPORT"
	fi
fi

# ------------------------------------------------------------ report contract
# The contract asks for sections the harness can check for, and nothing checked.
# An absent `## Observations` is ambiguous in the worst direction: it reads
# identically whether there was nothing to observe or the implementer never
# looked, and the second is the case you need to know about.
#
# Unlike the claims comparison below this is deterministic — a heading is there
# or it is not — so it fails the run rather than warning. Warnings are for
# checks that can be wrong. The fix is one `--continue` away.
if [ "$REPORT_FRESH" = "1" ]; then
	printf -- '\n--- report contract ------------------------------------------------\n'
	missing_section=0
	while IFS= read -r sec; do
		[ -n "$sec" ] || continue
		if grep -qF -- "$sec" "$REPORT"; then
			printf 'ok    %s\n' "$sec"
		else
			printf 'FAIL  the report has no `%s` section.\n' "$sec"
			missing_section=1
		fi
	done <<EOF
${AGY_REPORT_SECTIONS:-## Observations}
EOF
	if [ "$missing_section" = "1" ]; then
		printf '      "None." is a valid body. A section left out is not the same as\n'
		printf '      one saying there was nothing — only one of them tells you the\n'
		printf '      implementer looked.\n'
		stream_rc=1
	fi
fi

# ------------------------------------------------------------- check the fence
printf -- '\n--- fence ----------------------------------------------------------\n'
bash .agy/tripwire verify "$SNAP"
trip_rc=$?

# ------------------------------------------------------------- what landed
# `run clean` says the session behaved, not that it produced anything — and a
# run that wrote no code reads exactly like one that implemented the task:
# clean run, clean fence, green gates, a confident report. The tree is the only
# thing that tells them apart, and until now nothing measured it.
#
# The workspace is excluded for the same reason the fence prunes it: it holds
# the harness's own paper trail — the brief, the report, the logs — and a report
# saying the work happened is not the work.
#
# LANDED_MEASURED separates "nothing landed" from "we could not tell". Both end
# with LANDED_COMMITS at 0 — a missing snapshot, an unresolvable HEAD and a
# rewritten history all leave the count unknown — and on screen that reads the
# same as a run that landed nothing. It is not the same, and the sidecar below
# is where the difference has to survive.
LANDED_COMMITS=0
LANDED_MEASURED=0
LANDED_SUBJECT=""
WAS_HEAD="$(awk -F'\t' '$1=="head"{print $2}' "$SNAP/git.txt" 2>/dev/null)"
IS_HEAD="$(git rev-parse HEAD 2>/dev/null)"
if [ -n "$WAS_HEAD" ] && [ -n "$IS_HEAD" ]; then
	if [ "$WAS_HEAD" = "$IS_HEAD" ]; then
		# Both heads resolved and they match: a measured, genuine zero.
		LANDED_MEASURED=1
	elif git merge-base --is-ancestor "$WAS_HEAD" "$IS_HEAD" 2>/dev/null; then
		landed_n="$(git rev-list --count "$WAS_HEAD..$IS_HEAD" 2>/dev/null)"
		# A rev-list that failed or answered with something that is not a number
		# has not measured anything either; do not launder it into a 0.
		case "$landed_n" in
		''|*[!0-9]*) ;;
		*) LANDED_COMMITS="$landed_n"; LANDED_MEASURED=1 ;;
		esac
		LANDED_SUBJECT="$(git --no-pager log -1 --format=%s "$IS_HEAD" 2>/dev/null)"
	fi
fi
LANDED_DIRTY="$(git status --porcelain -- . ":(exclude)$AGY_WORKSPACE" 2>/dev/null | grep -c . || true)"
# Work on disk and nothing in history is not a judgement call: the brief's own
# definition of done requires the commit, so the run did not finish. Observed
# twice running with the harness reporting SUCCESS both times and the controller
# committing by hand — which also means the next run starts on a dirty tree and
# inherits work it never made. Whether a task *should* commit stays unknowable
# (an investigation legitimately produces none), but that case leaves nothing
# outside the workspace, so it never reaches here.
LANDED_RC=0
[ "${LANDED_COMMITS:-0}" -eq 0 ] && [ "${LANDED_DIRTY:-0}" -gt 0 ] && LANDED_RC=1

# ------------------------------------------------------------- attribution
# dispatch-context.md is full of behavioural rules, and until now every one of
# them was enforced by the model choosing to comply. The fence checks file
# scope and the gates check correctness; nothing checked conduct. The trailer
# is the case where that gap had a victim: the context asked for a
# `Co-Authored-By:` line without saying what to put in it, so implementers
# supplied antigravity@google.com, and GitHub — which resolves co-author
# trailers to accounts by email — put a real stranger on the contributor graph
# of every repository this harness has ever run in.
#
# Telling the model harder is the wrong lever; that instruction was already
# there and was already being ignored. This is deterministic — an address
# either is the configured one or it is not — so it fails the run rather than
# warning, per the same rule as the report contract. The remedy is an amend,
# not a re-dispatch, and it is printed.
COAUTHOR_RC=0
BAD_TRAILERS=0
if [ -n "${AGY_COAUTHOR:-}" ] && [ "${LANDED_COMMITS:-0}" -gt 0 ]; then
	# Compare on the address alone. The display name is cosmetic and GitHub
	# ignores it; two trailers differing only in the name are the same claim.
	want_addr="$(printf '%s' "$AGY_COAUTHOR" |
		sed -n 's/.*<\([^>]*\)>.*/\1/p' | tr 'A-Z' 'a-z')"
	[ -n "$want_addr" ] || want_addr="$(printf '%s' "$AGY_COAUTHOR" | tr 'A-Z' 'a-z')"
	bad_lines=""
	while IFS= read -r sha; do
		[ -n "$sha" ] || continue
		# Real trailers only. A `Co-Authored-By:` quoted in the body of a
		# commit message is prose about a trailer, not a claim of authorship,
		# and git's own parser is the only thing that reliably tells them
		# apart. Reading them with grep would fail commits that discuss this
		# very check.
		while IFS= read -r addr; do
			[ -n "$addr" ] || continue
			[ "$addr" = "$want_addr" ] && continue
			bad_lines="$bad_lines  $(printf '%.8s' "$sha")  $addr
"
			BAD_TRAILERS=$(( BAD_TRAILERS + 1 ))
		done <<-ADDRS
		$(git --no-pager log -1 --format='%(trailers:key=Co-authored-by,valueonly)' \
			"$sha" 2>/dev/null | sed -n 's/.*<\([^>]*\)>.*/\1/p' | tr 'A-Z' 'a-z')
		ADDRS
	done <<-SHAS
	$(git rev-list "$WAS_HEAD..$IS_HEAD" 2>/dev/null)
	SHAS
	if [ "$BAD_TRAILERS" -gt 0 ]; then
		printf -- '\n--- attribution ----------------------------------------------------\n'
		printf 'WRONG CO-AUTHOR on %s commit(s):\n\n' "$BAD_TRAILERS"
		printf '%s' "$bad_lines"
		printf '\nExpected: %s\n\n' "$AGY_COAUTHOR"
		printf 'A co-author trailer is resolved to an account BY EMAIL and counted on\n'
		printf "the repository's contributor graph, so a wrong address publishes a\n"
		printf 'false claim about who wrote this code — against a real person who has\n'
		printf 'never had access to it. Amend before pushing:\n\n'
		printf '  git commit --amend --trailer "Co-Authored-By: %s"\n\n' "$AGY_COAUTHOR"
		printf 'or `git rebase` for more than one. If this project does not want the\n'
		printf 'check, set AGY_COAUTHOR empty in .agy/config — do not widen it.\n'
		COAUTHOR_RC=1
	fi
fi

# The commit range is known only here — the node parser runs before the fence
# is verified, so it cannot see what landed. Appended rather than rewritten so
# the parser stays the sole owner of everything above it.
#
# Empty is not zero. `commits=0` is a claim that the run landed nothing, and it
# is only made when both heads resolved and matched. Every other way of ending
# up without a count — no snapshot to compare against, no HEAD to compare with,
# a history rewritten under us — is written as `commits=`, because a reader that
# cannot tell those apart will score an unreadable run as a run that did nothing.
#
# The measurement belongs to the RUN, not to an attempt: it is taken once, after
# the fence, over the whole tree. So both sidecars a fallback leaves behind carry
# the same answer. Keying this off LOG_BASE gave the first attempt's .class
# neither key on the quota-fallback path, which is a third state — key absent —
# that nothing downstream is written to expect.
if [ "${LANDED_MEASURED:-0}" = "1" ]; then
	CLASS_COMMITS="$LANDED_COMMITS"
	if [ "$LANDED_COMMITS" -gt 0 ]; then
		CLASS_RANGE="$WAS_HEAD..$IS_HEAD"
	else
		CLASS_RANGE=""
	fi
else
	CLASS_COMMITS=""
	CLASS_RANGE=""
fi
for class_file in "$BASE.class" "$BASE.reserve.class"; do
	[ -f "$class_file" ] || continue
	printf 'commits=%s\nrange=%s\n' "$CLASS_COMMITS" "$CLASS_RANGE" >> "$class_file"
done

# ------------------------------------------------------------------- run gates
printf -- '\n--- gates ----------------------------------------------------------\n'
if [ "${AGY_SKIP_GATES:-0}" = "1" ]; then
	printf 'skipped (AGY_SKIP_GATES=1). Run the gates before believing anything.\n'
	gates_rc=-1
elif [ -z "$AGY_GATES" ]; then
	printf 'AGY_GATES is empty in .agy/config. A dispatch with no gate is a dispatch\n'
	printf 'you cannot check. Configure it before trusting any of this.\n'
	gates_rc=99
else
	# Output is teed, not swallowed: the gates stay visible in real time, and
	# the copy is what the report's own numbers get measured against below.
	# shellcheck disable=SC2086
	bash $AGY_GATES 2>&1 | tee "$BASE.gates.log"
	gates_rc=${PIPESTATUS[0]}
fi

# ------------------------------------------------------- report vs gate output
# The report is the implementer's account of its work. The gates are a
# measurement of it. Where both name the same quantity, the measurement wins.
#
# This is a warning, not a gate, and it is deliberately narrow: only a unit that
# appears on BOTH sides is ever compared, because the gates cannot contradict a
# number they never measured. A checker that invents disagreements teaches the
# controller to ignore it, which is worse than not having one.
CLAIMS_RC=0
if [ "$REPORT_FRESH" = "1" ] && [ "$gates_rc" -ge 0 ] && [ -s "$BASE.gates.log" ]; then
	printf -- '\n--- report vs gates ------------------------------------------------\n'
	node - "$REPORT" "$BASE.gates.log" <<'NODE'
const fs = require('fs');
const [, , reportPath, gatesPath] = process.argv;
const read = p => { try { return fs.readFileSync(p, 'utf8'); } catch (e) { return ''; } };

// Quantities a gate suite actually measures and a report actually claims.
// Anything outside this list (minutes, commits, line numbers) is not compared.
const UNITS = ['assertion', 'test', 'check', 'gate', 'spec', 'example', 'case', 'suite', 'failure', 'error', 'warning'];

// Strip at most a trailing "s", and only when doing so lands on a real unit.
// The previous form stripped /e?s$/, which turned `failures` into `failur`,
// `gates` into `gat`, and `cases`, `suites`, `examples` likewise — none of them
// in UNITS, so they were dropped from BOTH sides and silently never compared.
// Five of the eleven units were unreachable in the plural, `failure` among
// them: the one number this check exists to catch a lie about. `76 tests, 0
// failures` against `Tests: 76, Failures: 2` compared only the tests, matched,
// and reported that nothing contradicted. The tests missed it because they
// were written with `assertions`, which is the plural the old regex happened
// to handle.
const singular = w => {
	const lw = w.toLowerCase();
	if (UNITS.includes(lw)) return lw;
	const s = lw.replace(/s$/, '');
	return UNITS.includes(s) ? s : lw;
};

const grab = text => {
	const found = new Map();
	const add = (n, w) => {
		const unit = singular(w);
		if (!UNITS.includes(unit)) return;
		if (!found.has(unit)) found.set(unit, new Set());
		found.get(unit).add(n.replace(/,/g, ''));
	};
	let m;
	const forward = /(\d[\d,]*)\s+([A-Za-z]+)/g;          // "719 assertions"
	while ((m = forward.exec(text))) add(m[1], m[2]);
	const reverse = /([A-Za-z]+)\s*[:=]\s*(\d[\d,]*)/g;    // "assertions: 64"
	while ((m = reverse.exec(text))) add(m[2], m[1]);
	return found;
};

const claimed = grab(read(reportPath));
const measured = grab(read(gatesPath));

const conflicts = [];
for (const [unit, nums] of claimed) {
	const got = measured.get(unit);
	if (!got) continue;
	// A report naming several numbers for one unit is naming several scopes —
	// "19 tests (--filter Gateway). Full unit suite: 76 tests" — and nothing in
	// the gate log says which of them the gates measured. Comparing each number
	// against the whole set flagged the scoped one every time, so a correctly
	// labelled partial run could never pass. That is a checker that fires on
	// accurate reports, which is the failure this section's own comment warns
	// about. Only a single, unambiguous claim is comparable.
	if (nums.size !== 1) continue;
	const n = [...nums][0];
	if (!got.has(n)) conflicts.push({ unit, n, got: [...got] });
}

if (!conflicts.length) {
	console.log('ok    no number in the report contradicts the gate output.');
	process.exit(0);
}
for (const c of conflicts) {
	console.log(`CLAIM the report says ${c.n} ${c.unit}(s); the gates reported ${c.got.join(', ')}.`);
}
console.log('      The gates measured it; the report only asserts it. Resolve this');
console.log('      before accepting the task. A number that drifts is usually work');
console.log('      that was described rather than done.');
process.exit(1);
NODE
	CLAIMS_RC=$?
fi

# --------------------------------------------------------------------- verdict
# Set before the block prints, not after: an interrupt landing midway through
# these lines must not append a second, contradictory verdict to a partial one.
VERDICT_PRINTED=1
printf -- '\n--- verdict --------------------------------------------------------\n'
v() { printf '  %-7s %s\n' "$1" "$2"; }
if [ "$FELL_BACK" -eq 1 ]; then
	v model "$USED_MODEL  <- RESERVE GROUP BURNED (Gemini weekly exhausted)"
	[ -n "$HANDOVER" ] && v '' "$HANDOVER"
elif [ "$AGY_FALLBACK" = "force" ]; then
	v model "$USED_MODEL  <- reserve group, forced"
else
	v model "$USED_MODEL"
fi
if [ "$stream_rc" -ne 0 ]; then
	v run 'PROBLEMS — see run report above'
elif [ "$WALL_CAPPED" = "1" ]; then
	# Distinct from the idle kill on purpose. WATCHDOG-KILLED says the run went
	# quiet; WALL-CAPPED says it would not stop, which is where a model that has
	# already committed its work parks itself in a poll loop. The two send the
	# reader to different places, so they must not share a line.
	v run "clean, but WALL-CAPPED at ${AGY_MAX_WALL}s — the run would not end"
	v '' 'the work stands on the report, the fence and the gates below'
elif [ "$WATCHDOG_KILLED" = "1" ]; then
	v run "clean, but WATCHDOG-KILLED after ${WATCHDOG_IDLE}s idle (agy failure 4)"
	v '' 'the work stands on the report, the fence and the gates below'
elif [ "$DEFERRED" = "1" ]; then
	# The other way to lose the result event: agy stopped on its own while the
	# stream was still moving, so the watchdog never fired. Same verdict, and it
	# has to be sayable — otherwise the only vocabulary for "the work landed,
	# the session died" is PROBLEMS.
	v run 'clean, but the SESSION DIED before its result event (agy failure 4)'
	v '' 'the work stands on the report, the fence and the gates below'
else
	v run 'clean'
fi
# Three outcomes, not two. `VIOLATED` sends the reader to the implementer's
# diff; a baseline that does not pair with this config sends them to the
# config instead. Collapsing the two means a run that nothing touched can
# read as a compromised one — the same confident wrongness in the opposite
# direction from the fence that guards nothing and reports clean.
if   [ "$trip_rc" -eq 0 ]; then v fence 'clean — no guarded surface moved'
elif [ "$trip_rc" -eq 2 ]; then v fence 'COULD NOT JUDGE — the baseline does not match this config'
                                v '' 'not drift: re-arm the fence and re-run before reading the tree'
else v fence 'VIOLATED — see fence section above'
fi
if [ "${LANDED_COMMITS:-0}" -gt 0 ]; then
	v landed "$LANDED_COMMITS commit(s) — $LANDED_SUBJECT"
	[ "${LANDED_DIRTY:-0}" -gt 0 ] && v '' "$LANDED_DIRTY uncommitted change(s) also in the tree"
elif [ "${LANDED_DIRTY:-0}" -gt 0 ]; then
	v landed "NOT COMMITTED — $LANDED_DIRTY change(s) outside the workspace, 0 commits"
	v '' 'the definition of done was not met; the next run inherits a dirty tree'
else
	v landed 'NOTHING — no commit, and nothing changed outside the workspace'
	v '' 'a report is not the work. Read the diff before accepting the task.'
fi
if [ "$COAUTHOR_RC" -ne 0 ]; then
	v trailer "WRONG CO-AUTHOR on $BAD_TRAILERS commit(s) — see attribution above"
	v '' 'amend before pushing: the trailer names a real account, by email'
fi
# Printed here as well as in the header because the header's copy was written
# before any attempt ran. On a fallback the two differ, and this is the one a
# reader acts on: it names the attempt that produced the work rather than the
# attempt that hit the wall.
v log "$LOG_BASE.ndjson"
if   [ "$gates_rc" -eq 0 ]; then v gates 'green'
elif [ "$gates_rc" -lt 0 ]; then v gates 'not run'
else v gates "$gates_rc FAILING"
fi
if [ "$CLAIMS_RC" -ne 0 ]; then
	v claims 'CONTRADICTED by the gates — see the section above'
	v '' 'not a gate failure on its own; do not accept the task on it'
fi
printf '\n  fence snapshot kept at %s\n' "$SNAP"

if [ "$trip_rc" -eq 2 ]; then
	printf '\nThe fence could not judge this run: its baseline was armed for a different\n'
	printf 'set of surfaces than .agy/config now asks for. That is a configuration\n'
	printf 'fault, not evidence about the implementer — read the fence section above,\n'
	printf 'fix the pairing, and re-run. Nothing here says the tree is clean.\n'
	exit 4
elif [ "$trip_rc" -ne 0 ]; then
	printf '\nA guarded surface moved. Investigate that before reading anything else.\n'
	exit 4
fi
if [ "$LANDED_RC" -ne 0 ]; then
	printf '\nThe implementer changed the tree and committed nothing. Read the diff\n'
	printf 'before anything else: the report describes work that is not in history,\n'
	printf 'and committing it yourself makes the next run start on your commit.\n'
fi
if [ "$stream_rc" -ne 0 ] || [ "$gates_rc" -gt 0 ] || [ "$LANDED_RC" -ne 0 ] \
	|| [ "$COAUTHOR_RC" -ne 0 ]; then
	exit 1
fi
exit 0
