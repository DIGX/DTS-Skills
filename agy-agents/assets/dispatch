#!/usr/bin/env bash
#
# Dispatch one task to the implementer model through the Antigravity CLI,
# headlessly. This is the only sanctioned way to call `agy` in this project.
#
# Four things about agy shape this whole script.
#
# First, `--add-dir` is not optional. agy's default CLI project has no
# resources attached (projectResources is {}), so a headless run gets a scratch
# workspace under ~/.gemini/antigravity-cli/scratch and every path in the
# prompt resolves to nothing. The init event still reports the real cwd, which
# makes this look like it worked: an early probe reported "not a git
# repository", "php is not recognized" and "scripts/gates: No such file", while
# status read SUCCESS.
#
# Second, it cannot be trusted by exit code. A tool call it is not permitted to
# make is *soft-denied*: the run continues, the process exits 0, `status` still
# reads SUCCESS, and the only trace is a notice on stderr. Verified with a
# probe whose every command was blocked; it exited 0, status SUCCESS, empty
# response. So this script parses the event stream and judges the run itself.
#
# Third, its permission system is inverted in headless mode.
# `permissions.allow` is honoured interactively but ignored under --print, so
# every allowed command is denied and the run lies about it. A fence that
# blocks the work and permits the lie is worse than none, so we run with
# --dangerously-skip-permissions and put a fence we control around it instead:
# .agy/tripwire, which records the surfaces the implementer must never touch,
# before and after the run.
#
# The flag lives in here, never in a bare command, so it cannot be used without
# the fence attached to it. If the fence will not arm, the dispatch does not
# happen.
#
# Fourth, it can do the work, write the report, make the commit, and then never
# emit its result event — trapped in an internal manage_task/schedule loop. No
# error, no stderr, process alive, and it will sit there until --print-timeout
# expires 45 minutes later. Observed on a run whose work was complete and
# committed two minutes in; the last event was a schedule call asking to be
# woken in 20 seconds, and the stream was still silent 16 minutes later.
# Nothing about the process distinguishes this from slow work — the tell is
# that the event stream stopped growing. Hence the watchdog: when the stream
# goes quiet for AGY_IDLE_TIMEOUT, kill agy and fall through to the report
# freshness check, the fence and the gates. A report written by this run, plus
# a clean fence, plus a green gate, is a pass regardless of how the process
# died.
#
# The watchdog catches the silent form of that. The chatty form keeps emitting
# events while it is stuck, so the stream never goes quiet and agy's own
# --print-timeout ends it instead: `timeout waiting for response` at 2711s wall
# against 364s of thread time, on a run that had already committed the work.
# Both forms end with no result event, and THAT is what the deferral keys on —
# not on whether we did the killing. Status, an empty response and an exit code
# from a session that died describe the death, not the work.
#
# ---------------------------------------------------------------------------
# MODEL GROUPS AND FALLBACK
#
# Antigravity meters two independent buckets, each with its own weekly and
# 5-hour limit:
#
#   GEMINI MODELS          Gemini Flash, Gemini Pro          <- primary
#   CLAUDE AND GPT MODELS  Claude Opus, Claude Sonnet, GPT   <- reserve
#
# Gemini is always tried first. The Claude group drains much faster for the
# same work, so it is a reserve and never a co-equal: we fall back only when
# Gemini's *weekly* limit is gone. A spent 5-hour window is not a reason to
# burn the reserve — it refreshes on its own within hours, so we report and
# hold instead.
#
# `agy` exposes quota only in its interactive panel; there is no subcommand to
# query it (`agy quota` produces nothing, and no quota verb appears in
# `agy --help`). So exhaustion is detected from the failure itself rather than
# polled in advance.
#
# Nothing about being in fallback is ever persisted. Every dispatch starts on
# Gemini again, which is what makes "switch back the moment it is available"
# automatic — there is no sticky flag that could strand you on the reserve.
#
# CAVEAT, and it is load-bearing: the classifier below is written against the
# vocabulary these errors normally use, not against a captured Antigravity
# exhaustion event. It is therefore deliberately conservative. A quota-shaped
# error that does not clearly say *weekly* does NOT trigger fallback; it stops
# and prints the raw text, so the first genuine occurrence tells you the exact
# string and this matcher gets corrected once. Use AGY_FALLBACK=force in the
# meantime — the interactive panel shows the real number.
# ---------------------------------------------------------------------------
#
# Usage:
#   .agy/dispatch 4                # runs <workspace>/task-4-dispatch.md
#   .agy/dispatch --file <path>    # runs an arbitrary prompt file
#   .agy/dispatch --continue 4     # resumes the last conversation
#
# Overrides (environment beats .agy/config):
#   AGY_MODEL, AGY_FALLBACK_MODEL, AGY_EFFORT, AGY_TIMEOUT, AGY_ARGS
#   AGY_SKIP_GATES=1               report only; do not run the gates
#   AGY_FALLBACK=auto|force|off    default auto
#     auto  - Gemini first; reserve only on a clear weekly exhaustion
#     force - go straight to the reserve (use when the panel already shows the
#             Gemini weekly bucket spent)
#     off   - never use the reserve; fail instead

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
	printf 'dispatch: not a git repository.\n' >&2
	exit 2
}
cd "$ROOT" || exit 1

[ -f .agy/config ] || { printf 'dispatch: no .agy/config — run the agy-agents installer\n' >&2; exit 2; }
# shellcheck disable=SC1091
. .agy/config

: "${AGY_WORKSPACE:=.agy/work}"
: "${AGY_GATES:=}"
: "${AGY_MODEL:=gemini-3.6-flash-high}"
: "${AGY_FALLBACK_MODEL:=claude-opus-4-6-thinking}"
: "${AGY_FALLBACK:=auto}"
: "${AGY_EFFORT:=high}"
: "${AGY_TIMEOUT:=45m}"

# The file every implementer and reviewer reads before anything else. Defaulted
# rather than required in .agy/config, so a config written by an older installer
# still finds it.
: "${AGY_CONTEXT:=$AGY_WORKSPACE/dispatch-context.md}"

# Seconds of event-stream silence before a run is presumed hung (failure 4).
# 300 is roughly six times the longest gap seen between events on a healthy
# run, where the gate — the slowest single tool call — takes about 50 seconds.
# 0 disables the watchdog.
: "${AGY_IDLE_TIMEOUT:=300}"
: "${AGY_IDLE_POLL:=15}"

LOGDIR="$AGY_WORKSPACE/logs"

case "$AGY_FALLBACK" in
	auto|force|off) ;;
	*) printf 'dispatch: AGY_FALLBACK must be auto, force or off (got %s)\n' "$AGY_FALLBACK" >&2; exit 2 ;;
esac

AGY="$(command -v agy 2>/dev/null)"
[ -n "$AGY" ] || AGY="$HOME/AppData/Local/agy/bin/agy.exe"
if [ ! -x "$AGY" ]; then
	printf 'dispatch: agy not found (looked for %s)\n' "$AGY" >&2
	exit 127
fi

CONTINUE=""
if [ "${1:-}" = "--continue" ]; then
	CONTINUE="--continue"
	shift
fi

# The prompt stays one line on purpose: the implementer reads the same disk you
# do, so a dispatch points at a file rather than quoting it.
if [ "${1:-}" = "--file" ]; then
	[ -f "${2:-}" ] || { printf 'dispatch: no such prompt file: %s\n' "${2:-}" >&2; exit 2; }
	PROMPT="Read ${2} and execute it in full."
	PROMPT_FILE="$2"
	LABEL="$(basename "$2" | sed 's/\.[^.]*$//')"
	REPORT=""
elif [ -n "${1:-}" ]; then
	N="$1"
	DISPATCH="$AGY_WORKSPACE/task-$N-dispatch.md"
	[ -f "$DISPATCH" ] || { printf 'dispatch: no dispatch file at %s\n' "$DISPATCH" >&2; exit 2; }
	PROMPT="Read $DISPATCH and execute it in full."
	PROMPT_FILE="$DISPATCH"
	LABEL="task-$N"
	REPORT="$AGY_WORKSPACE/task-$N-report.md"
else
	printf 'usage: .agy/dispatch [--continue] <task-number> | --file <path>\n' >&2
	exit 2
fi

# ------------------------------------------------------- the brief must be real
# The installer writes dispatch-context.md and the task template from stubs full
# of {{PLACEHOLDER}} markers, and it cannot fill them — only the controller knows
# what goes in. Nothing used to check that it had. dispatch-context.md is the one
# file EVERY implementer and reviewer reads, so an unfilled one is inherited by
# every agent in the plan: they are told the language floor is
# "{{Language/runtime floor}}", read that as no constraint, and the gates cannot
# catch what was never specified.
#
# This refuses rather than warns. A warning on the noisiest line of a dispatch is
# a warning nobody reads, and the failure it guards against is silent by
# construction — the run will look perfect. Cost of the refusal is a minute of
# typing; cost of missing it is a milestone built against a brief that said
# PLACEHOLDER.
check_unfilled() { # <path> <what-it-is>
	local f="$1" what="$2" hits n
	if [ ! -f "$f" ]; then
		printf 'dispatch: no %s at %s\n' "$what" "$f" >&2
		printf '          Every agent on this plan reads it. Run the installer, or\n' >&2
		printf '          point AGY_CONTEXT at the file you use instead.\n' >&2
		return 1
	fi
	# Both shapes the templates leave behind: {{...}} markers, and the quoted
	# "fill this in" note the controller is told to delete once it is real.
	hits="$(grep -n -e '{{[^}]*}}' -e 'Delete this quote block' "$f" 2>/dev/null)"
	[ -n "$hits" ] || return 0
	n="$(printf '%s\n' "$hits" | wc -l | tr -d ' ')"
	printf 'dispatch: %s is still a template — %s unfilled line(s) in %s\n' "$what" "$n" "$f" >&2
	printf '%s\n' "$hits" | head -8 | sed 's/^/          /' >&2
	[ "$n" -gt 8 ] && printf '          … and %s more\n' "$((n - 8))" >&2
	return 1
}

unfilled=0
check_unfilled "$AGY_CONTEXT" 'the shared dispatch context' || unfilled=1
check_unfilled "$PROMPT_FILE" "this task's brief" || unfilled=1
if [ "$unfilled" -ne 0 ] && [ "${AGY_ALLOW_UNFILLED:-0}" != "1" ]; then
	printf '\ndispatch: REFUSING TO DISPATCH against an unfilled brief. The run would\n' >&2
	printf 'succeed, the gates would pass, and the constraint you meant to impose\n' >&2
	printf 'would simply not exist. Fill the lines above first.\n' >&2
	printf 'Deliberate — a real {{...}} in the text? AGY_ALLOW_UNFILLED=1.\n' >&2
	exit 2
fi

mkdir -p "$LOGDIR"
STAMP="$(date +%Y%m%d-%H%M%S)"
BASE="$LOGDIR/$LABEL-$STAMP"
SNAP="$BASE.fence"

REPO_WIN="$(cygpath -w "$PWD" 2>/dev/null)" || REPO_WIN="$PWD"

printf 'dispatching  %s\n' "$LABEL"
# Which binary this resolved to, always, because on MSYS it is not always the
# one you think: a Windows-form PATH entry (C:\...) is accepted by `export` and
# then never searched, so the entry you added is skipped in silence and the next
# `agy` on PATH — the real, quota-spending one — answers instead. Printing the
# resolved path is the whole fix; you cannot misread an absolute path.
printf 'binary       %s\n' "$AGY"
if [ "$AGY_FALLBACK" = "force" ]; then
	FIRST_MODEL="$AGY_FALLBACK_MODEL"
	printf 'model        %s (RESERVE, forced) effort %s, timeout %s\n' "$FIRST_MODEL" "$AGY_EFFORT" "$AGY_TIMEOUT"
else
	FIRST_MODEL="$AGY_MODEL"
	printf 'model        %s (effort %s, timeout %s)\n' "$FIRST_MODEL" "$AGY_EFFORT" "$AGY_TIMEOUT"
fi
if [ "$AGY_IDLE_TIMEOUT" -gt 0 ]; then
	printf 'watchdog     kill after %ss of stream silence\n' "$AGY_IDLE_TIMEOUT"
fi
printf 'log          %s.ndjson\n\n' "$BASE"
# Provisional. A fallback attempt writes to its own base, so the authoritative
# path is printed again in the verdict block once the run is over; $LOG_BASE is
# what tracks which one that turned out to be.
LOG_BASE="$BASE"

# For the report-freshness check on a watchdog-killed run: a report left over
# from an earlier dispatch must not be read as this run's output.
RUN_START="$(date +%s)"

# --------------------------------------------------------------- arm the fence
# Armed once, verified once at the end. When a fallback attempt runs, the same
# snapshot spans both attempts, so the fence covers everything either model did
# rather than only the last one.
printf -- '--- arming fence ---------------------------------------------------\n'
if ! bash .agy/tripwire snapshot "$SNAP"; then
	printf '\ndispatch: REFUSING TO DISPATCH. The fence would not arm, and this run\n' >&2
	printf 'auto-approves every tool call. Fix .agy/tripwire first.\n' >&2
	exit 3
fi

# ------------------------------------------------------------------ one attempt
# $1 model, $2 output base, $3 extra continue flag ("" or "--continue")
run_attempt() {
	local model="$1" out="$2" cont="$3" started elapsed

	started=$SECONDS

	# --mode accept-edits because the default mode pauses for an interactive
	# diff review that a headless run has no way to answer.
	# shellcheck disable=SC2086
	"$AGY" --print "$PROMPT" \
		$cont \
		--add-dir "$REPO_WIN" \
		--output-format stream-json \
		--model "$model" \
		--effort "$AGY_EFFORT" \
		--mode accept-edits \
		--dangerously-skip-permissions \
		--print-timeout "$AGY_TIMEOUT" \
		${AGY_ARGS:-} \
		> "$out.ndjson" 2> "$out.stderr" &
	local agy_pid=$!

	# Watchdog for failure 4. Size, not mtime: the stream is append-only so size
	# is monotone, and a one-second mtime granularity makes short gaps
	# unreadable. Both files count, so a run writing only to stderr still reads
	# as alive.
	local killed=0 idle=0
	if [ "$AGY_IDLE_TIMEOUT" -gt 0 ]; then
		local last_seen=-1 last_change now size n f
		last_change="$(date +%s)"
		while kill -0 "$agy_pid" 2>/dev/null; do
			sleep "$AGY_IDLE_POLL"
			now="$(date +%s)"
			n=0
			for f in "$out.ndjson" "$out.stderr"; do
				[ -f "$f" ] && n=$(( n + $(wc -c < "$f" 2>/dev/null || echo 0) ))
			done
			size="$n"
			if [ "$size" != "$last_seen" ]; then
				last_seen="$size"; last_change="$now"; continue
			fi
			idle=$(( now - last_change ))
			[ "$idle" -lt "$AGY_IDLE_TIMEOUT" ] && continue
			killed=1
			printf '\nWATCHDOG  event stream silent for %ss - killing agy (pid %s).\n' "$idle" "$agy_pid"
			printf 'WATCHDOG  the verdict now rests on the fence, the gates and the report.\n'
			kill -TERM "$agy_pid" 2>/dev/null
			for _ in 1 2 3 4 5; do
				kill -0 "$agy_pid" 2>/dev/null || break
				sleep 2
			done
			kill -KILL "$agy_pid" 2>/dev/null
			break
		done
	fi

	wait "$agy_pid"
	local rc=$?

	elapsed=$(( SECONDS - started ))

	node - "$out.ndjson" "$out.stderr" "$out.response.md" "$rc" "$out.class" "$elapsed" "$killed" "$idle" <<'NODE'
const fs = require('fs');
const [ndjson, stderrPath, responsePath, agyCode, classPath, wall, killedArg, idleArg] =
	process.argv.slice(2);
const killed = killedArg === '1';

// Real event shape (verified against agy 1.1.12 — the published docs describe
// a flattened form that does not match the wire):
//   {"event":"init",        "init":        {model, cwd, tools:[...]}}
//   {"event":"step_update", "step_update": {step_index, state, step_type,
//                                           tool_name, tool_info:{name,
//                                           parameters, output, error}, usage}}
//   {"event":"result",      "result":      {status, response, num_turns, usage}}
const events = fs.readFileSync(ndjson, 'utf8')
	.split('\n').filter(Boolean)
	.map(l => { try { return JSON.parse(l); } catch { return null; } })
	.filter(Boolean);

const init = (events.find(e => e.event === 'init') || {}).init || {};
const resultEvent = events.find(e => e.event === 'result');
const result = (resultEvent || {}).result || {};

// No result event means the run was stopped, not that the work failed. Status,
// response and exit code are then artefacts of HOW it ended and are skipped.
//
// The trigger is the missing result event, NOT who did the stopping. The
// watchdog is only one way to arrive here: agy also dies on its own — its
// --print-timeout expiring, an internal error, a dropped connection — and when
// it does the stream was still moving, so the watchdog never fired. Keying the
// deferral on our own kill made that second case report PROBLEMS over a landed
// commit, a clean fence and green gates, on the strength of an exit code that
// only describes the death.
//
// Nothing else is relaxed: a denial, a tool error or zero tool calls still
// fails a stopped run, because each of those is recorded in the stream and is
// evidence of what actually happened.
const deferred = !resultEvent;

const tools = new Map();
const errors = [];
const denials = [];
const deniedCmds = [];
const ranCmds = [];

// A denial and the call that got through are two separate lines in the stream,
// and only their pairing carries the meaning. `cmd /c npm install` is not a
// different command from `npm install` — it is the same command wearing a
// wrapper that a literal-string deny rule cannot see (agy failure 5). Reduce
// both sides to the same shape so the pair becomes visible.
const norm = cmd => {
	let s = String(cmd).trim().replace(/^["']|["']$/g, '');
	// Wrappers nest: `cmd /c "bash -c 'npm install'"` is three deep.
	for (let i = 0; i < 4; i++) {
		const before = s;
		s = s
			.replace(/^(?:cmd(?:\.exe)?\s+\/[a-z]\s+|(?:ba|z|)sh\s+-c\s+|powershell(?:\.exe)?\s+(?:-\w+\s+)*-c(?:ommand)?\s+|npx\s+(?:--yes\s+|-y\s+)?|env\s+|sudo\s+)/i, '')
			.replace(/^["']|["']$/g, '')
			.trim();
		if (s === before) break;
	}
	const t = s.replace(/\s+/g, ' ').trim().split(' ').filter(Boolean);
	// Strip the path and extension off the executable: an absolute path is
	// another way to wear a different name for the same binary.
	if (t.length) t[0] = t[0].replace(/\\/g, '/').replace(/^.*\//, '').replace(/\.(exe|cmd|bat|ps1)$/i, '');
	return t.map(x => x.toLowerCase());
};
// Two tokens is the unit of intent: `npm install`, `git push`, `rm -rf`.
const head = cmd => norm(cmd).slice(0, 2).join(' ');

for (const e of events) {
	const s = e.step_update;
	if (!s || s.step_type !== 'tool' || s.state === 'ACTIVE') continue;
	const info = s.tool_info || {};
	const name = info.name || s.tool_name || 'unknown';
	const cmd = (info.parameters && (info.parameters.CommandLine || info.parameters.command)) || '';

	if (s.state === 'DONE') {
		tools.set(name, (tools.get(name) || 0) + 1);
		if (cmd) ranCmds.push(cmd);
	}

	if (info.error) {
		const msg = (info.error.message || info.error.type || 'error').replace(/\s+/g, ' ');
		// A denial should be impossible, since permissions are skipped. If one
		// appears anyway, the run is not what we think it is — so it stays a
		// hard failure rather than a warning.
		if (/denied permission|permission denied|not allowed|auto-denied/i.test(msg)) {
			denials.push(`${cmd || name}: ${msg}`.slice(0, 200));
			if (cmd) deniedCmds.push(cmd);
		} else {
			errors.push(`${name}${cmd ? ' [' + cmd + ']' : ''}: ${msg}`.slice(0, 200));
		}
	}
}

// Pair each denial with any call that completed under the same intent. This is
// the fact that distinguishes an incomplete run from a compromised one: the
// work described in the report happened, but outside the boundary you set.
const bypasses = [];
for (const d of deniedCmds) {
	const h = head(d);
	if (!h) continue;
	for (const r of ranCmds) {
		if (head(r) !== h) continue;
		bypasses.push(`denied: ${d}   ->   ran: ${r}`.slice(0, 200));
		break;
	}
}

const stderr = fs.existsSync(stderrPath) ? fs.readFileSync(stderrPath, 'utf8').trim() : '';
if (/auto-denied|permission/i.test(stderr) && !denials.length) denials.push(stderr.slice(0, 300));

const response = result.response || '';
if (response) fs.writeFileSync(responsePath, response);

const status = result.status || '';
// Quota is a separate question from deferral, and keys on a different fact. A
// run the WATCHDOG killed is never classified — that guarantee is what stops a
// hang from spending the scarce reserve group. But a run that died on its own
// still gets classified, because a genuine weekly exhaustion is one of the ways
// a session dies without a result event, and the evidence for it is on stderr.
const failed = !killed && (status !== 'SUCCESS' || Number(agyCode) !== 0);

// Quota classification. Only ever consulted on a FAILED run: a successful run
// whose report happens to discuss rate limiting must not be mistaken for an
// exhausted bucket. Conservative by design — see the header. `unknown` means
// "quota-shaped but it never said weekly", and does not authorise the reserve.
let quota = 'none';
let quotaRaw = '';
if (failed) {
	const parts = [JSON.stringify(result.error || ''), status, stderr, response.slice(0, 4000)];
	const hay = parts.join(' \n ').toLowerCase();
	if (/quota|rate.?limit|resource.?exhausted|\b429\b|too many requests|usage limit|limit reached|exhausted/.test(hay)) {
		if (/week/.test(hay)) quota = 'weekly';
		else if (/5.?hour|five.?hour|hourly/.test(hay)) quota = 'fivehour';
		else quota = 'unknown';
		quotaRaw = [JSON.stringify(result.error || ''), stderr].join(' ').replace(/\s+/g, ' ').trim().slice(0, 400);
	}
}

fs.writeFileSync(classPath,
	`quota=${quota}\ntools=${tools.size}\nstatus=${status}\n` +
	`killed=${killed ? 1 : 0}\nidle=${idleArg || 0}\ndeferred=${deferred ? 1 : 0}\n` +
	`raw=${quotaRaw.replace(/\n/g, ' ')}\n`);

const u = result.usage || {};
const pad = s => String(s).padEnd(13);
console.log(pad('status'), status || '(none)');
console.log(pad('model'), init.model || '(unknown)');
// Wall clock is measured by the caller. result.duration_seconds is NOT the run:
// on a --continue it reports time since the *thread* started, which read
// 21286s for a 246s run. Keep both, clearly labelled.
console.log(pad('duration'), `${wall}s wall / ${result.duration_seconds ?? '?'}s thread-elapsed / ${result.num_turns ?? '?'} turns`);
console.log(pad('tokens'), `in ${u.input_tokens ?? '?'}  out ${u.output_tokens ?? '?'}  think ${u.thinking_tokens ?? '?'}  total ${u.total_tokens ?? '?'}`);
console.log(pad('tools'), tools.size
	? [...tools].map(([n, c]) => `${n}x${c}`).join('  ')
	: deferred ? 'NONE recorded — but the stream was cut off; see the report and the diff'
	           : 'NONE — the run touched nothing');
// A stream that stops mid-flight is a floor, not a total. Presented as a run
// summary it reads as proof the implementer wrote nothing — next to a commit
// that is on disk. Say which of the two it is.
if (deferred) console.log(pad(''), 'floor, not a total — the stream ended before the run did');
if (quota !== 'none') {
	console.log(pad('quota'), quota === 'weekly'   ? 'WEEKLY bucket exhausted'
	                        : quota === 'fivehour' ? '5-hour window exhausted (refreshes on its own)'
	                        :                        'quota-shaped error, bucket UNCLEAR');
	if (quotaRaw) console.log(pad(''), quotaRaw);
}

let problems = 0;
const fail = (headline, lines) => {
	problems++;
	console.log('\nFAIL  ' + headline);
	(lines || []).slice(0, 15).forEach(l => console.log('      - ' + l));
};

if (bypasses.length) {
	fail(`${bypasses.length} denied command(s) then ran under another name — BYPASS.`, bypasses);
	console.log('      The boundary held and the implementer walked around it. The work');
	console.log('      happened somewhere you did not authorise, and the report will');
	console.log('      describe it as done — accurately. Treat the whole report as');
	console.log('      unverified, and fix the boundary before re-running.');
}
if (denials.length) {
	fail(`${denials.length} tool call(s) BLOCKED despite --dangerously-skip-permissions.`, denials);
	console.log('      The run still exited 0 with status SUCCESS. Report is unreliable.');
}
if (deferred) {
	console.log(killed
		? `\nNOTE  watchdog killed this run after ${idleArg}s of stream silence.`
		: '\nNOTE  the session ended before its result event — agy stopped on its own.');
	console.log('      status, response and exit code are not judged; the evidence');
	console.log('      is now the fence, the gates and the report on disk.');
} else if (status !== 'SUCCESS') {
	fail('status is not SUCCESS', result.error ? [JSON.stringify(result.error)] : []);
}
if (errors.length) fail(`${errors.length} tool error(s)`, errors);
if (!tools.size) fail(deferred
	? 'no tool calls recorded before the stream ended — nothing evidences any work'
	: 'no tool calls recorded — the implementer answered without doing the work');
if (!deferred && !response.trim()) fail('empty response — the implementer produced no report');
if (!deferred && Number(agyCode) !== 0) fail(`agy exited ${agyCode}`);

process.exit(problems ? 1 : 0);
NODE
	return $?
}

# ------------------------------------------------------------------- attempt 1
printf -- '\n--- run report -----------------------------------------------------\n'
run_attempt "$FIRST_MODEL" "$BASE" "$CONTINUE"
stream_rc=$?

USED_MODEL="$FIRST_MODEL"
FELL_BACK=0
HANDOVER=""

read_class() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }

# The attempt that actually decided the outcome. A fallback overwrites nothing,
# it writes its own class file, so the watchdog state must be read from the
# last attempt rather than the first.
LAST_CLASS="$BASE.class"

quota_class="$(read_class "$BASE.class" quota)"
tools_used="$(read_class "$BASE.class" tools)"

# ------------------------------------------------------------------- attempt 2
# Only a clear weekly exhaustion opens the reserve. A spent 5-hour window waits
# it out; an unclear quota error stops and shows its raw text.
if [ "$stream_rc" -ne 0 ] && [ "$AGY_FALLBACK" = "auto" ]; then
	case "$quota_class" in
	weekly)
		printf -- '\n--- falling back to the reserve group -------------------------------\n'
		printf 'The Gemini WEEKLY bucket is spent. Switching to %s.\n' "$AGY_FALLBACK_MODEL"
		printf 'This group drains fast — the next dispatch starts on Gemini again.\n\n'

		# A run that already touched the tree must be handed over, not restarted:
		# a cold retry would redo half-finished work on top of itself.
		HANDOVER_FLAG="$CONTINUE"
		if [ "${tools_used:-0}" != "0" ]; then
			HANDOVER_FLAG="--continue"
			HANDOVER="mid-run: Gemini had already made ${tools_used} tool call(s) before the wall"
			printf 'NOTE  %s.\n' "$HANDOVER"
			printf '      Resuming the thread so the reserve continues rather than restarts.\n\n'
		fi

		run_attempt "$AGY_FALLBACK_MODEL" "$BASE.reserve" "$HANDOVER_FLAG"
		stream_rc=$?
		LAST_CLASS="$BASE.reserve.class"
		USED_MODEL="$AGY_FALLBACK_MODEL"
		FELL_BACK=1
		# The header's log line named the attempt that hit the wall. Everything
		# from here — the event stream and the implementer's own narrative —
		# lives under a different base, and the path already on screen now
		# points at a failed run.
		LOG_BASE="$BASE.reserve"
		;;
	fivehour)
		printf -- '\n--- holding --------------------------------------------------------\n'
		printf 'The Gemini 5-hour window is spent but the weekly bucket is not. Holding:\n'
		printf 'that window refreshes within hours, and the reserve group is scarcer\n'
		printf 'than the wait. Re-run this dispatch after the refresh, or override with\n'
		printf 'AGY_FALLBACK=force if you need it done now.\n'
		;;
	unknown)
		printf -- '\n--- holding --------------------------------------------------------\n'
		printf 'A quota-shaped error came back that does not say which bucket it is.\n'
		printf 'Not spending the reserve on a guess. The raw text is in the run report\n'
		printf 'above and in %s.\n' "$BASE.class"
		printf 'If the interactive panel shows the weekly bucket spent, re-run with\n'
		printf 'AGY_FALLBACK=force — and fix the matcher in .agy/dispatch.\n'
		;;
	esac
fi

# ------------------------------------------------- report freshness (deferred)
# On a deferred run the response never arrived, so the report on disk is the
# only account of what happened. It has to be THIS run's report: a stale one
# left by an earlier dispatch would otherwise sail through on a clean fence and
# a green gate, which is the exact shape of a run that did nothing at all.
WATCHDOG_KILLED="$(read_class "$LAST_CLASS" killed)"
DEFERRED="$(read_class "$LAST_CLASS" deferred)"
WATCHDOG_IDLE="$(read_class "$LAST_CLASS" idle)"

# Freshness is computed on every run, not just a deferred one: a report is only
# evidence about THIS dispatch if this dispatch wrote it. Only the deferred path
# fails on it, because there the report is the sole account of the work.
REPORT_FRESH=0
if [ -n "$REPORT" ] && [ -f "$REPORT" ] \
	&& [ "$(stat -c %Y "$REPORT" 2>/dev/null || echo 0)" -ge "$RUN_START" ]; then
	REPORT_FRESH=1
fi

if [ "$DEFERRED" = "1" ] && [ -n "$REPORT" ]; then
	printf -- '\n--- report freshness -----------------------------------------------\n'
	if [ ! -f "$REPORT" ]; then
		printf 'FAIL  no report at %s.\n' "$REPORT"
		printf '      The run stopped and left no account of itself.\n'
		stream_rc=1
	elif [ "$REPORT_FRESH" != "1" ]; then
		printf 'FAIL  %s predates this run.\n' "$REPORT"
		printf '      It is a leftover from an earlier dispatch, not this one.\n'
		stream_rc=1
	else
		printf 'ok    %s was written during this run.\n' "$REPORT"
	fi
fi

# ------------------------------------------------------------ report contract
# The contract asks for sections the harness can check for, and nothing checked.
# An absent `## Observations` is ambiguous in the worst direction: it reads
# identically whether there was nothing to observe or the implementer never
# looked, and the second is the case you need to know about.
#
# Unlike the claims comparison below this is deterministic — a heading is there
# or it is not — so it fails the run rather than warning. Warnings are for
# checks that can be wrong. The fix is one `--continue` away.
if [ "$REPORT_FRESH" = "1" ]; then
	printf -- '\n--- report contract ------------------------------------------------\n'
	missing_section=0
	while IFS= read -r sec; do
		[ -n "$sec" ] || continue
		if grep -qF -- "$sec" "$REPORT"; then
			printf 'ok    %s\n' "$sec"
		else
			printf 'FAIL  the report has no `%s` section.\n' "$sec"
			missing_section=1
		fi
	done <<EOF
${AGY_REPORT_SECTIONS:-## Observations}
EOF
	if [ "$missing_section" = "1" ]; then
		printf '      "None." is a valid body. A section left out is not the same as\n'
		printf '      one saying there was nothing — only one of them tells you the\n'
		printf '      implementer looked.\n'
		stream_rc=1
	fi
fi

# ------------------------------------------------------------- check the fence
printf -- '\n--- fence ----------------------------------------------------------\n'
bash .agy/tripwire verify "$SNAP"
trip_rc=$?

# ------------------------------------------------------------------- run gates
printf -- '\n--- gates ----------------------------------------------------------\n'
if [ "${AGY_SKIP_GATES:-0}" = "1" ]; then
	printf 'skipped (AGY_SKIP_GATES=1). Run the gates before believing anything.\n'
	gates_rc=-1
elif [ -z "$AGY_GATES" ]; then
	printf 'AGY_GATES is empty in .agy/config. A dispatch with no gate is a dispatch\n'
	printf 'you cannot check. Configure it before trusting any of this.\n'
	gates_rc=99
else
	# Output is teed, not swallowed: the gates stay visible in real time, and
	# the copy is what the report's own numbers get measured against below.
	# shellcheck disable=SC2086
	bash $AGY_GATES 2>&1 | tee "$BASE.gates.log"
	gates_rc=${PIPESTATUS[0]}
fi

# ------------------------------------------------------- report vs gate output
# The report is the implementer's account of its work. The gates are a
# measurement of it. Where both name the same quantity, the measurement wins.
#
# This is a warning, not a gate, and it is deliberately narrow: only a unit that
# appears on BOTH sides is ever compared, because the gates cannot contradict a
# number they never measured. A checker that invents disagreements teaches the
# controller to ignore it, which is worse than not having one.
CLAIMS_RC=0
if [ "$REPORT_FRESH" = "1" ] && [ "$gates_rc" -ge 0 ] && [ -s "$BASE.gates.log" ]; then
	printf -- '\n--- report vs gates ------------------------------------------------\n'
	node - "$REPORT" "$BASE.gates.log" <<'NODE'
const fs = require('fs');
const [, , reportPath, gatesPath] = process.argv;
const read = p => { try { return fs.readFileSync(p, 'utf8'); } catch (e) { return ''; } };

// Quantities a gate suite actually measures and a report actually claims.
// Anything outside this list (minutes, commits, line numbers) is not compared.
const UNITS = ['assertion', 'test', 'check', 'gate', 'spec', 'example', 'case', 'suite', 'failure', 'error', 'warning'];
const singular = w => w.toLowerCase().replace(/e?s$/, '').replace(/^(assertion|test|check|gate|spec|example|case|suite|failure|error|warning)$/, '$1');

const grab = text => {
	const found = new Map();
	const add = (n, w) => {
		const unit = singular(w);
		if (!UNITS.includes(unit)) return;
		if (!found.has(unit)) found.set(unit, new Set());
		found.get(unit).add(n.replace(/,/g, ''));
	};
	let m;
	const forward = /(\d[\d,]*)\s+([A-Za-z]+)/g;          // "719 assertions"
	while ((m = forward.exec(text))) add(m[1], m[2]);
	const reverse = /([A-Za-z]+)\s*[:=]\s*(\d[\d,]*)/g;    // "assertions: 64"
	while ((m = reverse.exec(text))) add(m[2], m[1]);
	return found;
};

const claimed = grab(read(reportPath));
const measured = grab(read(gatesPath));

const conflicts = [];
for (const [unit, nums] of claimed) {
	const got = measured.get(unit);
	if (!got) continue;
	for (const n of nums) if (!got.has(n)) conflicts.push({ unit, n, got: [...got] });
}

if (!conflicts.length) {
	console.log('ok    no number in the report contradicts the gate output.');
	process.exit(0);
}
for (const c of conflicts) {
	console.log(`CLAIM the report says ${c.n} ${c.unit}(s); the gates reported ${c.got.join(', ')}.`);
}
console.log('      The gates measured it; the report only asserts it. Resolve this');
console.log('      before accepting the task. A number that drifts is usually work');
console.log('      that was described rather than done.');
process.exit(1);
NODE
	CLAIMS_RC=$?
fi

# --------------------------------------------------------------------- verdict
printf -- '\n--- verdict --------------------------------------------------------\n'
v() { printf '  %-7s %s\n' "$1" "$2"; }
if [ "$FELL_BACK" -eq 1 ]; then
	v model "$USED_MODEL  <- RESERVE GROUP BURNED (Gemini weekly exhausted)"
	[ -n "$HANDOVER" ] && v '' "$HANDOVER"
elif [ "$AGY_FALLBACK" = "force" ]; then
	v model "$USED_MODEL  <- reserve group, forced"
else
	v model "$USED_MODEL"
fi
if [ "$stream_rc" -ne 0 ]; then
	v run 'PROBLEMS — see run report above'
elif [ "$WATCHDOG_KILLED" = "1" ]; then
	v run "clean, but WATCHDOG-KILLED after ${WATCHDOG_IDLE}s idle (agy failure 4)"
	v '' 'the work stands on the report, the fence and the gates below'
elif [ "$DEFERRED" = "1" ]; then
	# The other way to lose the result event: agy stopped on its own while the
	# stream was still moving, so the watchdog never fired. Same verdict, and it
	# has to be sayable — otherwise the only vocabulary for "the work landed,
	# the session died" is PROBLEMS.
	v run 'clean, but the SESSION DIED before its result event (agy failure 4)'
	v '' 'the work stands on the report, the fence and the gates below'
else
	v run 'clean'
fi
if [ "$trip_rc"  -eq 0 ]; then v fence 'clean — no guarded surface moved'; else v fence 'VIOLATED — see fence section above'; fi
# Printed here as well as in the header because the header's copy was written
# before any attempt ran. On a fallback the two differ, and this is the one a
# reader acts on: it names the attempt that produced the work rather than the
# attempt that hit the wall.
v log "$LOG_BASE.ndjson"
if   [ "$gates_rc" -eq 0 ]; then v gates 'green'
elif [ "$gates_rc" -lt 0 ]; then v gates 'not run'
else v gates "$gates_rc FAILING"
fi
if [ "$CLAIMS_RC" -ne 0 ]; then
	v claims 'CONTRADICTED by the gates — see the section above'
	v '' 'not a gate failure on its own; do not accept the task on it'
fi
printf '\n  fence snapshot kept at %s\n' "$SNAP"

if [ "$trip_rc" -ne 0 ]; then
	printf '\nA guarded surface moved. Investigate that before reading anything else.\n'
	exit 4
fi
if [ "$stream_rc" -ne 0 ] || [ "$gates_rc" -gt 0 ]; then
	exit 1
fi
exit 0
