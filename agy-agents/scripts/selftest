#!/usr/bin/env bash
#
# Prove the harness still works, in a throwaway repo, without spending a token
# of quota.
#
#   selftest [--keep]
#
# Every assertion here exists because the property it checks is one you cannot
# see failing from the outside. A fence that hashes nothing still prints
# "clean"; a gate runner with no gates still exits 0 if you let it; a quota
# classifier that falls back too eagerly just quietly burns the scarce bucket.
# Run this after editing anything in assets/.
#
# The Antigravity CLI is stubbed. `agy` is never really called.

set -uo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KEEP=0
[ "${1:-}" = "--keep" ] && KEEP=1

TMP="$(mktemp -d)"
REPO="$TMP/repo"
BIN="$TMP/bin"
PASS=0; FAIL=0

ok()   { PASS=$((PASS+1)); printf '  PASS  %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  FAIL  %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; }
want() { # want <label> <expected-rc> <actual-rc> [detail]
	if [ "$2" = "$3" ]; then ok "$1"; else bad "$1" "expected exit $2, got $3. ${4:-}"; fi
}
has()  { # has <label> <needle> <file>
	if grep -qF -- "$2" "$3" 2>/dev/null; then ok "$1"; else bad "$1" "no '$2' in $(basename "$3")"; fi
}
hasnt() {
	if grep -qF -- "$2" "$3" 2>/dev/null; then bad "$1" "unexpected '$2'"; else ok "$1"; fi
}
# Not `hasnt "$(printf '\r')"`. grep here strips a CR that sits at a line ending,
# so a search for one cannot see the very case this asserts against: a forged
# value whose CR precedes the newline it injected. That assertion passed against
# a file with the carriage return still in it, under the mutation built to break
# it — found by predicting the red labels first and finding this one green.
# Count the bytes instead; `tr` has no notion of a line.
no_cr() { # no_cr <label> <file>
	n_cr="$(tr -cd '\r' < "$2" 2>/dev/null | wc -c | tr -d ' ')"
	if [ "${n_cr:-0}" = "0" ]; then ok "$1"
	else bad "$1" "$n_cr carriage return(s) survived into $(basename "$2")"; fi
}
# `has key=` is a substring search, so it passes on a key whose value is empty —
# which is exactly how a run that measured nothing looks. These three read the
# value the way dispatch's own read_class does, through one reader, so a test
# cannot disagree with the thing it is testing about what a key says.
class_val() { # class_val <file> <key>
	sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1
}
hasval() { # hasval <label> <key> <file> — present AND carrying a value
	# Absent and empty are different defects: one means the writer never ran,
	# the other means it ran and had nothing to say. Say which.
	if ! grep -q -- "^$2=" "$3" 2>/dev/null; then
		bad "$1" "no '$2=' line at all in $(basename "$3")"
	elif [ -z "$(class_val "$3" "$2")" ]; then
		bad "$1" "'$2=' is present but empty in $(basename "$3")"
	else ok "$1"; fi
}
noval() { # noval <label> <key> <file> — present AND deliberately empty
	if ! grep -q -- "^$2=" "$3" 2>/dev/null; then
		bad "$1" "no '$2=' line at all in $(basename "$3")"
	else
		nv="$(class_val "$3" "$2")"
		if [ -z "$nv" ]; then ok "$1"; else bad "$1" "'$2=' is '$nv', expected empty"; fi
	fi
}

cleanup() {
	if [ "$KEEP" -eq 1 ]; then
		printf '\nkept: %s\n' "$TMP"
	else
		rm -rf "$TMP"
	fi
}
trap cleanup EXIT

# --------------------------------------------------------------- the fake agy
# One model reports an exhausted bucket (FAKE_ERROR picks which wording) and
# every other model succeeds. FAKE_QUOTA_MODEL is the case glob naming which
# one, defaulting to *gemini*.
#
# That glob used to be hardcoded, and the hardcoding was the bug: a Claude
# primary could not fail on quota at all, so a fallback that was structurally
# unreachable under AGY_MODEL=claude-* (GST-40) stayed invisible behind a green
# suite. Same shape as the --effort bug one layer up. A test double narrower
# than the thing it doubles does not test the thing it doubles.
mkdir -p "$BIN"
cat > "$BIN/agy" <<'STUB'
#!/usr/bin/env bash
model=""; prev=""
for a in "$@"; do [ "$prev" = "--model" ] && model="$a"; prev="$a"; done

# Every argv this stub was called with, one invocation per line, so a test can
# assert on the command line that was actually built rather than on the run's
# outcome. Nothing else records it: the flags a dispatch assembles are otherwise
# visible only to a process that is deliberately fake.
[ -n "${AGY_ARGV_LOG:-}" ] && printf '%s\n' "$*" >> "$AGY_ARGV_LOG"

# --effort is Gemini-only, and the real binary does not take it politely: off the
# Gemini line it exits immediately, having run zero turns. This stub used to
# accept every flag on every model, which is exactly why the suite stayed green
# through a reserve path that could not run anywhere. A test double more
# permissive than the thing it doubles does not test the thing it doubles.
case "$model" in
	gemini*) ;;
	*) for a in "$@"; do
		[ "$a" = "--effort" ] || continue
		printf 'error: unknown flag --effort for model %s\n' "$model" >&2
		exit 2
	done ;;
esac

printf '%s\n' '{"event":"init","conversation_id":"'"${FAKE_CONV:-conv-fixture-0001}"'","init":{"model":"'"$model"'","cwd":"/repo"}}'

# A real run reports token usage on its result event; this one does it only when
# asked. Both halves need testing and they need separate runs: that the numbers
# survive to disk exactly, and that a run which reported nothing is recorded as
# having reported nothing rather than as having used none. The values are
# deliberately unmistakable — no 0, no 1, nothing a miscount could land on — and
# the total is the sum, so a reader that mixes the keys up is visible too.
USAGE=""
#
# The arithmetic is the wire's, not a convenient one. Measured against the real
# binary: in 13751, out 25, think 24, total 13776 - that is total = in + out,
# with thinking counted INSIDE output and never added again. This fixture used
# to make the total the sum of all three, which asserts the opposite of what
# agy does and would keep a cost model that bills thinking twice green. Same
# rule as the --effort case thirty lines up: a double that is not the thing it
# doubles does not test the thing it doubles.
#
# cache_read_tokens is on the wire too and the sidecar never recorded it. It
# reads 0 on a cold run, which is why it went unnoticed; it is deliberately
# non-zero here so a reader that drops the key is visible.
[ -n "${FAKE_USAGE:-}" ] && USAGE=',"usage":{"input_tokens":13571,"output_tokens":24680,"thinking_tokens":17280,"cache_read_tokens":2048,"total_tokens":38251}'

# A report written by the run itself, so it is genuinely newer than RUN_START.
if [ -n "${FAKE_REPORT:-}" ] && [ -n "${FAKE_REPORT_TEXT:-}" ]; then
	printf '%s\n' "$FAKE_REPORT_TEXT" > "$FAKE_REPORT"
fi

# What the run leaves on the tree, which is the only evidence that separates a
# run that implemented the task from one that only described it. FAKE_TOUCH
# writes a file; FAKE_COMMIT commits it the way the protocol expects.
if [ -n "${FAKE_TOUCH:-}" ]; then
	printf 'implemented\n' > "$FAKE_TOUCH"
	if [ -n "${FAKE_COMMIT:-}" ]; then
		git add -A >/dev/null 2>&1
		# FAKE_COAUTHOR is the trailer the run claims. Unset means no trailer at
		# all, which is what most tests want; the attribution tests set it.
		msg="task work: $FAKE_TOUCH"
		# FAKE_BODY is a prose paragraph between the subject and the trailer
		# block — the shape a commit takes when it talks *about* a trailer.
		[ -n "${FAKE_BODY:-}" ] && msg="$msg

$FAKE_BODY"
		[ -n "${FAKE_COAUTHOR:-}" ] &&
			msg="$msg

Co-Authored-By: $FAKE_COAUTHOR"
		git commit -qm "$msg" >/dev/null 2>&1
	fi
fi

# The run rewrites a commit that predates it — an amend, a rebase, a squash of
# someone else's work. The pre-run head stops being an ancestor of HEAD, so what
# landed cannot be counted at all. Deliberately a NEW message: an amend that
# reproduces the same tree, message and timestamps produces the same sha, and
# then nothing has been rewritten.
if [ -n "${FAKE_REWRITE:-}" ]; then
	git commit -q --amend -m "task work: history rewritten under the run" >/dev/null 2>&1
fi

# A status carrying line breaks. Not a hypothetical: `status` is whatever the
# stream says it is, and the sidecar is a flat key=value file read first-match-
# wins, so a value with a newline in it writes rows of its own — above the
# genuine ones. The CR is there too, because it corrupts a value without
# splitting a row and is the half a \n-only sanitiser misses.
if [ -n "${FAKE_INJECT:-}" ]; then
	printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"DONE","tool_name":"replace_file_content","tool_info":{"name":"replace_file_content","parameters":{}}}}'
	printf '%s\n' '{"event":"result","result":{"status":"SUCCESS\r\nwall=999999\nmodel=INJECTED","response":"Did the work.","num_turns":1,"duration_seconds":2}}'
	exit 0
fi

# A blocked call, followed by the same call wearing a wrapper the deny rule
# does not recognise. Both lines are in the stream; only the pair means anything.
if [ -n "${FAKE_BYPASS:-}" ]; then
	printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"ERROR","tool_name":"run_command","tool_info":{"name":"run_command","parameters":{"CommandLine":"npm install"},"error":{"message":"Command was denied permission by user settings"}}}}'
	printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"DONE","tool_name":"run_command","tool_info":{"name":"run_command","parameters":{"CommandLine":"cmd /c npm install"}}}}'
	printf '%s\n' '{"event":"result","result":{"status":"SUCCESS","response":"Installed the dependencies and ran the suite.","num_turns":3,"duration_seconds":7}}'
	exit 0
fi

# GST-41: a tool call fails and the run works around it. Antigravity's
# write_to_file is sandboxed to the agent's own brain directory and refuses a
# path outside it — including the report path, the one file the contract names.
# The run recovers through run_command, and agy still downgrades the result to
# ERROR and exits non-zero. Everything that distinguishes this from a run that
# did nothing is on disk; none of it is in the status or the exit code.
#
# The refusal is worded the way a sandbox words it, and deliberately NOT the way
# a permission denial does: those are a different class here — never recovered
# from — and a fixture that blurred them would test the wrong branch. Set
# FAKE_TOOL_ERROR=denial to put a real denial in the same stream, which is how
# the conduct leg of the recovery test is driven.
if [ -n "${FAKE_TOOL_ERROR:-}" ]; then
	printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"ERROR","tool_name":"write_to_file","tool_info":{"name":"write_to_file","parameters":{"file_path":".agy/work/m1/task-9-report.md"},"error":{"message":"write_to_file is restricted to the agent workspace; that path is outside it"}}}}'
	printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"DONE","tool_name":"run_command","tool_info":{"name":"run_command","parameters":{"CommandLine":"cat > .agy/work/m1/task-9-report.md"}}}}'
	if [ "$FAKE_TOOL_ERROR" = "denyrule" ]; then
		printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"ERROR","tool_name":"write_to_file","tool_info":{"name":"write_to_file","parameters":{"file_path":"/scratch/notes.md"},"error":{"message":"Matches user-configured deny rule"}}}}'
	fi
	if [ "$FAKE_TOOL_ERROR" = "denial" ]; then
		printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"ERROR","tool_name":"run_command","tool_info":{"name":"run_command","parameters":{"CommandLine":"git push"},"error":{"message":"Command was denied permission by user settings"}}}}'
	fi
	printf '%s\n' '{"event":"result","result":{"status":"ERROR","error":{"message":"a tool call failed during this session"},"response":"write_to_file refused the report path, so I wrote it through run_command instead. The task is done and committed.","num_turns":4,"duration_seconds":11}}'
	exit 1
fi

# Trap 4: the run does the work, writes its report, and then never emits a
# result event. FAKE_HANG is how many seconds it sits there; FAKE_REPORT, when
# set, is the report it claims to have written on the way.
if [ -n "${FAKE_HANG:-}" ]; then
	printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"DONE","tool_name":"replace_file_content","tool_info":{"name":"replace_file_content","parameters":{}}}}'
	# Contract-shaped, so the watchdog tests exercise the watchdog rather than
	# tripping the report-contract check on a fixture no implementer would write.
	[ -n "${FAKE_REPORT:-}" ] && printf 'the work, as written by the run that then hung\n\n## Observations\nNone.\n' > "$FAKE_REPORT"
	sleep "$FAKE_HANG"
	exit 0
fi

# Trap 4, livelock variant: the run does the work, writes its report, and then
# parks itself in a poll loop — scheduling a short wake to check on its own
# task, and re-arming when it fires. Observed twice on the same tool call. The
# stream never goes quiet, so the idle watchdog has nothing to measure; only a
# cap on total elapsed time can tell this apart from a run still working.
if [ -n "${FAKE_LIVELOCK:-}" ]; then
	printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"DONE","tool_name":"replace_file_content","tool_info":{"name":"replace_file_content","parameters":{}}}}'
	[ -n "${FAKE_REPORT:-}" ] && printf 'the work, as written by the run that then would not stop\n\n## Observations\nNone.\n' > "$FAKE_REPORT"
	while :; do
		printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"DONE","tool_name":"schedule","tool_info":{"name":"schedule","parameters":{"DurationSeconds":5,"Prompt":"Check on verify task"}}}}'
		sleep 1
	done
fi

# Trap 4, chatty variant: the run does the work and writes its report, and then
# the session dies on its own — agy's own --print-timeout expiring, an internal
# error, a dropped connection — without ever emitting `result`. The watchdog
# never fires, because the stream was still moving right up to the moment it
# stopped. Everything the harness normally judges (status, response, exit code)
# describes the death rather than the work.
if [ -n "${FAKE_DIE:-}" ]; then
	printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"DONE","tool_name":"replace_file_content","tool_info":{"name":"replace_file_content","parameters":{}}}}'
	if [ -n "${FAKE_REPORT:-}" ]; then
		printf 'the work, as written by the run whose session then died\n\n## Observations\nNone.\n' > "$FAKE_REPORT"
	fi
	printf 'timeout waiting for response\n' >&2
	exit 1
fi

case "$model" in
${FAKE_QUOTA_MODEL:-*gemini*})
	case "${FAKE_ERROR:-long}" in
	short)    msg="Rate limit: 5 hour limit reached, refreshes in 3h45m" ;;
	# Anthropic's individual-quota wording, from the field report that became
	# GST-40. It never says week and never says hour: the only bucket evidence
	# it carries is the reset time it states about itself.
	ashort)   msg="Individual quota reached. Please try again later. Resets in 3h27m2s." ;;
	# The same sentence with a horizon that can only be the long bucket. The
	# duration is the ONLY difference between this row and the one above, which
	# is what makes the pair a test of the horizon rather than of the wording.
	along)    msg="Individual quota reached. Please try again later. Resets in 2d4h." ;;
	unknown)  msg="429 RESOURCE_EXHAUSTED" ;;
	none)     printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"DONE","tool_name":"run_command","tool_info":{"name":"run_command","parameters":{}}}}'
	          printf '%s\n' '{"event":"result","conversation_id":"'"${FAKE_CONV:-conv-fixture-0001}"'","result":{"status":"SUCCESS","response":"The primary model did the work.","num_turns":'"${FAKE_TURNS:-2}"',"duration_seconds":5'"$USAGE"'}}'
	          exit 0 ;;
	*)        msg="RESOURCE_EXHAUSTED: weekly limit reached for Gemini models" ;;
	esac
	printf '%s\n' '{"event":"result","result":{"status":"ERROR","error":{"message":"'"$msg"'"},"response":"","num_turns":0,"duration_seconds":3}}'
	exit 1 ;;
*)
	printf '%s\n' '{"event":"step_update","step_update":{"step_type":"tool","state":"DONE","tool_name":"replace_file_content","tool_info":{"name":"replace_file_content","parameters":{}}}}'
	printf '%s\n' '{"event":"result","result":{"status":"SUCCESS","response":"Reserve model completed the task.","num_turns":2,"duration_seconds":9'"$USAGE"'}}'
	exit 0 ;;
esac
STUB
chmod +x "$BIN/agy"

# PATH entries must be POSIX-form on git-bash. A "C:/..." entry is accepted
# silently and then never resolved, so the REAL agy gets found and dispatched.
# That has happened; it cost ~148k tokens of live quota. Hence the assertion.
BIN_U="$(cygpath -u "$BIN" 2>/dev/null || printf '%s' "$BIN")"
export PATH="$BIN_U:$PATH"

# The watchdog cannot notice the stub has exited any sooner than its next poll,
# so the shipped 15s default would add ~15s to every dispatch below — about
# three minutes of pure sleeping across the suite. The watchdog's own behaviour
# is asserted in its own section, with its own timings.
export AGY_IDLE_POLL=1

# The installer honours AGY_COAUTHOR from the environment, so a maintainer who
# exported theirs would install the fixture with it and the attribution section
# would assert against their address instead of the shipped default. The suite
# has to test what a stranger gets, not what this machine is configured for.
unset AGY_COAUTHOR
case "$(command -v agy)" in
"$BIN_U"/*) ;;
*) printf 'selftest: ABORT — `agy` resolves to %s, not the stub at %s.\n' "$(command -v agy)" "$BIN_U" >&2
   printf 'Refusing to run: this would dispatch the real CLI and spend quota.\n' >&2
   exit 1 ;;
esac

# ------------------------------------------------------------------ the repo
mkdir -p "$REPO/docs" "$REPO/src"
cd "$REPO" || exit 1
git init -q .
git config user.email selftest@local
git config user.name selftest
printf 'spec\n' > docs/spec.md
printf 'x\n'    > src/a.txt
git add -A && git commit -qm init

printf '\n=== install ========================================================\n'
bash "$SKILL_DIR/scripts/install" --project Selftest --milestone m1 >"$TMP/install.log" 2>&1
want "installer exits 0" 0 $?

for f in .agy/config .agy/dispatch .agy/tripwire .agy/review-pkg .agy/gates \
	.agy/work/m1/progress.md .agy/work/m1/dispatch-context.md \
	.claude/skills/agy-task-cycle/SKILL.md; do
	[ -f "$f" ] && ok "wrote $f" || bad "wrote $f" "missing"
done

# The project skill defers to the protocol by absolute path. Rename or move
# reference/protocol.md and every already-installed project silently points at
# nothing — the skill still loads, it just quietly loses its own instructions.
proto="$(sed -n 's/^`\(.*protocol\.md\)`$/\1/p' .claude/skills/agy-task-cycle/SKILL.md | head -1)"
[ -n "$proto" ] && [ -f "$proto" ] \
	&& ok "the project skill's protocol path resolves" \
	|| bad "the project skill's protocol path resolves" "got '${proto:-<unsubstituted>}'"

# A reviewer that cannot run is the one failure whose cheapest resolution — the
# controller grading work against its own brief — silently removes the only
# independent check in the loop, and leaves a task that looks fully reviewed.
# The protocol has to name a state to park the task in: a prohibition with no
# exit is a deadlock, and a deadlock is what gets negotiated away under pressure.
# The project skill is written once, at install, and then survives every
# milestone the project goes through. Anything the installer failed to render
# stays on screen forever as a literal marker, and the "Local rulings" section —
# the one place designed to survive a /clear — is where that had happened.
hasnt "the installed project skill renders every marker" "{{" \
	.claude/skills/agy-task-cycle/SKILL.md
# And it must not restate the workspace: the path carries the milestone slug, so
# a copy of it here is a binding that goes stale silently while every script
# keeps using the real one from .agy/config.
hasnt "the project skill does not hard-code the milestone workspace" ".agy/work/m" \
	.claude/skills/agy-task-cycle/SKILL.md

# The one defect the loop cannot otherwise see: a brief whose invariants do not
# follow from its rules produces exact compliance, a clean review and green
# gates. The controller wrote the brief, so the reviewer is the last agent that
# can catch it — and it will not unless it is asked.
has "the reviewer is asked to grade the brief itself" "Brief integrity" "$proto"
has "  and told the invariants must follow from the rules" \
	"stated invariants actually follow from" "$proto"
has "  and that a brief defect is the controller's to adjudicate" \
	"adjudicated by the controller" "$proto"

# Not the bare word "HELD" — it now appears in several places, so that needle
# passed for the wrong reason. Assert the ledger line's actual shape, including
# the retry field, which is the part a resuming session acts on.
has "the protocol names a HELD state for an unavailable reviewer" \
	"HELD — reviewed by nobody" "$proto"
has "  and makes the held entry say when to retry" \
	"retry after <time, or the condition that clears it>" "$proto"
has "  and schedules the reviewer before the controller's own re-execution" \
	"Order this against step 8" "$proto"
has "  and forbids the controller reviewing its own work" \
	"substitute yourself for the reviewer" "$proto"

# Hermetic: the fence must not depend on this machine's ~/.claude or ~/.gemini,
# which can change under a running session and make the suite flaky.
cat >> .agy/config <<'CFG'
AGY_GUARD_FILES=""
CFG

printf '\n=== fence ==========================================================\n'
bash .agy/tripwire check >"$TMP/f0.log" 2>&1
want "arms and self-verifies clean" 0 $? "$(tail -3 "$TMP/f0.log" | tr '\n' ' ')"

# Every surface must actually contain files. This is the failure that hides:
# a fingerprinter that returns nothing makes the whole fence report clean.
for s in agy claude docs; do
	n="$(bash .agy/tripwire surface "$s" | wc -l)"
	[ "${n:-0}" -gt 0 ] && ok "surface $s fingerprints $n file(s)" \
		|| bad "surface $s fingerprints $n file(s)" "an empty surface guards nothing"
done

SNAP="$TMP/snap"
bash .agy/tripwire snapshot "$SNAP" >/dev/null 2>&1

printf 'planted\n' > docs/planted.md
bash .agy/tripwire verify "$SNAP" >"$TMP/f1.log" 2>&1
want "detects a planted file in a guarded dir" 1 $?
has  "  names the file" "docs/planted.md" "$TMP/f1.log"
rm -f docs/planted.md

# Logs land inside .agy, which is guarded. If the workspace were not pruned,
# every dispatch would trip its own fence and the fence would get switched off.
mkdir -p .agy/work/m1/logs && printf 'log\n' > .agy/work/m1/logs/noise.ndjson
bash .agy/tripwire verify "$SNAP" >"$TMP/f2.log" 2>&1
want "ignores its own workspace writes" 0 $?

printf '\ntampered\n' >> .agy/work/m1/progress.md
bash .agy/tripwire verify "$SNAP" >"$TMP/f3.log" 2>&1
want "detects a ledger edit" 1 $?
git checkout -q -- . 2>/dev/null
git clean -qfd .agy/work/m1/progress.md 2>/dev/null
bash "$SKILL_DIR/scripts/install" --force >/dev/null 2>&1
cat >> .agy/config <<'CFG'
AGY_GUARD_FILES=""
CFG

bash .agy/tripwire snapshot "$SNAP" >/dev/null 2>&1
printf 'more\n' > src/b.txt
git add -A && git commit -qm "task work" >/dev/null 2>&1
bash .agy/tripwire verify "$SNAP" >"$TMP/f4.log" 2>&1
want "allows a fast-forward commit" 0 $?
has  "  reports the new commit" "task work" "$TMP/f4.log"

git checkout -q -b sneaky
bash .agy/tripwire verify "$SNAP" >"$TMP/f5.log" 2>&1
want "detects a branch switch" 1 $?
git checkout -q - && git branch -qD sneaky

mkdir -p hollow
AGY_GUARD_DIRS=".agy .claude docs hollow" AGY_REQUIRE="hollow" \
	bash .agy/tripwire snapshot "$TMP/snap2" >"$TMP/f6.log" 2>&1
want "refuses to arm on an empty required surface" 1 $?
has  "  says why" "would guard nothing" "$TMP/f6.log"
rmdir hollow

# A baseline is only evidence about the config it was armed for, and verify
# used to walk the current surface list without ever looking at what the
# baseline held. That was wrong in both directions at once: a surface the
# baseline never recorded read as an empty "before" and reported every file
# under it as `added` — a fully populated VIOLATION for a tree in which
# nothing moved — while a surface the baseline held but the config no longer
# lists was never visited, so tampering under it reported clean. Both halves
# are asserted, and both must exit 2: this is a config fault, not drift, and
# the exit code is what tells a controller which one to go and look at.
mkdir -p "$TMP/alien"
cp "$SNAP/git.txt" "$TMP/alien/" && cp "$SNAP/docs.fp" "$TMP/alien/tokens.fp"
bash .agy/tripwire verify "$TMP/alien" >"$TMP/f10.log" 2>&1
want  "a baseline armed for other surfaces REFUSES to judge" 2 $?
has   "  says it could not judge" "cannot judge" "$TMP/f10.log"
hasnt "  does not report it as drift" "VIOLATION" "$TMP/f10.log"

mkdir -p extra-guarded && printf 'x\n' > extra-guarded/f.txt
AGY_GUARD_DIRS=".agy .claude docs extra-guarded" \
	bash .agy/tripwire snapshot "$TMP/snap6" >/dev/null 2>&1
printf 'tampered\n' >> extra-guarded/f.txt
bash .agy/tripwire verify "$TMP/snap6" >"$TMP/f11.log" 2>&1
want "a surface dropped from the config REFUSES to judge rather than reporting clean" 2 $?
has  "  names the dropped surface" "extra-guarded" "$TMP/f11.log"
rm -rf extra-guarded

printf '\n=== guard lists ====================================================\n'
# The original silent failure: a guard list is whitespace-separated, so a path
# containing a space becomes several nonexistent paths, each fingerprints
# nothing, and the fence reports CLEAN while guarding nothing at all. Both
# halves are asserted — that the newline form keeps such a path whole, and that
# the split form is now loud instead of clean.
mkdir -p "$REPO/guarded dir"
printf 'x\n' > "$REPO/guarded dir/f.txt"

n="$(AGY_GUARD_DIRS=".agy
.claude
guarded dir" bash .agy/tripwire surface "guarded-dir" 2>/dev/null | wc -l)"
[ "${n:-0}" -eq 1 ] \
	&& ok "a newline-separated list keeps a path with a space whole" \
	|| bad "a newline-separated list keeps a path with a space whole" "fingerprinted $n file(s), wanted 1"

AGY_GUARD_DIRS=".agy .claude guarded dir" \
	bash .agy/tripwire snapshot "$TMP/snap3" >"$TMP/f7.log" 2>&1
want "a space-split path REFUSES to arm rather than guarding nothing" 1 $?
has  "  names the fragment"   "does not exist" "$TMP/f7.log"
has  "  says how to write it" "one path per line" "$TMP/f7.log"

# Same rule, reached the ordinary way: a guarded path that was moved or typo'd.
# Without it the surface is simply absent from the comparison, and absence is
# indistinguishable from "nothing changed".
AGY_GUARD_DIRS=".agy .claude docs-that-moved" \
	bash .agy/tripwire snapshot "$TMP/snap4" >"$TMP/f8.log" 2>&1
want "a guarded dir that is not on disk REFUSES to arm" 1 $?

# Via AGY_LEDGER, because this suite pins AGY_GUARD_FILES empty for hermeticity
# with a plain assignment, which beats the environment. The ledger is the file
# that most needs this: a dispatch grades itself against a ledger that has to
# be there, and "not there" used to read the same as "unchanged".
AGY_LEDGER="$REPO/never-existed.md" \
	bash .agy/tripwire snapshot "$TMP/snap5" >"$TMP/f9.log" 2>&1
want "a guarded file that is not on disk REFUSES to arm" 1 $?
has  "  names it" "never-existed.md" "$TMP/f9.log"

# The installer must not be the one teaching the broken shape. Its own output is
# what every project's config is copied from and edited by hand thereafter.
has "the installer writes AGY_GUARD_DIRS one path per line" "ONE PATH PER LINE" .agy/config

rm -rf "$REPO/guarded dir"

printf '\n=== gates ==========================================================\n'
cp .agy/gates "$TMP/gates.bak"
# Strip gate CALLS only. A bare `^gate` also deletes `gate() {` and
# `gate_line() {`, leaving orphaned function bodies — the runner then exits 1
# from a syntax error and "no gates fails" passes for entirely the wrong reason.
# A call has whitespace after the name; a definition has "(".
grep -vE '^[[:space:]]*gate(_line)?[[:space:]]' "$TMP/gates.bak" > .agy/gates
bash -n .agy/gates 2>"$TMP/g0.syn"
want "the stripped runner is still valid bash" 0 $? "$(cat "$TMP/g0.syn")"
bash .agy/gates >"$TMP/g0.log" 2>&1
want  "a gate runner with no gates FAILS" 1 $?
has   "  says why" "NO GATES ARE CONFIGURED" "$TMP/g0.log"
hasnt "  does not claim green" "gates green" "$TMP/g0.log"

cp "$TMP/gates.bak" .agy/gates
{ printf 'gate        pass    true\n'; } >> .agy/gates
bash .agy/gates >"$TMP/g1.log" 2>&1
rc=$?
[ "$rc" -ge 0 ] && ok "a configured gate runner runs" || bad "a configured gate runner runs" "rc=$rc"

printf 'gate        boom    false\n' >> .agy/gates
bash .agy/gates >"$TMP/g2.log" 2>&1
[ $? -gt 0 ] && ok "a failing gate is counted" || bad "a failing gate is counted" "exited 0"
cp "$TMP/gates.bak" .agy/gates

printf '\n=== unfilled brief =================================================\n'
# The installer ships dispatch-context.md and the task template full of
# {{markers}} it cannot fill — only the controller knows what goes in them —
# and nothing checked that anyone had. That file is read by every implementer
# and every reviewer on the plan, so an unfilled one is inherited by all of
# them: told the language floor is "{{Language/runtime floor}}", they read no
# constraint, and the gates cannot enforce what was never written down. The run
# then passes on every check the harness has.
mkdir -p .agy/work/m1
printf '# task 9\nDo the thing.\n' > .agy/work/m1/task-9-dispatch.md
CTX=".agy/work/m1/dispatch-context.md"

has "the installer ships the context unfilled" "{{" "$CTX"
grep -q 'unfilled line(s)' "$TMP/install.log" \
	&& ok "the installer says so in its own checks" \
	|| bad "the installer says so in its own checks" "no unfilled-context line in install.log"

bash .agy/dispatch 9 >"$TMP/c1.log" 2>&1
want "refuses to dispatch against an unfilled context" 2 $?
has  "  names the file"        "dispatch-context.md" "$TMP/c1.log"
has  "  refuses out loud"      "REFUSING TO DISPATCH" "$TMP/c1.log"
has  "  offers the escape"     "AGY_ALLOW_UNFILLED" "$TMP/c1.log"

# Deliberate {{...}} in a real brief has to stay possible, or the check becomes
# something people work around by deleting it.
AGY_ALLOW_UNFILLED=1 FAKE_ERROR=none AGY_SKIP_GATES=1 \
	bash .agy/dispatch 9 >"$TMP/c2.log" 2>&1
want "AGY_ALLOW_UNFILLED=1 overrides it" 0 $?

# Fill it the way a controller would, so every dispatch below runs against a
# real context — and so the suite proves the filled form actually passes.
sed -e 's/{{[^}]*}}/filled-in/g' -e '/Delete this quote block/d' "$CTX" > "$TMP/ctx.filled"
cp "$TMP/ctx.filled" "$CTX"

# The task's own brief is checked too: the template is copied per task, and a
# marker left in one is the same failure scoped to one dispatch.
printf '# task 8\nImplement {{THE THING}}.\n' > .agy/work/m1/task-8-dispatch.md
bash .agy/dispatch 8 >"$TMP/c3.log" 2>&1
want "refuses a task brief with a marker left in it" 2 $?
has  "  names the brief" "task-8-dispatch.md" "$TMP/c3.log"
rm -f .agy/work/m1/task-8-dispatch.md

# ------------------------------------------------------- the planning template
# Planning can be dispatched too, which inverts who reviews the plan: the
# implementer writes it and the controller reviews it, instead of the controller
# doing both. That matters because the plan is where the defects measurably are.
# The template is guarded by the same unfilled check as a task brief — an
# unfilled {{SPEC}} would send a planner at nothing in particular and it would
# plan something, which is the failure this whole section exists to prevent,
# one artefact upstream.
PLANT=".agy/work/m1/plan-dispatch.template.md"
[ -f "$PLANT" ] \
	&& ok "the installer ships a planning template" \
	|| bad "the installer ships a planning template" "no file at $PLANT"
has   "  with the workspace substituted in" ".agy/work/m1/plan.md" "$PLANT"
has   "  and the spec left for the controller" "{{SPEC}}" "$PLANT"
# The one content rule the arrangement depends on. A plan carrying complete code
# IS the implementation: reviewing it coarsely is a rubber stamp, reviewing it
# properly costs what writing it would have, and the task dispatch that follows
# is reduced to transcription. If this line goes, the feature is worse than not
# having it, so it is pinned rather than trusted.
has   "  forbidding implementation bodies" "not implementation bodies" "$PLANT"
has   "  and demanding exact values reach the implementer" "A near-miss is a miss" "$PLANT"

cp "$PLANT" .agy/work/m1/plan-prompt.md
bash .agy/dispatch --file .agy/work/m1/plan-prompt.md >"$TMP/p1.log" 2>&1
want "refuses a planning prompt with {{SPEC}} unfilled" 2 $?
has  "  names the prompt file" "plan-prompt.md" "$TMP/p1.log"

sed 's/{{[^}]*}}/filled-in/g' .agy/work/m1/plan-prompt.md > "$TMP/plan.filled"
cp "$TMP/plan.filled" .agy/work/m1/plan-prompt.md
FAKE_ERROR=none AGY_SKIP_GATES=1 \
	bash .agy/dispatch --file .agy/work/m1/plan-prompt.md >"$TMP/p2.log" 2>&1
want "a filled planning prompt dispatches" 0 $?
# Not task-N, so the code-report contract must not be claimed against a run
# whose deliverable is a plan. This is the property that makes --file the right
# entry point rather than a task number with a special case bolted on.
hasnt "  and claims no report contract over a plan" "report contract" "$TMP/p2.log"
rm -f .agy/work/m1/plan-prompt.md

printf '\n=== dispatch =======================================================\n'
bash .agy/dispatch 404 >"$TMP/d0.log" 2>&1
want "refuses a missing dispatch file" 2 $?
# The status was always right; it is the half of the signal a pipe eats.
# `.agy/dispatch 3 | tee log` hands the caller tee's 0, and what is left in the
# log has to say by itself that nothing ran — otherwise a refusal reads like a
# clean run to anything that only reads the output.
has "  a refusal prints a verdict block of its own" "--- verdict" "$TMP/d0.log"
has "  whose first line is the one a controller reads" "run     DID NOT RUN" "$TMP/d0.log"
has "  carrying the exit code in the text"            "exit    2"  "$TMP/d0.log"
has "  and saying the tree is untouched"              "no model was called" "$TMP/d0.log"

bash .agy/dispatch >"$TMP/d0b.log" 2>&1
want "refuses with no task at all" 2 $?
has  "  in the same shape"  "DID NOT RUN — no task given" "$TMP/d0b.log"
has  "  and still shows the usage" "usage: .agy/dispatch" "$TMP/d0b.log"

# The binary that answered, printed on every run. A Windows-form PATH entry is
# accepted and then never searched on MSYS, so the stub you exported can be
# skipped in silence and the real, quota-spending CLI answers instead. That has
# happened here; the resolved path on screen is what makes it visible.
has "the header names the binary that resolved" "binary" "$TMP/c2.log"

AGY_GUARD_DIRS=".agy .claude docs hollow2" AGY_REQUIRE="hollow2" \
	bash .agy/dispatch 9 >"$TMP/d1.log" 2>&1
want "refuses to dispatch when the fence will not arm" 3 $?
has  "  says why" "REFUSING TO DISPATCH" "$TMP/d1.log"
has  "  and reports it as a run that never happened" "DID NOT RUN" "$TMP/d1.log"

run_dispatch() { # run_dispatch <label> <FAKE_ERROR> <AGY_FALLBACK> <expected-rc> <log>
	FAKE_ERROR="$2" AGY_FALLBACK="$3" AGY_SKIP_GATES=1 \
		bash .agy/dispatch 9 >"$5" 2>&1
	want "$1" "$4" $?
}

run_dispatch "long-bucket exhaustion falls back to the reserve" long auto 0 "$TMP/d2.log"
has   "  names the burn"        "RESERVE GROUP BURNED" "$TMP/d2.log"
has   "  used the reserve model" "claude-opus-4-6-thinking" "$TMP/d2.log"
# The header prints its log path before any attempt runs, so on a fallback it
# names the attempt that hit the wall — the reserve attempt writes to a
# different base entirely. A reader following the advertised path then grades a
# failed run's artefacts believing they are the work, which is the failure
# family this whole script exists to prevent, reintroduced by the script itself.
# The verdict block is what a reader acts on, so the real path belongs there.
has   "  the verdict names the reserve log" ".reserve.ndjson" "$TMP/d2.log"

run_dispatch "a spent short window HOLDS" short auto 1 "$TMP/d3.log"
hasnt "  did not burn the reserve" "RESERVE GROUP BURNED" "$TMP/d3.log"
has   "  says it is waiting"       "refreshes within hours" "$TMP/d3.log"

run_dispatch "an unclear quota error HOLDS" unknown auto 1 "$TMP/d4.log"
hasnt "  did not burn the reserve" "RESERVE GROUP BURNED" "$TMP/d4.log"
has   "  shows the raw text"       "does not say which bucket" "$TMP/d4.log"

run_dispatch "AGY_FALLBACK=off never falls back" long off 1 "$TMP/d5.log"
hasnt "  did not burn the reserve" "RESERVE GROUP BURNED" "$TMP/d5.log"

run_dispatch "AGY_FALLBACK=force starts on the reserve" long force 0 "$TMP/d6.log"
has   "  labelled as forced" "reserve group, forced" "$TMP/d6.log"

run_dispatch "a clean primary run stays on the primary" none auto 0 "$TMP/d7.log"
hasnt "  did not touch the reserve" "claude-opus" "$TMP/d7.log"

# ---- GST-40: the bucket is read from the message, not from the vendor -------
#
# Everything above runs the common arrangement — Gemini primary, Claude reserve
# — and every quota assertion above passed for the whole time the fallback was
# unreachable in the arrangement below. These four rows are the difference.
#
# The classifier used to reach its reserve-authorising class only by matching
# the literal word "week", which is Gemini's vocabulary. Anthropic's individual
# quota says "Resets in 3h27m2s" and never says week, so under AGY_MODEL=claude-*
# every quota failure landed in `unknown`: AGY_FALLBACK=auto could fire only for
# the model the harness was not configured to use.
#
# So the pair below inverts the slots and differs only in the stated horizon.
# Same wording, same vendor, same config — hours holds, days spends the reserve.
inverted_dispatch() { # inverted_dispatch <label> <FAKE_ERROR> <expected-rc> <log>
	FAKE_QUOTA_MODEL='*claude*' FAKE_ERROR="$2" \
	AGY_MODEL=claude-opus-4-6-thinking AGY_FALLBACK_MODEL=gemini-3-pro-high \
	AGY_FALLBACK=auto AGY_SKIP_GATES=1 \
		bash .agy/dispatch 9 >"$4" 2>&1
	want "$1" "$3" $?
}

inverted_dispatch "a Claude primary out of quota for days spends the reserve" along 0 "$TMP/d10.log"
has   "  names the burn"           "RESERVE GROUP BURNED" "$TMP/d10.log"
has   "  and ran on the Gemini reserve" "gemini-3-pro-high" "$TMP/d10.log"
has   "  reading the bucket off the stated reset" "LONG bucket exhausted" "$TMP/d10.log"

inverted_dispatch "the same wording resetting in hours HOLDS" ashort 1 "$TMP/d11.log"
hasnt "  did not burn the reserve" "RESERVE GROUP BURNED" "$TMP/d11.log"
has   "  and says which model is waiting" "claude-opus-4-6-thinking" "$TMP/d11.log"
has   "  quoting the reset it was given" "12422s" "$TMP/d11.log"

# A quota error with no bucket word AND no reset time is still not a guess to
# spend the reserve on — the conservatism survived the rewrite.
inverted_dispatch "a bare 429 still HOLDS under an inverted config" unknown 1 "$TMP/d12.log"
hasnt "  did not burn the reserve" "RESERVE GROUP BURNED" "$TMP/d12.log"
has   "  says it has nothing to classify on" "does not state when it resets" "$TMP/d12.log"

FAKE_ERROR=none AGY_SKIP_GATES=0 bash .agy/dispatch 9 >"$TMP/d8.log" 2>&1
has "gates run as part of a dispatch" "--- gates ---" "$TMP/d8.log"

# The gate runner's exit status reaches the verdict. It is read through a pipe
# so the output can also be measured against the report, and a pipeline reports
# the status of its LAST stage by default — which would be `tee`, always 0.
# A dispatch that cannot see a red gate is worse than one with no gates at all.
cp .agy/gates "$TMP/gates.rc.bak"
printf '#!/usr/bin/env bash\nprintf "boom\\n"\nexit 1\n' > .agy/gates
FAKE_ERROR=none AGY_SKIP_GATES=0 bash .agy/dispatch 9 >"$TMP/d9.log" 2>&1
want "a failing gate fails the dispatch" 1 $?
has  "  the verdict says so" "FAILING" "$TMP/d9.log"
cp "$TMP/gates.rc.bak" .agy/gates

# =========================================================== --effort routing
# The stub above now refuses `--effort` off the Gemini line, the way the real
# binary does, so every reserve-path test in the section above is already a
# detector for this: send the flag to a Claude model and those runs stop dead.
# That is the important half of the fix and it is invisible here — a suite that
# only gained this section would have gained a lot less than it looks.
#
# What this section adds is the reason a failure would be legible. Without it a
# regression reports "the reserve path broke" and a reader goes hunting through
# quota classification; with it, the command line that was actually built is on
# screen next to the model it was built for.
printf '\n=== --effort routing ===============================================\n'

effort_run() { # effort_run <log-name> [env assignments...] — argv-logging dispatch
	local name="$1"; shift
	rm -f "$TMP/$name.argv"
	env AGY_ARGV_LOG="$TMP/$name.argv" FAKE_ERROR=none AGY_SKIP_GATES=1 "$@" \
		bash .agy/dispatch 9 >"$TMP/$name.log" 2>&1
	return 0
}

effort_run eff_gemini
has   "a Gemini model is sent --effort"        "--effort high" "$TMP/eff_gemini.argv"
has   "  and the banner says so"               "effort high"   "$TMP/eff_gemini.log"

# The reserve attempt is the one that was unrunnable everywhere. Both attempts
# append to the same argv log, so the log has to be split by model before it is
# read: an unsplit `hasnt --effort` sees the Gemini attempt that legitimately
# carries the flag and fails against correct code. Split, the pair says
# something the single log cannot — that ONE dispatch routed the flag two
# different ways according to which model each attempt reached.
effort_run eff_reserve AGY_FALLBACK=auto FAKE_ERROR=long
grep -F -- 'claude-opus-4-6-thinking' "$TMP/eff_reserve.argv" > "$TMP/eff_reserve.res.argv"
grep -F -- 'gemini' "$TMP/eff_reserve.argv" > "$TMP/eff_reserve.pri.argv"
has   "the reserve attempt still runs after the fallback" "claude-opus-4-6-thinking" "$TMP/eff_reserve.res.argv"
hasnt "  and carries no --effort"              "--effort" "$TMP/eff_reserve.res.argv"
has   "  while the Gemini attempt before it did" "--effort high" "$TMP/eff_reserve.pri.argv"

effort_run eff_force AGY_FALLBACK=force
has   "a forced reserve start reaches the model" "claude-opus-4-6-thinking" "$TMP/eff_force.argv"
hasnt "  with no --effort"                     "--effort" "$TMP/eff_force.argv"
hasnt "  and a banner that does not claim one" "effort high" "$TMP/eff_force.log"
has   "  saying plainly there is none"         "no --effort" "$TMP/eff_force.log"

# The groups are not fixed to their slots. A repo may make Claude primary and
# keep Gemini as the reserve — that inversion is supported, it is in the field,
# and it is the configuration a slot-keyed fix would silently get backwards.
effort_run eff_inverted \
	AGY_MODEL=claude-opus-4-6-thinking AGY_FALLBACK_MODEL=gemini-3.7-flash-high
has   "an inverted config runs Claude as primary" "claude-opus-4-6-thinking" "$TMP/eff_inverted.argv"
hasnt "  and sends it no --effort"             "--effort" "$TMP/eff_inverted.argv"

# The first attempted fix, pinned as a dead end so it is not attempted twice.
# `.agy/config` writes `: "${AGY_EFFORT:=high}"`, and `:=` fires on null as well
# as unset, so an empty AGY_EFFORT re-supplies the default rather than clearing
# it. No value in that file — and no value in the environment — can suppress the
# flag. That is why the routing is keyed on the model name and nothing else.
effort_run eff_empty AGY_EFFORT=
has   "AGY_EFFORT= cannot suppress the flag (:= fires on null)" \
	"--effort high" "$TMP/eff_empty.argv"

printf '\n=== watchdog (trap 4) ==============================================\n'
# A run that finishes its work and then never emits `result` is indistinguishable
# from a slow one except that the event stream stops growing. Killing it is the
# easy half; the hard half is deciding what a killed run proved. With no result
# event there is no status, no response and no meaningful exit code, so the
# report on disk becomes the only account of the work — which is exactly why it
# has to be THIS run's report. A leftover from an earlier dispatch would sail
# through on a clean fence and green gates, and that is the precise shape of a
# run that did nothing at all.
REPORT_9="$REPO/.agy/work/m1/task-9-report.md"

hang_dispatch() { # hang_dispatch <log> [report-the-stub-should-write]
	rm -f "$REPORT_9"
	FAKE_HANG=30 FAKE_REPORT="${2:-}" FAKE_ERROR=none \
	AGY_IDLE_TIMEOUT=3 AGY_IDLE_POLL=1 AGY_SKIP_GATES=1 \
		bash .agy/dispatch 9 >"$1" 2>&1
}

hang_dispatch "$TMP/w1.log" "$REPORT_9"
want "a hung run is killed, not waited out" 0 $?
has  "  says the watchdog fired"    "WATCHDOG" "$TMP/w1.log"
has  "  labels the verdict"         "WATCHDOG-KILLED" "$TMP/w1.log"
has  "  accepts this run's report"  "written during this run" "$TMP/w1.log"
# The deferred path exists to stop these two from failing a run that was merely
# stopped. If either fires, the kill is being read as a failure of the work.
hasnt "  does not judge the empty response" "empty response" "$TMP/w1.log"
hasnt "  does not judge the exit code"      "agy exited"     "$TMP/w1.log"

hang_dispatch "$TMP/w2.log"
want "a hung run with no report FAILS" 1 $?
has  "  says the report is missing" "no report at" "$TMP/w2.log"

# The dangerous case: evidence that looks complete but belongs to a previous run.
rm -f "$REPORT_9"
mkdir -p "$(dirname "$REPORT_9")"
printf 'a report from some earlier dispatch\n' > "$REPORT_9"
touch -d '2 hours ago' "$REPORT_9" 2>/dev/null || touch -t 200001010000 "$REPORT_9"
FAKE_HANG=30 FAKE_REPORT="" FAKE_ERROR=none \
AGY_IDLE_TIMEOUT=3 AGY_IDLE_POLL=1 AGY_SKIP_GATES=1 \
	bash .agy/dispatch 9 >"$TMP/w3.log" 2>&1
want "a hung run reusing a STALE report FAILS" 1 $?
has  "  names it as a leftover" "predates this run" "$TMP/w3.log"

# A hang must never be read as an exhausted bucket: there is no result event to
# classify, so classifying one would let a hang spend the scarce reserve group.
hasnt "  a hang never burns the reserve" "RESERVE GROUP BURNED" "$TMP/w1.log"

# The livelock. Both caps are armed, and the idle watchdog is given the tighter
# deadline (3s against the cap's 5s) — it still never fires, because the stub
# emits an event every second for as long as it is allowed to live. That is the
# whole point of the test: if the wall cap is removed, this run does not fail,
# it never returns at all.
rm -f "$REPORT_9"
FAKE_LIVELOCK=1 FAKE_REPORT="$REPORT_9" FAKE_ERROR=none \
AGY_MAX_WALL=5 AGY_IDLE_TIMEOUT=3 AGY_IDLE_POLL=1 AGY_SKIP_GATES=1 \
	bash .agy/dispatch 9 >"$TMP/c1.log" 2>&1
want "a livelocked run is capped, not waited out" 0 $?
has  "  says the wall cap fired"        "WALL CAP" "$TMP/c1.log"
has  "  labels the verdict"             "WALL-CAPPED" "$TMP/c1.log"
has  "  still prints the fence"         "fence" "$TMP/c1.log"
# The two kills send a reader to different places, so the verdict must not
# borrow the other's vocabulary: a stream that never went quiet was not idle.
hasnt "  does not blame the idle watchdog" "WATCHDOG-KILLED" "$TMP/c1.log"
# Same reasoning as the hang: no result event means nothing to classify, and
# classifying one would let a livelock spend the scarce reserve group.
hasnt "  a livelock never burns the reserve" "RESERVE GROUP BURNED" "$TMP/c1.log"

rm -f "$REPORT_9"

printf '\n=== the session dies before its result event =======================\n'
# The same missing `result`, arrived at the other way: the stream kept moving,
# so the watchdog never fired, and agy died on its own instead — its own
# --print-timeout, an internal error, a dropped connection. Judging status, the
# empty response and the exit code here grades HOW THE SESSION ENDED as if it
# were the work, and reports PROBLEMS over a landed commit, a clean fence and
# green gates. Which half of the run stopped it is not evidence about the work;
# the absence of a result event is. So the deferral keys on that, not on who
# did the killing.
FAKE_DIE=1 FAKE_REPORT="$REPORT_9" AGY_SKIP_GATES=1 \
	bash .agy/dispatch 9 >"$TMP/x1.log" 2>&1
want "work that landed before the session died is not a failure" 0 $?
has   "  names the death in the verdict"    "SESSION DIED"  "$TMP/x1.log"
hasnt "  does not read it as PROBLEMS"      "PROBLEMS"      "$TMP/x1.log"
hasnt "  does not judge the empty response" "empty response" "$TMP/x1.log"
hasnt "  does not judge the exit code"      "agy exited"     "$TMP/x1.log"
has   "  accepts this run's report" "written during this run" "$TMP/x1.log"
# A stream cut off mid-flight is a floor, not a total. Presented as a summary it
# reads as proof the run never wrote anything — beside a commit that is on disk.
has   "  calls the tool tally a floor" "floor" "$TMP/x1.log"

# Nothing else is relaxed: with no result event the report is the only account
# of the run, so it still has to exist and still has to be this run's.
rm -f "$REPORT_9"
FAKE_DIE=1 FAKE_REPORT="" AGY_SKIP_GATES=1 \
	bash .agy/dispatch 9 >"$TMP/x2.log" 2>&1
want "a died session with no report FAILS" 1 $?
has  "  says the report is missing" "no report at" "$TMP/x2.log"

rm -f "$REPORT_9"

printf '\n=== interrupted mid-flight =========================================\n'
# Ctrl-C, a closed terminal, a killed parent. Every other stopped-run case here
# ends with the script still in control; this one does not, and it used to exit
# silently — no verdict, no fence check, no gates — after the model had already
# committed. On disk that is indistinguishable from a dispatch that never ran,
# except HEAD moved, which is the one fact nobody was told.
#
# The watchdog is disarmed on purpose (both caps 0) so the script is parked in
# `wait` when the signal lands: this measures the trap, not the watchdog.
rm -f "$REPORT_9"
INT_WAS="$(git rev-parse HEAD)"
FAKE_HANG=30 FAKE_TOUCH="src/interrupted.txt" FAKE_COMMIT=1 FAKE_REPORT="$REPORT_9" \
FAKE_ERROR=none AGY_IDLE_TIMEOUT=0 AGY_MAX_WALL=0 AGY_SKIP_GATES=1 \
	bash .agy/dispatch 9 >"$TMP/i1.log" 2>&1 &
int_pid=$!
# Signal only once the tree has actually moved — before that the run has nothing
# to under-report and the test would pass on a script that still exits silently.
int_n=0
while [ "$int_n" -lt 60 ]; do
	[ "$(git rev-parse HEAD)" != "$INT_WAS" ] && break
	int_n=$(( int_n + 1 )); sleep 0.25
done
kill -TERM "$int_pid" 2>/dev/null
wait "$int_pid"
want "an interrupted run exits on the signal, not on its own" 143 $?
has  "  names the signal"            "INTERRUPTED by SIGTERM" "$TMP/i1.log"
has  "  says the run did not finish" "did not finish"         "$TMP/i1.log"
has  "  reports the commit it left"  "THE TREE MOVED"         "$TMP/i1.log"
has  "  gives the range to read"     "$INT_WAS.."            "$TMP/i1.log"
# The whole point: an unfinished run must not borrow the vocabulary of a
# finished one. Neither check ran, so neither may report a result.
has   "  fence is unjudged, not clean" "fence   NOT CHECKED"  "$TMP/i1.log"
has   "  gates are unrun, not green"   "gates   NEVER RAN"    "$TMP/i1.log"
hasnt "  never claims a clean fence"   "fence   clean"        "$TMP/i1.log"
hasnt "  never claims green gates"     "gates   green"        "$TMP/i1.log"
# agy is a background child; a signal sent to the script alone never reaches it,
# and it would go on writing to the log after the verdict said the run stopped.
int_child="$(sed -n 's/.*INTERRUPT stopping agy (pid \([0-9][0-9]*\)).*/\1/p' \
	"$TMP/i1.log" | head -1)"
if [ -n "$int_child" ] && ! kill -0 "$int_child" 2>/dev/null; then
	ok "  the model process is stopped too"
else
	bad "  the model process is stopped too" \
		"child pid '${int_child:-<never named>}' still alive after the trap"
fi

# The other branch, and the other signal: Ctrl-C on a run that had not landed
# anything yet. Reporting movement that did not happen sends the reader to hunt
# a diff that is not there, which costs as much trust as missing one that did.
#
# This one cannot be driven with `&` like the SIGTERM case above. A shell
# without job control starts background jobs with SIGINT set to SIG_IGN, and an
# inherited ignore cannot be re-trapped — the dispatch would run to completion
# and the test would pass on any script at all. So dispatch runs in the
# FOREGROUND here, exactly as it does under a real Ctrl-C, and a background
# helper does the signalling. The wrapper `exec`s, so the pid it recorded is
# dispatch's own.
rm -f "$REPORT_9" "$TMP/i2.pid"
(
	int_n=0
	while [ "$int_n" -lt 80 ]; do
		# The stub writes its report and only then sleeps, so the report
		# appearing means agy is up and dispatch is parked in `wait`.
		[ -s "$TMP/i2.pid" ] && [ -f "$REPORT_9" ] && break
		int_n=$(( int_n + 1 )); sleep 0.25
	done
	kill -INT "$(cat "$TMP/i2.pid" 2>/dev/null)" 2>/dev/null
) &
int_killer=$!
FAKE_HANG=30 FAKE_REPORT="$REPORT_9" FAKE_ERROR=none \
AGY_IDLE_TIMEOUT=0 AGY_MAX_WALL=0 AGY_SKIP_GATES=1 \
	bash -c 'echo $$ > "$1"; exec bash .agy/dispatch 9' _ "$TMP/i2.pid" \
	>"$TMP/i2.log" 2>&1
want "SIGINT is trapped the same way" 130 $?
wait "$int_killer" 2>/dev/null
has   "  names the signal"          "INTERRUPTED by SIGINT" "$TMP/i2.log"
hasnt "  does not invent a commit"  "THE TREE MOVED"        "$TMP/i2.log"
has   "  still says what landed"    "no commit"             "$TMP/i2.log"

rm -f "$REPORT_9"

printf '\n=== bypass =========================================================\n'
# A denial on its own is an incomplete run. A denial followed by the same
# command under another name is a different thing entirely: the boundary held,
# the implementer walked around it, and the work happened somewhere you did not
# authorise. The run report will describe that work as done — correctly — which
# is why the pairing has to be named. `cmd /c npm install` is not another
# command; it is `npm install` wearing a wrapper the literal-string deny rule
# cannot see (agy failure 5).
FAKE_BYPASS=1 FAKE_ERROR=none AGY_SKIP_GATES=1 \
	bash .agy/dispatch 9 >"$TMP/b1.log" 2>&1
want "a denied-then-renamed command FAILS" 1 $?
has  "  names it a bypass"        "BYPASS" "$TMP/b1.log"
has  "  shows the denied form"    "npm install" "$TMP/b1.log"
has  "  shows the form that ran"  "cmd /c npm install" "$TMP/b1.log"

printf '\n=== report vs gates ================================================\n'
# The report is the implementer's own account of its work. The gates are a
# measurement. Where the two name the same quantity, the measurement wins — a
# report claiming more assertions than the suite contains is the signature of
# work that was described rather than done.
cp .agy/gates "$TMP/gates.claims.bak"
printf '#!/usr/bin/env bash\nprintf "64 assertions passed\\n"\nexit 0\n' > .agy/gates

FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT='Done. All 719 assertions pass.' \
	AGY_SKIP_GATES=0 bash .agy/dispatch 9 >"$TMP/b2.log" 2>&1
has "a report number the gates contradict is flagged" "CLAIM" "$TMP/b2.log"
has "  quotes the report's number" "719" "$TMP/b2.log"
has "  quotes the gate's number"   "64"  "$TMP/b2.log"

FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT='Done. All 64 assertions pass.' \
	AGY_SKIP_GATES=0 bash .agy/dispatch 9 >"$TMP/b3.log" 2>&1
hasnt "a report number the gates confirm is not flagged" "CLAIM" "$TMP/b3.log"

# The gates cannot contradict a quantity they never measured. Inventing a
# disagreement out of unrelated numbers would train the controller to ignore
# the check, which is worse than not having it.
FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT='Took 12 minutes across 3 commits.' \
	AGY_SKIP_GATES=0 bash .agy/dispatch 9 >"$TMP/b4.log" 2>&1
hasnt "an unmeasured quantity is not flagged" "CLAIM" "$TMP/b4.log"

# Failure counts are the number this check exists to catch a lie about, and
# they were never compared. `singular()` stripped /e?s$/, so `failures` became
# `failur` and fell out of UNITS on both sides at once — the report's count and
# the gates' count were both discarded, and the run reported that nothing
# contradicted. Five of eleven units were unreachable in the plural this way.
# The three cases above all say `assertions`, the one plural that regex
# happened to survive, which is why they passed throughout.
printf '#!/usr/bin/env bash\nprintf "OK (76 tests, 2 failures)\\n"\nexit 0\n' > .agy/gates
FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT='Done. 76 tests, 0 failures.' \
	AGY_SKIP_GATES=0 bash .agy/dispatch 9 >"$TMP/b5.log" 2>&1
has "a failure count the gates contradict is flagged" "CLAIM" "$TMP/b5.log"
has "  quotes the report's count" "says 0 failure" "$TMP/b5.log"
has "  quotes the gate's count"   "reported 2"     "$TMP/b5.log"

# The mirror image, and the one that actually fired in the field: a report that
# labels its scope is accurate, not lying. Every number used to be tested for
# membership in the whole gate set, so a correctly labelled partial run could
# never pass — it was reconciled by hand on four consecutive tasks. A unit the
# report gives more than one number for is naming more than one scope, and the
# gate log does not say which one it measured.
printf '#!/usr/bin/env bash\nprintf "OK (76 tests)\\nSlow: 21 tests\\n"\nexit 0\n' > .agy/gates
FAKE_ERROR=none FAKE_REPORT="$REPORT_9" \
	FAKE_REPORT_TEXT='Ran 19 tests (--filter Gateway). Full unit suite: 76 tests.' \
	AGY_SKIP_GATES=0 bash .agy/dispatch 9 >"$TMP/b6.log" 2>&1
hasnt "a scoped count beside the full count is not flagged" "CLAIM" "$TMP/b6.log"

cp "$TMP/gates.claims.bak" .agy/gates
rm -f "$REPORT_9"

printf '\n=== report contract ================================================\n'
# The contract requires an `## Observations` section and nothing enforced it, so
# a report could simply omit it. An absent section is ambiguous in the worst
# direction: it reads identically whether there was nothing to observe or the
# implementer never looked. This is a deterministic check, so it is a gate.
FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT='Done. Everything green.' \
	AGY_SKIP_GATES=1 bash .agy/dispatch 9 >"$TMP/s1.log" 2>&1
want "a report missing a required section FAILS" 1 $?
has  "  names the section" "## Observations" "$TMP/s1.log"

FAKE_ERROR=none FAKE_REPORT="$REPORT_9" \
	FAKE_REPORT_TEXT='Done.

## Observations
None.' \
	AGY_SKIP_GATES=1 bash .agy/dispatch 9 >"$TMP/s2.log" 2>&1
want "a report carrying it passes" 0 $?
rm -f "$REPORT_9"

# --file used to set REPORT="", and both this check and the claims comparison
# are gated on having a fresh report. So every fix round — which is exactly how
# a correction is sent, `--continue --file task-9-fix1.md` — ran with both
# checks off, and nothing in the output said so. The dispatches most likely to
# be cutting corners were the only unchecked ones. The label already carries
# the task number, so the report path is recoverable from it.
printf 'Fix the thing.\n' > "$TMP/task-9-fix1.md"
FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT='Done. Everything green.' \
	AGY_SKIP_GATES=1 bash .agy/dispatch --file "$TMP/task-9-fix1.md" >"$TMP/s3.log" 2>&1
want "a --file correction still enforces the contract" 1 $?
has  "  names the section" "## Observations" "$TMP/s3.log"

# A prompt file not named after a task has no report to check, and must not
# invent one — the checks stay off rather than failing on a file that is not
# there.
printf 'Do a thing.\n' > "$TMP/scratch-note.md"
FAKE_ERROR=none AGY_SKIP_GATES=1 \
	bash .agy/dispatch --file "$TMP/scratch-note.md" >"$TMP/s4.log" 2>&1
want "a --file prompt with no task number still runs" 0 $?
hasnt "  and claims no report contract" "report contract" "$TMP/s4.log"
rm -f "$REPORT_9"

printf '\n=== what landed ====================================================\n'
# `run clean` describes the session, not its output. A run that wrote no code at
# all produces the same four lines as one that implemented the task — clean run,
# clean fence, green gates — and the verdict is the line a controller reads
# first. The tree is what separates them, so the verdict has to name it.
REPORT_OK='Done.

## Observations
None.'

landing() { # landing <log> [FAKE_TOUCH] [FAKE_COMMIT] [FAKE_COAUTHOR]
	rm -f "$REPORT_9"
	FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT="$REPORT_OK" \
	FAKE_TOUCH="${2:-}" FAKE_COMMIT="${3:-}" FAKE_COAUTHOR="${4:-}" AGY_SKIP_GATES=1 \
		bash .agy/dispatch 9 >"$1" 2>&1
}

landing "$TMP/l1.log"
want "a run that produced nothing still exits 0" 0 $?
has  "  the verdict says NOTHING landed" "landed  NOTHING" "$TMP/l1.log"
has  "  and says why that matters"       "a report is not the work" "$TMP/l1.log"

# The report is written into the workspace on every run. If the workspace
# counted, every run would look productive — which is the failure restated.
hasnt "  the workspace's own paper trail does not count as work" \
	"uncommitted change(s) outside" "$TMP/l1.log"

landing "$TMP/l2.log" "src/landed.txt"
want "work left uncommitted FAILS the run"  1 $?
has "  and is named as such"                "NOT COMMITTED" "$TMP/l2.log"
has "  counts the changes"                  "1 change(s) outside the workspace" "$TMP/l2.log"
has "  and says what to do about it"        "committing it yourself" "$TMP/l2.log"
rm -f src/landed.txt   # not `git checkout -- .`: the filled context is uncommitted

landing "$TMP/l3.log" "src/committed.txt" 1
has   "a committed run reports the commit" "landed  1 commit(s)" "$TMP/l3.log"
has   "  quotes its subject"               "task work: src/committed.txt" "$TMP/l3.log"
hasnt "  does not claim nothing landed"    "landed  NOTHING" "$TMP/l3.log"

printf '\n=== a tool error the run worked around =============================\n'
# GST-41, from the field. write_to_file is sandboxed to the agent's own brain
# directory and refused .agy/work/m7/task-2-report.md — the one file every
# dispatch is contractually required to produce. The run recovered through
# run_command, wrote 564 accurate lines, and committed. agy had already
# downgraded the status to ERROR, and this harness turned that into exit 1, so
# at the exit code the run was indistinguishable from the quota failure forty
# minutes earlier that committed nothing at all.
#
# That is the GST-40 fault-injection finding restated from the other side: one
# bit cannot carry two questions. There the exit code graded a reserve-burning
# path green because a run that never failed also exits 0; here it graded a
# finished, committed, gate-green run red because one call along the way did.
#
# So the tool error becomes evidence and the artifacts become the verdict. Every
# leg of that conjunction gets its own row below, because a single assertion
# that the happy path exits 0 would pass equally against a dispatch that simply
# stopped judging tool errors — which is the failure this fix could most easily
# become.
# A deterministic green runner for this section. The starter the installer
# generates is a guess about the project's toolchain, and every row below
# turns on the gates being GREEN — a section whose premise rests on a guess
# tests the guess.
cp .agy/gates "$TMP/gates.r41.bak"
printf '#!/usr/bin/env bash\nprintf "all gates green\\n"\nexit 0\n' > .agy/gates

recovered() { # recovered <log> [FAKE_TOUCH] [FAKE_COMMIT] [FAKE_TOOL_ERROR]
	rm -f "$REPORT_9"
	FAKE_TOOL_ERROR="${4:-1}" FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT="$REPORT_OK" \
	FAKE_TOUCH="${2:-}" FAKE_COMMIT="${3:-}" AGY_SKIP_GATES=0 \
		bash .agy/dispatch 9 >"$1" 2>&1
}

recovered "$TMP/r1.log" "src/recovered.txt" 1
want  "a tool error the run worked around does not fail the dispatch" 0 $?
has   "  the verdict has words for it"     "TOOL ERROR(S) the run worked around" "$TMP/r1.log"
has   "  and says what proves it"          "proven by the report, the fence"     "$TMP/r1.log"
has   "  recovery is shown, not asserted"  "--- recovered ---"                   "$TMP/r1.log"
has   "  the error is still on the page"   "write_to_file"                       "$TMP/r1.log"
has   "  and the commit it rests on named" "landed    1 commit(s)"               "$TMP/r1.log"

# The count has to survive into the sidecar: the verdict is for a human and the
# benchmark reads neither the screen nor the exit code.
RCLASS="$(ls -t .agy/work/m1/logs/*.class 2>/dev/null | head -1)"
has "  the sidecar carries the count"      "tool_errors=1" "$RCLASS"
has "  and the hard-fail count beside it"  "hard_fails=0"  "$RCLASS"

# ---- one leg removed per row, and nothing else ------------------------------
recovered "$TMP/r2.log" "src/uncommitted.txt"
want  "the same error with the work UNCOMMITTED still fails" 1 $?
hasnt "  and claims no recovery" "--- recovered ---" "$TMP/r2.log"
rm -f src/uncommitted.txt

recovered "$TMP/r3.log"
want  "the same error with NOTHING landed still fails" 1 $?
hasnt "  and claims no recovery" "--- recovered ---" "$TMP/r3.log"

printf '#!/usr/bin/env bash\nprintf "boom\\n"\nexit 1\n' > .agy/gates
recovered "$TMP/r4.log" "src/redgate.txt" 1
want  "the same error over a RED gate still fails" 1 $?
hasnt "  and claims no recovery" "--- recovered ---" "$TMP/r4.log"
printf '#!/usr/bin/env bash\nprintf "all gates green\\n"\nexit 0\n' > .agy/gates

# The house rule, stated as a test: an absent measurement is never a pass. A
# skipped gate suite is the most inviting way to lose this one, because the
# screen says `gates   not run` and everything else on it is green.
rm -f "$REPORT_9"
FAKE_TOOL_ERROR=1 FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT="$REPORT_OK" \
FAKE_TOUCH="src/skipped.txt" FAKE_COMMIT=1 AGY_SKIP_GATES=1 \
	bash .agy/dispatch 9 >"$TMP/r5.log" 2>&1
want  "UNRUN gates do not authorise recovery" 1 $?
hasnt "  and claims no recovery" "--- recovered ---" "$TMP/r5.log"

# No report at all is the case GST-41 arrived through: if write_to_file had
# refused and the run had NOT worked around it, this is what would be left.
rm -f "$REPORT_9"
FAKE_TOOL_ERROR=1 FAKE_TOUCH="src/noreport.txt" FAKE_COMMIT=1 AGY_SKIP_GATES=0 \
	bash .agy/dispatch 9 >"$TMP/r6.log" 2>&1
want  "a tool error with NO report on disk still fails" 1 $?
hasnt "  and claims no recovery" "--- recovered ---" "$TMP/r6.log"

# Conduct is never recovered from. A blocked call in the same stream means the
# boundary held and something walked into it — the greenest possible tree does
# not answer that, because the report will describe the work as done, accurately.
recovered "$TMP/r7.log" "src/conduct.txt" 1 denial
want  "a BLOCKED call in the same stream is never recovered from" 1 $?
hasnt "  and claims no recovery"  "--- recovered ---" "$TMP/r7.log"
has   "  it is named as a block"  "BLOCKED despite"   "$TMP/r7.log"

# GST-42, and the reason it had to be fixed in the same breath as GST-41.
# Antigravity auto-denied a write_to_file into its OWN scratch directory under
# --dangerously-skip-permissions, and said only `Matches user-configured deny
# rule` — a sentence carrying none of the words the classifier was looking for.
# Filed as a tool error, that denial would have walked straight through the
# recovery above on an otherwise perfect run. The verbatim field wording is the
# fixture, because a paraphrase would test the paraphrase.
recovered "$TMP/r9.log" "src/denyrule.txt" 1 denyrule
want  "a deny-rule refusal is conduct, not a path error" 1 $?
hasnt "  and claims no recovery"       "--- recovered ---" "$TMP/r9.log"
has   "  it is named as a block"       "BLOCKED despite"   "$TMP/r9.log"
has   "  quoting the wording verbatim" "user-configured deny rule" "$TMP/r9.log"

# And the other direction: a non-SUCCESS status with NO tool error in the stream
# has nothing to attribute itself to and stays a hard failure. Every quota row
# in the dispatch section above is that assertion; this one says it in one line
# against the same fixture family, so a future relaxation of `status` alone has
# to walk past it.
rm -f "$REPORT_9"
FAKE_ERROR=unknown FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT="$REPORT_OK" \
FAKE_TOUCH="src/statusonly.txt" FAKE_COMMIT=1 AGY_FALLBACK=off AGY_SKIP_GATES=0 \
	bash .agy/dispatch 9 >"$TMP/r8.log" 2>&1
want  "a bare non-SUCCESS status with no tool error still fails" 1 $?
hasnt "  and claims no recovery" "--- recovered ---" "$TMP/r8.log"

# And the mechanism that row rests on, pinned rather than reasoned about. The
# recovery conjunction also requires tool_errors > 0, and fault injection could
# not witness that leg: removing it changed nothing, because with no tool error
# in the stream node has nothing to attribute a bad status to and hard-fails
# instead — which the hard_fails leg already catches. The leg stays (it is the
# cheap half of a defence that spans two languages), and these two rows state
# the invariant it leans on, so a future softening of node's `fail` here turns
# something red instead of quietly making the leg the only thing left.
SCLASS="$(ls -t .agy/work/m1/logs/*.class 2>/dev/null | head -1)"
has "  no tool error is recorded for it"     "tool_errors=0" "$SCLASS"
hasnt "  and it is not counted as a soft one"  "hard_fails=0"  "$SCLASS"

rm -f "$REPORT_9"
cp "$TMP/gates.r41.bak" .agy/gates

printf '\n=== what landed (continued) ========================================\n'
# agy reports `1 turns` on runs carrying two dozen recorded tool calls. On one
# line with the durations it reads as a one-shot answer; the count that means
# something is the one measured off the stream.
has "the turn count is labelled agy's own" "agy's own count" "$TMP/l3.log"
has "the tool line totals the calls"       "call(s) —"       "$TMP/l3.log"
hasnt "the duration line no longer carries turns" "thread-elapsed / " "$TMP/l3.log"

rm -f "$REPORT_9"

printf '\n=== attribution ====================================================\n'
# Every behavioural rule in dispatch-context.md used to be enforced by the model
# choosing to comply. This is the one that had a victim: the template asked for a
# `Co-Authored-By:` line without saying what to put in it, implementers supplied
# antigravity@google.com, and GitHub — which resolves co-author trailers to
# accounts BY EMAIL — put a real stranger on the contributor graph. Telling the
# model harder is not the lever; the instruction was already there.

GOOD_CA="Antigravity <antigravity@antigravity.invalid>"

has "the installer writes the trailer into the config" \
	"antigravity@antigravity.invalid" .agy/config
has "  and into the context the model reads" \
	"antigravity@antigravity.invalid" .agy/work/m1/dispatch-context.md
# One source, two renderings. If these could drift, the model would be obeying a
# different rule from the one the harness checks, which is the whole failure.
hasnt "  and leaves no unfilled marker behind" \
	"{{COAUTHOR}}" .agy/work/m1/dispatch-context.md

# The shipped default must credit nobody. This installer runs in other people's
# repositories, so an address baked in here lands on the contributor graph of
# every repo a stranger installs it into — which is the original bug with the
# roles swapped. A maintainer wanting their own address sets it per install;
# they do not change what everyone else gets.
has "the shipped default is an address nobody can own" \
	'COAUTHOR="Antigravity <antigravity@antigravity.invalid>"' "$SKILL_DIR/scripts/install"
# Pinned on the assignment line, not on the file. Asserting the config never
# *mentions* a live address would be the wrong test and it fails: the config
# names antigravity@google.com on purpose, in the paragraph explaining what is
# never right. A rule that cannot cite the case that produced it is a weaker
# rule. What must not drift is the value the check reads.
has "  and that is what the config assigns" \
	': "${AGY_COAUTHOR=Antigravity <antigravity@antigravity.invalid>}"' .agy/config
# The config explains both defensible answers, because "must never resolve" is
# not one of them — a project crediting its own mailbox is making a true claim.
# Stating only one answer is what makes the other look like a bug to fix.
has "  the config gives the rule, not just the value" \
	"BY EMAIL" .agy/config
has "  and warns off the noreply form, which resolves too" \
	"users.noreply.github.com" .agy/config

landing "$TMP/ca1.log" "src/ca1.txt" 1 "$GOOD_CA"
want "the configured co-author passes"     0 $?
hasnt "  and says nothing about it"        "WRONG CO-AUTHOR" "$TMP/ca1.log"

# A missing trailer is not a wrong one. The controller commits in this range
# too, amends drop trailers, and merges never carry them — so "should there
# have been a trailer" is a judgement, while "is this address the configured
# one" is not. Only the second is deterministic, so only the second fails.
landing "$TMP/ca0.log" "src/ca0.txt" 1
want "a commit with no trailer at all is left alone" 0 $?
hasnt "  and is not reported as wrong"     "WRONG CO-AUTHOR" "$TMP/ca0.log"

# The display name is cosmetic — GitHub matches on the address alone, so two
# trailers differing only in the name are the same claim and must not disagree
# here. Case too: addresses are not case-sensitive on the part that matters.
landing "$TMP/ca2.log" "src/ca2.txt" 1 "Some Other Name <ANTIGRAVITY@Antigravity.INVALID>"
want "a different display name is still the same co-author" 0 $?
hasnt "  no complaint"                     "WRONG CO-AUTHOR" "$TMP/ca2.log"

landing "$TMP/ca3.log" "src/ca3.txt" 1 "Antigravity <antigravity@google.com>"
want "the address that caused this FAILS the run" 1 $?
has  "  the verdict block names it"        "trailer WRONG CO-AUTHOR" "$TMP/ca3.log"
has  "  quotes the offending address"      "antigravity@google.com"  "$TMP/ca3.log"
has  "  and the one it expected"           "Expected: $GOOD_CA"      "$TMP/ca3.log"
has  "  gives the remedy, not a lecture"   'git commit --amend --trailer' "$TMP/ca3.log"
has  "  says why an address is not cosmetic" "BY EMAIL"              "$TMP/ca3.log"
# The verdict block and the exit code have to agree. The run, the fence and the
# gates were all fine here — the trailer is the only thing that failed, so it
# has to appear in the block a controller reads, not only in a section above it.
has  "  and detail above the block"        "--- attribution"         "$TMP/ca3.log"

# Opt out by emptying the value, not by widening it — a check that matches
# anything is the state this whole section exists to leave behind. This is also
# what pins the config to `:=`'s cousin: with `${AGY_COAUTHOR:=...}` an empty
# value is indistinguishable from an unset one, the default comes straight back,
# and this test fails.
rm -f "$REPORT_9"
AGY_COAUTHOR="" FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT="$REPORT_OK" \
FAKE_TOUCH="src/ca4.txt" FAKE_COMMIT=1 FAKE_COAUTHOR="Antigravity <antigravity@google.com>" \
AGY_SKIP_GATES=1 bash .agy/dispatch 9 >"$TMP/ca4.log" 2>&1
want "an empty AGY_COAUTHOR switches the check off" 0 $?
hasnt "  and prints nothing about attribution" "WRONG CO-AUTHOR" "$TMP/ca4.log"

# The check reads git's own trailer parser, not the message text. A commit whose
# body discusses a trailer is prose, and prose is not a claim of authorship —
# without this, the commit that lands this very section would fail its own check,
# and so would every commit that documents the address it replaced.
rm -f "$REPORT_9"
FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT="$REPORT_OK" \
FAKE_TOUCH="src/ca5.txt" FAKE_COMMIT=1 FAKE_COAUTHOR="$GOOD_CA" \
FAKE_BODY="The old default was Co-Authored-By: Antigravity <antigravity@google.com>,
which is a live account. Quoted here, not claimed." \
AGY_SKIP_GATES=1 bash .agy/dispatch 9 >"$TMP/ca5.log" 2>&1
want "an address quoted in a commit body is not a trailer" 0 $?
hasnt "  the prose is not read as a claim" "WRONG CO-AUTHOR" "$TMP/ca5.log"

rm -f "$REPORT_9"

# Per-install override, both ways in. A project that wants its own address must
# be able to have it without editing the skill everyone else installs — and both
# renderings have to move together, or the model is told one rule and judged by
# another.
for how in flag env; do
	CAREPO="$TMP/ca-$how"
	mkdir -p "$CAREPO/src"
	(
		cd "$CAREPO" || exit 1
		git init -q . && git config user.email t@t && git config user.name T
		printf 'x\n' > src/x.txt && git add -A && git commit -qm init
		if [ "$how" = flag ]; then
			bash "$SKILL_DIR/scripts/install" --project CA \
				--coauthor 'Antigravity <agy@example.test>' >/dev/null 2>&1
		else
			AGY_COAUTHOR='Antigravity <agy@example.test>' \
				bash "$SKILL_DIR/scripts/install" --project CA >/dev/null 2>&1
		fi
	) || bad "install --$how sets the co-author" "setup failed"
	has "install by $how puts the chosen address in the config" \
		"agy@example.test" "$CAREPO/.agy/config"
	has "  and the same one in the context" \
		"agy@example.test" "$(echo "$CAREPO"/.agy/work/*/dispatch-context.md)"
	hasnt "  and the shipped default is gone from the context" \
		"antigravity.invalid" "$(echo "$CAREPO"/.agy/work/*/dispatch-context.md)"
done

# The two renderings can be edited apart afterwards — a hand-edited config, a
# context copied in from another project. Then every run fails on a trailer the
# implementer copied faithfully out of the file it was given, and the diagnosis
# points at the implementer, which is the one place the fault is not. Refuse
# before dispatching instead: it is a configuration fault, like the fence whose
# baseline does not pair with its config.
rm -f "$REPORT_9"
AGY_COAUTHOR="Antigravity <someone.else@example.test>" \
FAKE_ERROR=none FAKE_REPORT="$REPORT_9" FAKE_REPORT_TEXT="$REPORT_OK" \
AGY_SKIP_GATES=1 bash .agy/dispatch 9 >"$TMP/ca6.log" 2>&1
want "a config and context that disagree REFUSE to dispatch" 2 $?
has  "  names the address the check wants"  "someone.else@example.test" "$TMP/ca6.log"
has  "  and the file that never mentions it" "dispatch-context.md"      "$TMP/ca6.log"
has  "  says the implementer would be judged on a rule it never got" \
	"judged against a rule it was never given" "$TMP/ca6.log"
has  "  and nothing was dispatched"         "the tree is untouched"     "$TMP/ca6.log"

rm -f "$REPORT_9"

printf '\n=== review package =================================================\n'
# The reviewer's contract lives in protocol.md, which a reviewer subagent may
# never read. The package is the one file it is guaranteed to open, so the three
# verdicts have to be printed into it — brief integrity first, because a
# reviewer asked only "does the diff match the brief" confirms a faithful
# implementation of a wrong rule.
PKG_OUT="$(bash .agy/review-pkg HEAD~1 task-9 2>"$TMP/pkg-err.log")"
want "review-pkg builds a package" 0 $?
PKG="$(printf '%s' "$PKG_OUT" | awk '{print $1}')"
has "  it demands three verdicts"          "Three verdicts are required" "$PKG"
has "  brief integrity is the first"       "1. **Brief integrity**"      "$PKG"
has "  asked as a question about the rules" "actually follow from its stated rules" "$PKG"
has "  and routed to the controller"       "controller to adjudicate"    "$PKG"
has "  the diff is still there"            "## Diff (-U10)"              "$PKG"
has "  and demands a terminator"           "REVIEW-END brief=<ok|findings>" "$PKG"
has "  saying why one is needed"           "never existed"               "$PKG"
# The reviewer never reads protocol.md, so a rule addressed to the reviewer is
# only real if it reaches the package. This is the assertion 1.8.9 shipped
# without and owed.
has "  and to write findings as it finds them" "Write each finding down as you reach it" "$PKG"
has "  because it is the likeliest to be cut off" "most likely to be cut off"  "$PKG"

# GST-43. Reviewers dying of session limits was documented as a rare accident
# and is arithmetic: package plus four documents plus re-execution of every
# pasted proof is most of a session, and a milestone lost three tasks in a row
# to it. The prose fix belongs in protocol.md; this is the half a machine can
# check — the one place the size is known before the reviewer is spent.
printf '%s\n' "$PKG_OUT" > "$TMP/pkg-out.log"
has "  and reports its own size" " lines)" "$TMP/pkg-out.log"
# Round three found this the hard way. A mutation that made the warning fire on
# every package turned nine unrelated rows of this section red, because the
# capture above used to merge stderr into stdout and take the first word — and
# an unbuffered stderr line arrives ahead of a buffered stdout one, so `$PKG`
# became "WARNING:" and every later assertion looked in a file that did not
# exist. The cascade was the fixture's fault rather than the mutation's, but the
# same parse lives in any caller that pipes this command, so the split is now a
# stated contract instead of an accident of how big the fixture happened to be.
want "  and stdout carries the path and nothing else" 1 \
	"$(printf '%s\n' "$PKG_OUT" | wc -l | tr -d ' ')"

AGY_REVIEW_MAX=1 bash .agy/review-pkg HEAD~1 task-9big \
	> "$TMP/pkg-big.out" 2>"$TMP/pkg-big.log"
want "an oversized package warns before a reviewer is spent" 0 $?
has  "  naming the budget it crossed" "over the 1-line review budget" "$TMP/pkg-big.log"
has  "  and what to do instead"       "scoped review"                 "$TMP/pkg-big.log"
# The warning is advice, not a refusal: a controller may have a good reason for
# a large task, and a gate that blocked here would be routed around rather than
# obeyed.
has  "  while still building the package" "review-task-9big.diff"     "$TMP/pkg-big.out"
hasnt "  and the warning stays off stdout" "WARNING"                  "$TMP/pkg-big.out"

AGY_REVIEW_MAX=99999 bash .agy/review-pkg HEAD~1 task-9ok > "$TMP/pkg-ok.log" 2>&1
hasnt "a package inside the budget says nothing" "WARNING" "$TMP/pkg-ok.log"

# ============================================== is the review finished?
printf '\n=== review completeness ============================================\n'
# The defect: a reviewer killed mid-write leaves a file that reads exactly like
# a review which found nothing. The verdict table is written before the findings
# are, so what survives is a complete table with every row MET and no findings
# section — and the controller's only signal was the presence of a table.
#
# Every assertion here is on the exit code first. The message matters, but a
# check whose text is right and whose status is wrong is one an `if` reads
# backwards, which is exactly how the grep -iF abort took down 1.8.5.
RV="$TMP/reviews"
mkdir -p "$RV"
END='REVIEW-END brief=ok spec=pass quality=approved ac=12/12'

printf '# Review\n\n| AC | verdict |\n|---|---|\n| 1 | MET |\n\n%s\n' "$END" > "$RV/good.md"
bash .agy/review-pkg --check "$RV/good.md" > "$TMP/rv-good.log" 2>&1
want "a finished review passes" 0 $?
has  "  and prints the ledger line" "reviewed: brief=ok spec=pass quality=approved ac=12/12" "$TMP/rv-good.log"

# The whole flaw, reproduced: the table is complete and the file stops there.
printf '# Review\n\n| AC | verdict |\n|---|---|\n| 1 | MET |\n' > "$RV/trunc.md"
bash .agy/review-pkg --check "$RV/trunc.md" > "$TMP/rv-trunc.log" 2>&1
want "a truncated review fails" 1 $?
has  "  and is called unfinished, not failed" "is UNFINISHED"        "$TMP/rv-trunc.log"
has  "  with the reason it looks complete"    "before the findings"  "$TMP/rv-trunc.log"
has  "  and what to do about it"              "fresh"                "$TMP/rv-trunc.log"

# A terminator that is not terminal is not a terminator: a reviewer that wrote
# the line and kept going has not finished either, and this is the case a plain
# `grep REVIEW-END` would wave through.
printf '# Review\n\n%s\n\nOne more thought.\n' "$END" > "$RV/notlast.md"
bash .agy/review-pkg --check "$RV/notlast.md" >/dev/null 2>&1
want "the terminator must be the last line" 1 $?

# Trailing blank lines are not content — an editor that adds one must not turn
# a finished review into an unfinished one.
printf '# Review\n\n%s\n\n\n' "$END" > "$RV/blanks.md"
bash .agy/review-pkg --check "$RV/blanks.md" >/dev/null 2>&1
want "trailing blank lines do not unfinish it" 0 $?

# CR is in [:space:], which is the only reason a review written on Windows
# passes at all. Asserted because it is invisible and one `tr` away from broken.
printf '# Review\r\n\r\n%s\r\n' "$END" > "$RV/crlf.md"
bash .agy/review-pkg --check "$RV/crlf.md" >/dev/null 2>&1
want "a CRLF review still passes" 0 $?

printf '# Review\n\nREVIEW-END spec=pass quality=approved ac=12/12\n' > "$RV/nobrief.md"
bash .agy/review-pkg --check "$RV/nobrief.md" > "$TMP/rv-nobrief.log" 2>&1
want "a missing verdict fails" 1 $?
# The needle is the whole phrase, not "brief". `brief` on its own also occurs
# in the SUCCESS line (`reviewed: brief= spec=pass …`), so the short version
# passed whether or not the failure message was ever printed — a vacuous
# assertion, and it survived the mutation that should have killed it. Found by
# predicting the red set before running rather than by counting failures.
has  "  and names which one"  "Unreadable or missing: brief" "$TMP/rv-nobrief.log"
has  "  and shows the shape"  "quality=<approved|changes>" "$TMP/rv-nobrief.log"

# The template pasted verbatim. A reviewer that copied the line without
# answering it has reported nothing, and the placeholders are how you tell.
printf '# Review\n\nREVIEW-END brief=<ok|findings> spec=<pass|fail> quality=<approved|changes> ac=<met>/<total>\n' > "$RV/tmpl.md"
bash .agy/review-pkg --check "$RV/tmpl.md" >/dev/null 2>&1
want "the unanswered template fails" 1 $?

# Not judgement — arithmetic. Spec compliance cannot pass while criteria the
# brief issued went unmet, because there is no third verdict for a criterion:
# it is MET or it is NOT MET with a reason.
printf '# Review\n\nREVIEW-END brief=ok spec=pass quality=approved ac=8/12\n' > "$RV/contra.md"
bash .agy/review-pkg --check "$RV/contra.md" > "$TMP/rv-contra.log" 2>&1
want "a pass with unmet criteria fails" 1 $?
has  "  naming the contradiction" "cannot both be true" "$TMP/rv-contra.log"

printf '# Review\n\nREVIEW-END brief=ok spec=fail quality=changes ac=8/12\n' > "$RV/fewer.md"
bash .agy/review-pkg --check "$RV/fewer.md" >/dev/null 2>&1
want "  but a fail with unmet criteria is fine" 0 $?

printf '# Review\n\nREVIEW-END brief=ok spec=fail quality=changes ac=13/12\n' > "$RV/over.md"
bash .agy/review-pkg --check "$RV/over.md" >/dev/null 2>&1
want "more met than issued fails" 1 $?

# The dropped row, made visible. The controller knows the count; the review
# reconciles against it. Twelve criteria issued, eight reported, and among the
# four that quietly went was the one marked non-negotiable.
bash .agy/review-pkg --check "$RV/good.md" --ac 12 >/dev/null 2>&1
want "the criteria count can be reconciled" 0 $?
printf '# Review\n\nREVIEW-END brief=ok spec=pass quality=approved ac=8/8\n' > "$RV/lost.md"
bash .agy/review-pkg --check "$RV/lost.md" --ac 12 > "$TMP/rv-lost.log" 2>&1
want "  and a table that lost rows fails" 1 $?
has  "  saying rows went missing" "Rows went missing" "$TMP/rv-lost.log"

# Absent is not zero. A reviewer that wrote no file at all must not be quieter
# than one that wrote a bad one.
bash .agy/review-pkg --check "$RV/never-written.md" > "$TMP/rv-none.log" 2>&1
want "an absent review is its own exit code" 2 $?
has  "  and is not read as a pass" "not a pass" "$TMP/rv-none.log"
: > "$RV/empty.md"
bash .agy/review-pkg --check "$RV/empty.md" >/dev/null 2>&1
want "an empty review is treated as absent" 2 $?

bash .agy/review-pkg --check >/dev/null 2>&1
want "--check with no file is a usage error" 64 $?
bash .agy/review-pkg --check "$RV/good.md" --ac twelve >/dev/null 2>&1
want "--ac takes a number" 64 $?

printf '\n=== idempotency ====================================================\n'
printf '\n# EDITED BY THE USER\n' >> .agy/config
printf '\n# EDITED BY THE USER\n' >> .agy/gates
bash "$SKILL_DIR/scripts/install" >/dev/null 2>&1
has "re-install keeps an edited config" "EDITED BY THE USER" .agy/config
has "re-install keeps an edited gate runner" "EDITED BY THE USER" .agy/gates

# ================================================================ version stamp
printf '\n=== version stamp ==================================================\n'
# Nothing in an installed repo used to record which version of the skill wrote
# it, so a repo could not tell it was stale and a field report could not be
# trusted to describe the current asset. Two reports arrived against this
# harness describing behaviour fixed several versions earlier; establishing that
# meant diffing their script against ours by line count, twice. The stamp turns
# that into one line of a run banner.
VER="$(sed -n 's/^version: *//p' "$SKILL_DIR/SKILL.md" | head -1)"
[ -n "$VER" ] && ok "the skill declares a version" \
	|| bad "the skill declares a version" "no version: line in SKILL.md"
has   "the installed dispatch carries it" "AGY_SKILL_VERSION='$VER'" .agy/dispatch
# The marker surviving means the file was copied by hand rather than installed,
# which is the same class of problem one level down.
hasnt "  and not the unsubstituted marker" "{{SKILL_VERSION}}" .agy/dispatch
FAKE_ERROR=none AGY_SKIP_GATES=1 bash .agy/dispatch 9 >"$TMP/ver.log" 2>&1
has   "a run banner names the version it is running" "agy-agents $VER" "$TMP/ver.log"

# The installer's own account of what it just did. "Installed" and "upgraded"
# are different facts and were previously both reported as silence.
VF="$TMP/vstamp"
mkdir -p "$VF/src"
(
	cd "$VF" || exit 1
	git init -q . && git config user.email t@t && git config user.name T
	printf 'x\n' > src/x.txt && git add -A && git commit -qm init
	bash "$SKILL_DIR/scripts/install" --project VF >install1.log 2>&1
) || bad "version fixture installs" "setup failed"
has   "a first install says it is installing" "installing $VER" "$VF/install1.log"

( cd "$VF" && bash "$SKILL_DIR/scripts/install" --project VF >install2.log 2>&1 )
has   "a re-install of the same version says so" "reinstalling $VER" "$VF/install2.log"

sed -i "s/^AGY_SKILL_VERSION='.*'/AGY_SKILL_VERSION='0.0.1'/" "$VF/.agy/dispatch"
( cd "$VF" && bash "$SKILL_DIR/scripts/install" --project VF >install3.log 2>&1 )
has   "an upgrade names both versions" "upgrading 0.0.1 → $VER" "$VF/install3.log"
has   "  and the new stamp replaces the old" "AGY_SKILL_VERSION='$VER'" "$VF/.agy/dispatch"

# A repo installed before stamping existed. It cannot report its version, and
# saying that plainly is the whole point — an unknown version is not a current
# one, the same way an absent measurement is not a zero.
sed -i "/^AGY_SKILL_VERSION=/d" "$VF/.agy/dispatch"
( cd "$VF" && bash "$SKILL_DIR/scripts/install" --project VF >install4.log 2>&1 )
has   "an install over an unstamped copy says it is unstamped" \
	"unstamped" "$VF/install4.log"

# ================================================== config key migration
printf '\n=== config key migration ===========================================\n'
# "A config that exists is kept" is right about the values and wrong about the
# keys. The four scripts ARE refreshed on every install, so a repo installed
# before AGY_COAUTHOR existed got the trailer check and nothing to check
# against — and an unset AGY_COAUTHOR means the check is off. The control
# shipped, arrived, and did nothing, which is the one outcome worse than not
# shipping it. Field reports from such a repo are indistinguishable from an
# open flaw, because the fix is on disk and inert.
MIG="$TMP/migrate"
mkdir -p "$MIG/src"
(
	cd "$MIG" || exit 1
	git init -q . && git config user.email t@t && git config user.name T
	printf 'x\n' > src/x.txt && git add -A && git commit -qm init
	bash "$SKILL_DIR/scripts/install" --project MIG >/dev/null 2>&1
) || bad "migration fixture installs" "setup failed"

# Forge the pre-1.8.4 config: the key and its comment paragraph gone, an edit of
# the user's left behind to prove the append never touches what is above it.
sed -i '/^# ---* attribution/,/^: "${AGY_COAUTHOR/d' "$MIG/.agy/config"
printf '\n# EDITED BY THE USER\n' >> "$MIG/.agy/config"
hasnt "an old config really lacks the key" "AGY_COAUTHOR" "$MIG/.agy/config"
# And an old context has no trailer block either — a repo from before the rule
# existed is missing both halves, which is what makes the next dispatch refuse.
sed -i '/Co-Authored-By:/d' "$MIG/.agy/work/m1/dispatch-context.md"

( cd "$MIG" && bash "$SKILL_DIR/scripts/install" --project MIG >"$TMP/mig1.log" 2>&1 )
has "re-install adds a key the config never carried" \
	'"${AGY_COAUTHOR=' "$MIG/.agy/config"
has "  and says so, because a new key can turn a check on" \
	"AGY_COAUTHOR" "$TMP/mig1.log"
has "  keeps the paragraph that explains it" "BY EMAIL" "$MIG/.agy/config"
has "  and leaves the user's own edits alone" "EDITED BY THE USER" "$MIG/.agy/config"
# Turning the check on makes dispatch refuse until the context names the same
# address. The context here was written before the key existed, so it does not
# — and being told that by the next dispatch, in a repo where nothing about the
# install looked like a rule change, is how a correct refusal reads as a broken
# harness.
has "  warns that the check is now ON" "co-author check is now ON" "$TMP/mig1.log"
has "  and gives the line to paste"    "Co-Authored-By: Antigravity" "$TMP/mig1.log"

# Idempotent, or the second install appends a duplicate binding of everything.
( cd "$MIG" && bash "$SKILL_DIR/scripts/install" --project MIG >/dev/null 2>&1 )
n="$(grep -c '^: "${AGY_COAUTHOR' "$MIG/.agy/config" 2>/dev/null || echo 0)"
[ "$n" = 1 ] && ok "  a second re-install adds nothing" \
	|| bad "  a second re-install adds nothing" "$n bindings of AGY_COAUTHOR"

# An emptied value is a project switching the check off deliberately. Migrating
# it "back" would silently re-enable a control someone turned off — the append
# keys on whether the file NAMES the key, never on whether it has a value.
sed -i 's/^: "${AGY_COAUTHOR=.*/: "${AGY_COAUTHOR=}"/' "$MIG/.agy/config"
( cd "$MIG" && bash "$SKILL_DIR/scripts/install" --project MIG >"$TMP/mig2.log" 2>&1 )
n="$(grep -c '^: "${AGY_COAUTHOR' "$MIG/.agy/config" 2>/dev/null || echo 0)"
[ "$n" = 1 ] && ok "an opt-out survives re-install" \
	|| bad "an opt-out survives re-install" "$n bindings — the opt-out was overwritten"
has "  and is reported as off, not as a value" "check is OFF" "$TMP/mig2.log"

# Install-time precedence. A maintainer with AGY_COAUTHOR exported installing
# into somebody else's repo must not repoint that repo's committed context at
# their own mailbox. The project decided; the export is one machine's habit.
# Their export still wins at runtime, where the drift refusal stops them
# dispatching against a rule the context does not carry.
PREC="$TMP/precedence"
mkdir -p "$PREC/src"
(
	cd "$PREC" || exit 1
	git init -q . && git config user.email t@t && git config user.name T
	printf 'x\n' > src/x.txt && git add -A && git commit -qm init
	bash "$SKILL_DIR/scripts/install" --project PREC \
		--coauthor 'Antigravity <theirs@example.test>' >/dev/null 2>&1
	AGY_COAUTHOR='Antigravity <mine@example.test>' \
		bash "$SKILL_DIR/scripts/install" --project PREC --milestone m2 \
		>"$TMP/prec.log" 2>&1
) || bad "precedence fixture installs" "setup failed"
has "an existing config outranks the environment" \
	"theirs@example.test" "$PREC/.agy/config"
hasnt "  the export does not reach the config" \
	"mine@example.test" "$PREC/.agy/config"
# The milestone's fresh context is scaffolded by substitution, so it takes
# whatever the installer resolved. Resolve it from the environment and the new
# context names an address the config does not — the exact drift .agy/dispatch
# refuses on, manufactured by the installer itself on a routine advance.
has "  a new milestone's context takes the project's address" \
	"theirs@example.test" "$PREC/.agy/work/m2/dispatch-context.md"
hasnt "  and not the installing machine's" \
	"mine@example.test" "$PREC/.agy/work/m2/dispatch-context.md"
# --force regenerates scaffolding. Who gets credited on a contributor graph is
# not scaffolding, and there is an explicit flag for changing it.
( cd "$PREC" && bash "$SKILL_DIR/scripts/install" --project PREC --force >/dev/null 2>&1 )
has "  --force does not silently repoint the credit" \
	"theirs@example.test" "$PREC/.agy/config"
( cd "$PREC" && bash "$SKILL_DIR/scripts/install" --project PREC \
	--coauthor 'Antigravity <changed@example.test>' >"$TMP/prec2.log" 2>&1 )
has "  --coauthor is what changes it" "changed@example.test" "$PREC/.agy/config"
has "  and says which value moved"    "AGY_COAUTHOR: Antigravity <theirs@example.test> ->" \
	"$TMP/prec2.log"
# Moving one rendering and not the other manufactures the exact drift dispatch
# refuses on. The trailer line came from our own template, so its shape is ours
# to know and safe to rewrite; the rest of that file is the user's prose.
has "  and carries the context with it" \
	"changed@example.test" "$PREC/.agy/work/m2/dispatch-context.md"
hasnt "  leaving no stale address behind" \
	"theirs@example.test" "$PREC/.agy/work/m2/dispatch-context.md"

printf '\n=== adoption =======================================================\n'
# Adopting a repo that already has its own gate runner is the path a real
# migration takes, and it is the one that goes wrong quietly: the generated
# templates told the implementer to run `.agy/gates`, which adoption never
# writes. The dispatch would then be graded against a command that does not
# exist. Every generated file must name the runner that is actually there.
ADOPT="$TMP/adoptee"
mkdir -p "$ADOPT/scripts" "$ADOPT/docs"
(
	cd "$ADOPT" || exit 1
	git init -q . && git config user.email t@t && git config user.name T
	printf '#!/usr/bin/env bash\necho "house gates"\n' > scripts/gates
	chmod +x scripts/gates
	printf 'plan\n' > docs/plan.md
	git add -A && git commit -qm init
	AGY_GUARD_FILES="" bash "$SKILL_DIR/scripts/install" --gates scripts/gates >/dev/null 2>&1
) || bad "adoption install runs" "setup failed"

stale="$(grep -rlF '.agy/gates' "$ADOPT/.agy/config" "$ADOPT/.claude/skills/agy-task-cycle/SKILL.md" \
	"$ADOPT"/.agy/work/*/task-dispatch.template.md "$ADOPT"/.agy/work/*/dispatch-context.md 2>/dev/null | tr '\n' ' ')"
[ -z "$stale" ] \
	&& ok "adoption never names a gate runner it did not write" \
	|| bad "adoption never names a gate runner it did not write" "still says .agy/gates in: $stale"

has "the dispatch template names the adopted runner" "scripts/gates" \
	"$(echo "$ADOPT"/.agy/work/*/task-dispatch.template.md)"
[ -f "$ADOPT/.agy/gates" ] \
	&& bad "adoption does not write a competing runner" "wrote .agy/gates anyway" \
	|| ok "adoption does not write a competing runner"

# ------------------------------------------------- and the documents it reads
# The block above ranges over every file the installer *writes*. It stayed
# green while five places in the skill's own documents told the controller to
# run `.agy/gates` literally — because nothing ranged over what the controller
# *reads*.
#
# `.agy/gates` exists only where the installer generated a starter suite. A
# repo adopted by `--gates`, or by the auto-detect scan, binds AGY_GATES to
# the runner it already had and deliberately writes no competing one, so the
# literal path is a `No such file or directory` on every adopted repo, by
# either route. The form that is correct in all of them resolves the config:
# `( . .agy/config && bash $AGY_GATES )`.
#
# Every surviving mention is pinned below by a distinctive fragment of its own
# line — each one is about the generated file specifically, or names the
# fresh-install case in the same breath. A new mention matches no fragment
# and fails here; a pinned line reworded out from under its fragment fails
# too, and has to be re-justified rather than silently re-admitted. Same
# bargain as the tripwire fingerprints: the churn is the point.
# ============================================================ continue threads
printf '\n=== continue threads ===============================================\n'

# GST-47 (field report, GST Invoice). `agy --continue` resumes the last
# conversation GLOBALLY — the flag is passed through verbatim and there is no
# per-task selector. protocol.md sent fix rounds 1-3 back "in its existing
# thread" on that flag, which holds only when no other dispatch has run since.
# In the field it had not: task 4 ran after task 3, and a task-3 fix brief was
# about to be dropped into a thread that thought it had just finished task 4.
#
# The prose form of this rule already existed and was already read as
# unconditional, so the check is a refusal rather than a sentence.
CT="$TMP/thread"
rm -rf "$CT"; mkdir -p "$CT/src"
(
	cd "$CT" || exit 1
	git init -q . && git config user.email t@t && git config user.name T
	printf 'x\n' > src/x.txt && git add -A && git commit -qm init
	bash "$SKILL_DIR/scripts/install" --project CT >install.log 2>&1
	# Two things this fixture has to get right before any exit code it
	# collects means anything. The installer ships dispatch-context.md
	# unfilled and dispatch refuses on it at exit 2, which this section
	# would read as its own refusal. And the install itself dirties the
	# tree, which dispatch scores as NOT COMMITTED at exit 1. Either one
	# makes every refusal row pass for a reason that has nothing to do
	# with --continue, and makes the one row that must exit 0 unreachable.
	sed -e 's/{{[^}]*}}/filled-in/g' -e '/Delete this quote block/d' 		.agy/work/m1/dispatch-context.md > ctx.filled
	mv ctx.filled .agy/work/m1/dispatch-context.md
	rm -f install.log
	git add -A && git commit -qm installed
) >/dev/null 2>&1 || bad "thread fixture installs" "setup failed"
CTW="$CT/.agy/work/m1"
printf '# task 3\nDo three.\n' > "$CTW/task-3-dispatch.md"
printf '# task 4\nDo four.\n' > "$CTW/task-4-dispatch.md"

# Nothing dispatched yet: --continue cannot name a conversation this harness
# started, and resuming an unknown one is the defect, not a degraded mode.
( cd "$CT" && FAKE_ERROR=none AGY_SKIP_GATES=1 \
	bash .agy/dispatch --continue 3 > "$TMP/ct0.log" 2>&1 )
want "--continue with no recorded thread refuses" 2 $?
has  "  says nothing has been dispatched yet" "no thread recorded" "$TMP/ct0.log"

# Two ordinary dispatches, task 3 then task 4. The second is what makes the
# first one's thread unreachable, and nothing in agy's flag surface says so.
( cd "$CT" && FAKE_ERROR=none AGY_SKIP_GATES=1 \
	bash .agy/dispatch 3 > "$TMP/ct1.log" 2>&1 )
( cd "$CT" && FAKE_ERROR=none AGY_SKIP_GATES=1 \
	bash .agy/dispatch 4 > "$TMP/ct2.log" 2>&1 )
has "the workspace records which thread is live" "task-4" "$CTW/.last-thread"

# The field case exactly: a fix brief for task 3, sent after task 4 ran.
( cd "$CT" && FAKE_ERROR=none AGY_SKIP_GATES=1 \
	bash .agy/dispatch --continue 3 > "$TMP/ct3.log" 2>&1 )
want "--continue after a different task refuses" 2 $?
# Both needles are whole clauses from the refusal, not bare task labels: a
# dispatch for task 3 prints "task-3" all over its own banner, so the bare
# label passes on a binary with no guard in it at all.
has  "  names the task the thread is actually on" "the live thread is task-4" "$TMP/ct3.log"
has  "  and the one being dispatched"             "this brief is for task-3"  "$TMP/ct3.log"
has  "  says why the flag cannot tell them apart" "globally" "$TMP/ct3.log"
has  "  tells the controller to re-brief instead" "re-brief" "$TMP/ct3.log"

# And the other side of it. A guard that refuses every --continue passes every
# row above while breaking the one workflow the flag exists for: fix rounds
# 1-3 back into the thread that is genuinely still live.
( cd "$CT" && FAKE_ERROR=none AGY_SKIP_GATES=1 \
	bash .agy/dispatch --continue 4 > "$TMP/ct4.log" 2>&1 )
want "--continue on the still-live task runs" 0 $?

printf '\n=== documentation ==================================================\n'

GATES_PINS='
SKILL.md|without `--force`
README.md|the verification suite
README.md|exit code is the number of FAILING gates
README.md|&& git commit` works
README.md|on a fresh install
reference/install.md|a starter; make it real
reference/install.md|now points at
reference/protocol.md|exists only when the installer wrote
'
PINNED=0
while IFS='|' read -r pin_file pin_frag; do
	[ -n "$pin_file" ] || continue
	PINNED=$((PINNED+1))
	n_pin="$(grep -F -- '.agy/gates' "$SKILL_DIR/$pin_file" 2>/dev/null \
		| grep -cF -- "$pin_frag")"
	[ "${n_pin:-0}" = "1" ] \
		&& ok "  pinned in $pin_file: $pin_frag" \
		|| bad "  pinned in $pin_file: $pin_frag" \
			"matched ${n_pin:-0} '.agy/gates' line(s), want exactly 1"
done <<PINS
$GATES_PINS
PINS

MENTIONS="$(cd "$SKILL_DIR" && grep -cF -- '.agy/gates' SKILL.md README.md reference/*.md 2>/dev/null \
	| awk -F: '{s+=$2} END {print s+0}')"
[ "$MENTIONS" = "$PINNED" ] \
	&& ok "no unpinned '.agy/gates' anywhere in the skill's own documents" \
	|| bad "no unpinned '.agy/gates' anywhere in the skill's own documents" \
		"$MENTIONS mention line(s) against $PINNED pinned — a new one is a hardcoded path until it earns a pin"

# The pin list alone is satisfied by deleting the recipes outright. These say
# the resolving form is still there to be read, in each document that gives
# the controller a gate command to run.
for doc in SKILL.md README.md reference/dispatch-traps.md reference/protocol.md; do
	has "  $doc resolves the runner through the config" \
		'( . .agy/config && bash $AGY_GATES )' "$SKILL_DIR/$doc"
done

# GST-44/45/46 (field report, GST Invoice). The reviewer-cannot-run section sent
# controllers straight to HELD without saying that a budget-killed reviewer is
# resumable, that its partial review file is already on disk, or whether the
# next task may dispatch while the hold stands. Two of those facts were in this
# document the whole time — under other headings, which is the same as absent to
# a controller reading the one section that names its situation. So these are
# scoped to the section body, not to the file: file-scoped assertions were green
# throughout the defect.
SEC="$TMP/protocol-held.md"
awk '/^### When the reviewer cannot run/{f=1} f&&/^## /{f=0} f' \
	"$SKILL_DIR/reference/protocol.md" > "$SEC"
# The prose rows read a flattened copy. Markdown wraps at 79 columns and the
# wrap points are arbitrary, so a phrase that happens to straddle one is
# invisible to a line-oriented grep — two of these rows were red against the
# fixed document for exactly that reason. That is a false alarm, and a false
# alarm costs more than the assertion is worth. Flattening takes the wrap out
# of the contract and leaves the wording in it.
SECF="$TMP/protocol-held.flat"
tr -d '\r' < "$SEC" | tr '\n' ' ' | tr -s ' ' > "$SECF"
if [ ! -s "$SEC" ]; then
	bad "the reviewer-cannot-run section is findable" "extracted nothing — heading renamed?"
else
	ok "the reviewer-cannot-run section is findable"
	has "  says a killed reviewer is resumable"        "resumed from its own transcript" "$SECF"
	has "  and points where resuming is judged"        "When a run dies mid-task"        "$SECF"
	has "  says the partial review is already on disk" "task-N-review.md"                "$SECF"
	has "  and why it survives the kill"               "each finding as it finds it"     "$SECF"
	has "  answers whether the next task may dispatch" "fence guards surfaces"           "$SECF"
	has "  names the workspace as the safe surface"    "pruned from every guarded"       "$SECF"
	has "  and the ledger as the exception inside it"  "guarded as a *file*"             "$SECF"
fi

# The claims above are only worth asserting if they are true of the fence. These
# two hold the mechanism in place: the workspace is pruned from every guarded
# directory, and the ledger is guarded as a file regardless of living in it.
has "the tripwire prunes the workspace from guarded dirs" \
	'for p in ".git" "$(norm "$AGY_WORKSPACE")"; do' "$SKILL_DIR/assets/tripwire"
has "and the ledger is a guarded file in its own right" \
	'for src in "$AGY_LEDGER" "$AGY_GUARD_FILES"; do' "$SKILL_DIR/assets/tripwire"

# =================================================== bench instrumentation
printf '\n=== bench instrumentation ==========================================\n'

# A normal committing run must leave its measurements on disk, not just on
# screen. Everything downstream reads the .class sidecar; a number that is only
# printed is a number the dashboard has to invent.
#
# This section sits *above* the milestone tests on purpose. Those tests end by
# appending a raw `AGY_WORKSPACE=.agy/work/mX` to .agy/config to exercise the
# COULD NOT REPOINT path — a plain assignment, not the `:=` form, so it wins
# over the environment for every dispatch that runs after it, and mX has no
# task file. Run below them, this section's dispatch dies before writing
# anything, and `ls -t` over an older milestone's logs hands the assertions a
# .class from an unrelated earlier run — one that now carries every key they
# look for. Green, and measuring nothing.
#
# The two guards that keep it honest: a private workspace whose logs directory
# starts empty, so the file read back can only be the one this run wrote; and
# an exit-code check, so a run that never happened cannot be scored on a
# leftover.
BWS=".agy/work/mbench"
rm -rf "${REPO:?}/$BWS"
mkdir -p "$REPO/$BWS/logs"
#
# A private workspace has to be scaffolded like a real one, not merely be a
# directory with a task file in it. Three things gate a dispatch before the
# model is ever launched, and all three are workspace-relative:
#   task-N-dispatch.md   — absent, and there is no task to run
#   dispatch-context.md  — refused when it still carries {{...}}, and refused
#                          just as hard when it is absent
#   progress.md          — $AGY_LEDGER, a guarded file; the fence will not arm
#                          over a guard that points at nothing, so a workspace
#                          without a ledger cannot dispatch at all
#   dispatch-context.md  — refused a third way when it does not carry the
#                          co-author .agy/config wants, which a hand-written
#                          context like this one has to state explicitly. That
#                          is not an inconvenience of the fixture; it is the
#                          drift refusal doing its job on the exact case it
#                          exists for — a context written by something other
#                          than the installer.
printf '# Task 1\nExecute the task.\n' > "$REPO/$BWS/task-1-dispatch.md"
printf '# context\nBuild the thing. Gates are authoritative.\n\nCo-Authored-By: %s\n' \
	"$GOOD_CA" > "$REPO/$BWS/dispatch-context.md"
printf '# ledger\n\n(bench instrumentation run)\n' > "$REPO/$BWS/progress.md"
# AGY_SKIP_GATES=1 for the same reason every other clean-run test here sets it:
# the fixture has no toolchain, so the generated .agy/gates is TODO comments,
# and dispatch calls an ungated run a hard failure rather than a pass. That is
# the behaviour under test elsewhere; here it would only stop the run before it
# could be measured. The keys this section reads are appended after the gate
# step regardless of how the gates went, so skipping them removes a failure
# without removing any of the instrumentation being asserted.
(
	cd "$REPO" || exit 1
	AGY_WORKSPACE="$BWS" AGY_SKIP_GATES=1 \
		FAKE_TOUCH="src/bench1.txt" FAKE_COMMIT=1 FAKE_ERROR=none FAKE_USAGE=1 \
		bash .agy/dispatch 1 > "$TMP/b1.log" 2>&1
)
brc=$?
want "the instrumented run exits clean" 0 "$brc"
# A failed run here is scored on what it did not write, so say why it failed
# rather than leaving seven assertions to report the same silence.
if [ "$brc" -ne 0 ]; then
	sed -n '1,20p' "$TMP/b1.log" 2>/dev/null | sed 's/^/        | /'
	awk '/--- gates/,0' "$TMP/b1.log" 2>/dev/null | sed 's/^/        | /'
fi

# Every assertion below reads $BCLASS. With no file, `basename ""` turns each
# failure into the same truncated sentence about nothing, so the block is
# guarded and the absence is reported once, as itself.
BCLASS="$(ls -t "$REPO/$BWS"/logs/*.class 2>/dev/null | head -1)"
if [ -z "$BCLASS" ]; then
	bad "instrumented run wrote a .class" "none found — the measurement assertions cannot run"
else
	ok "instrumented run wrote a .class"
	hasval "  records wall seconds"      wall         "$BCLASS"
	hasval "  records total tokens"      tokens_total "$BCLASS"
	hasval "  records input tokens"      tokens_in    "$BCLASS"
	hasval "  records output tokens"     tokens_out   "$BCLASS"
	hasval "  records thinking tokens"   tokens_think "$BCLASS"
	# Presence is not enough: a writer that puts the right numbers behind the
	# wrong keys is invisible to four independent non-empty checks. Read all
	# four at once and compare against what the stub actually reported.
	btok="$(class_val "$BCLASS" tokens_in)/$(class_val "$BCLASS" tokens_out)"
	btok="$btok/$(class_val "$BCLASS" tokens_think)/$(class_val "$BCLASS" tokens_total)"
	if [ "$btok" = "13571/24680/17280/38251" ]; then
		ok "  records each count against its own key"
	else
		bad "  records each count against its own key" "in/out/think/total read '$btok'"
	fi
	# The arithmetic, not just the four values. agy reports total = in + out with
	# thinking already inside output; a fixture or a parser that made the total
	# the sum of all three would say thinking is billable on top, which is the
	# one thing the cost model must not believe.
	bti="$(class_val "$BCLASS" tokens_in)"
	bto="$(class_val "$BCLASS" tokens_out)"
	btt="$(class_val "$BCLASS" tokens_think)"
	btl="$(class_val "$BCLASS" tokens_total)"
	if [ "$((bti + bto))" = "$btl" ] && [ "$btt" -le "$bto" ]; then
		ok "  the counts obey the wire: total is in+out, thinking inside output"
	else
		bad "  the counts obey the wire: total is in+out, thinking inside output" \
			"in+out=$((bti + bto)) total=$btl think=$btt out=$bto"
	fi
	# The thread keys. agy reports usage for the THREAD, not the run, so a
	# sidecar that does not say which thread it belongs to and where in it,
	# cannot be reduced to what this run actually spent.
	hasval "  records the thread it belongs to"   conversation      "$BCLASS"
	hasval "  records its position in that thread" thread_turns     "$BCLASS"
	has    "  records what its token counts cover" "tokens_scope=thread" "$BCLASS"
	hasval "  records the cache reads agy reports" tokens_cache_read "$BCLASS"
	has "  records the commit count" "commits=1" "$BCLASS"
	hasval "  records the commit range" range "$BCLASS"
	if grep -qE '^range=[0-9a-f]{40}\.\.[0-9a-f]{40}$' "$BCLASS" 2>/dev/null; then
		ok "  records the range as two resolved heads"
	else
		bad "  records the range as two resolved heads" "range=$(class_val "$BCLASS" range)"
	fi
fi

# The other half of the contract, and it needs its own run: a measurement that
# never arrived must be recorded as absent, not as a zero the harness invented.
# This run reports no usage at all and lands no commit, so the only honest
# sidecar has empty token keys, an empty range, and — because both heads
# resolved and matched — a commits count of exactly 0.
(
	cd "$REPO" || exit 1
	AGY_WORKSPACE="$BWS" AGY_SKIP_GATES=1 FAKE_ERROR=none \
		bash .agy/dispatch 1 > "$TMP/b2.log" 2>&1
)
brc=$?
want "the run that measures nothing still exits clean" 0 "$brc"
if [ "$brc" -ne 0 ]; then sed -n '1,20p' "$TMP/b2.log" 2>/dev/null | sed 's/^/        | /'; fi

BCLASS2="$(ls -t "$REPO/$BWS"/logs/*.class 2>/dev/null | head -1)"
if [ -z "$BCLASS2" ]; then
	bad "the measureless run wrote a .class" "none found"
else
	ok "the measureless run wrote a .class"
	noval "  leaves an unreported token count empty, not 0" tokens_total "$BCLASS2"
	noval "  leaves every token key empty, not 0"           tokens_in    "$BCLASS2"
	# Partial, not absent: the wall clock is ours to measure and it is still
	# there. A run with no usage is not a run with no measurements.
	hasval "  still records the wall clock"                 wall         "$BCLASS2"
	has   "  records a measured zero as 0"     "commits=0" "$BCLASS2"
	noval "  leaves the range empty when nothing landed" range "$BCLASS2"
fi

# And the third state, which is neither. When the run rewrites history the
# pre-run head is no longer an ancestor of HEAD, so nothing can count what
# landed. That is not a zero, and writing it as one would tell every reader
# downstream that a run which may have committed a dozen times committed none.
# The fence refuses the run (exit 4) — a rewritten history is a guarded
# surface — but the sidecar is written before the verdict and has to be honest
# about what it could not see.
(
	cd "$REPO" || exit 1
	AGY_WORKSPACE="$BWS" AGY_SKIP_GATES=1 FAKE_ERROR=none FAKE_REWRITE=1 \
		bash .agy/dispatch 1 > "$TMP/b3.log" 2>&1
)
brc=$?
want "a run that rewrites history is refused by the fence" 4 "$brc"

BCLASS3="$(ls -t "$REPO/$BWS"/logs/*.class 2>/dev/null | head -1)"
if [ -z "$BCLASS3" ]; then
	bad "the history-rewriting run wrote a .class" "none found"
else
	ok "the history-rewriting run wrote a .class"
	noval "  leaves an uncountable commit count empty, not 0" commits "$BCLASS3"
	noval "  leaves the range empty when it cannot be measured" range "$BCLASS3"
fi

# What landed is a property of the RUN, not of an attempt: it is counted once,
# after the fence, over the whole tree. A fallback leaves two sidecars behind
# and both describe the same run, so both carry the same answer. Written against
# the deciding attempt alone, the first attempt's .class has the keys missing
# entirely — a third state, neither a count nor an empty one, that no reader
# downstream is built to expect.
(
	cd "$REPO" || exit 1
	AGY_WORKSPACE="$BWS" AGY_SKIP_GATES=1 FAKE_ERROR=long AGY_FALLBACK=auto \
		bash .agy/dispatch 1 > "$TMP/b4.log" 2>&1
)
brc=$?
want "the fallback run exits clean" 0 "$brc"

BRESERVE="$(ls -t "$REPO/$BWS"/logs/*.reserve.class 2>/dev/null | head -1)"
BFIRST="${BRESERVE%.reserve.class}.class"
if [ -z "$BRESERVE" ] || [ ! -f "$BFIRST" ]; then
	bad "the fallback run wrote both attempts' sidecars" "reserve='${BRESERVE:-<none>}'"
else
	ok "the fallback run wrote both attempts' sidecars"
	has "  the deciding attempt records what landed"  "commits=0" "$BRESERVE"
	has "  the abandoned attempt records it as well"  "commits=0" "$BFIRST"
	noval "  and both agree the range is empty"       range       "$BFIRST"
fi

# read_class takes the FIRST line matching a key, so a value carrying a newline
# does not corrupt its own row — it inserts rows ABOVE the genuine ones and wins.
# `status` is the vector because it comes straight off the agy stream, and the
# keys it can forge are now wall and the token counts, which is everything the
# benchmark reads. The run itself fails (the status is not SUCCESS), which is
# beside the point: the sidecar is written either way.
(
	cd "$REPO" || exit 1
	AGY_WORKSPACE="$BWS" AGY_SKIP_GATES=1 FAKE_INJECT=1 \
		bash .agy/dispatch 1 > "$TMP/b5.log" 2>&1
)
brc=$?
want "a run reporting a forged status is not SUCCESS" 1 "$brc"

BCLASS5="$(ls -t "$REPO/$BWS"/logs/*.class 2>/dev/null | head -1)"
if [ -z "$BCLASS5" ]; then
	bad "the forging run wrote a .class" "none found"
else
	ok "the forging run wrote a .class"
	if [ "$(grep -c '^wall=' "$BCLASS5" 2>/dev/null)" = "1" ]; then
		ok "  one wall= row, not the forged one plus the real one"
	else
		bad "  one wall= row, not the forged one plus the real one" \
			"$(grep -c '^wall=' "$BCLASS5" 2>/dev/null) rows begin with wall="
	fi
	if [ "$(class_val "$BCLASS5" wall)" = "999999" ]; then
		bad "  the wall clock read back is the measured one" "read back the forged 999999"
	else
		ok "  the wall clock read back is the measured one"
	fi
	# The forged text is not deleted — a sanitiser that drops evidence is its own
	# problem. It stays on the row it was written to, flattened onto one line.
	has   "  the forged text stays inside its own value" "status=SUCCESS wall=999999" "$BCLASS5"
	no_cr "  and no carriage return survives into the file" "$BCLASS5"
fi

# ==================================================================== solo arm
printf '\n=== solo arm =======================================================\n'

# The Claude-only baseline. Without it the benchmark has one arm and nothing to
# compare it against.
#
# This section sits above the milestone tests for the same reason the bench
# section does: those end by appending a raw `AGY_WORKSPACE=.agy/work/mX` to
# .agy/config, a plain assignment that beats the environment for everything
# running after it. Below that line these assertions would resolve a workspace
# that has no logs directory, and `ls -t` would hand them a sidecar from an
# unrelated earlier run.
SWS=".agy/work/msolo"
rm -rf "${REPO:?}/$SWS"
mkdir -p "$REPO/$SWS/logs"

# Refusals first: solo runs no model, so its only failure modes are bracket
# bookkeeping, and each one has to be loud in BOTH the output and the status.
( cd "$REPO" && AGY_WORKSPACE="$SWS" bash .agy/solo > "$TMP/s0.log" 2>&1 )
want "solo with no task number refuses" 2 $?
has "  prints a verdict block"          "--- verdict"          "$TMP/s0.log"
has "  names the failure"               "DID NOT RUN"          "$TMP/s0.log"
has "  and the exit code agrees"        "exit    2"            "$TMP/s0.log"

( cd "$REPO" && AGY_WORKSPACE="$SWS" bash .agy/solo --done > "$TMP/s1.log" 2>&1 )
want "solo --done with no open bracket refuses" 2 $?
has "  says why"                        "no open solo bracket" "$TMP/s1.log"

# The happy path: open, do work, close. The closed record must carry both
# endpoints and the git range, or it cannot be compared with an agy run.
( cd "$REPO" && AGY_WORKSPACE="$SWS" bash .agy/solo 4 > "$TMP/s2.log" 2>&1 )
want "solo opens a bracket" 0 $?
has "  confirms the task"               "task-4"               "$TMP/s2.log"

# Overlapping brackets cannot be attributed: the second one's commits are the
# first one's commits, and nothing in either record says so.
( cd "$REPO" && AGY_WORKSPACE="$SWS" bash .agy/solo 5 > "$TMP/s3.log" 2>&1 )
want "solo refuses a second open bracket" 2 $?
has "  says which one is open"          "already open"         "$TMP/s3.log"
has "  and names the task holding it"   "task-4"               "$TMP/s3.log"

(
	cd "$REPO" || exit 1
	mkdir -p src
	printf 'claude did this\n' > src/solo.txt
	git add -A >/dev/null 2>&1
	git commit -qm "solo work" >/dev/null 2>&1
	AGY_WORKSPACE="$SWS" bash .agy/solo --done > "$TMP/s4.log" 2>&1
)
want "solo closes the bracket" 0 $?

SCLASS="$(ls -t "$REPO/$SWS"/logs/solo-*.class 2>/dev/null | head -1)"
if [ -z "$SCLASS" ]; then
	bad "solo wrote a .class" "none found — the measurement assertions cannot run"
else
	ok "solo wrote a .class"
	has    "  marks the arm"                 "arm=solo"    "$SCLASS"
	has    "  names the task"                "task=task-4" "$SCLASS"
	hasval "  records wall seconds"          wall          "$SCLASS"
	has    "  counts the commit"             "commits=1"   "$SCLASS"
	hasval "  records the range"             range         "$SCLASS"
	# One status key, not two. class_val takes the first match, so a close that
	# appends a second status= line leaves a finished bracket reading back as
	# still open to every reader downstream — including the skip rule, which
	# keys on exactly this field to decide whether a run was measured at all.
	sc="$(class_val "$SCLASS" status)"
	if [ "$sc" = "success" ]; then
		ok "  reads back as closed, not open"
	else
		bad "  reads back as closed, not open" "status resolves to '$sc'"
	fi
	nstat="$(grep -c '^status=' "$SCLASS" 2>/dev/null)"
	if [ "$nstat" = "1" ]; then
		ok "  and carries exactly one status key"
	else
		bad "  and carries exactly one status key" "found $nstat"
	fi
	# The same shape the agy arm records, so one reader can parse both.
	if grep -qE '^range=[0-9a-f]{40}\.\.[0-9a-f]{40}$' "$SCLASS" 2>/dev/null; then
		ok "  records the range as two resolved heads"
	else
		bad "  records the range as two resolved heads" "range=$(class_val "$SCLASS" range)"
	fi
fi

( cd "$REPO" && AGY_WORKSPACE="$SWS" bash .agy/solo --done > "$TMP/s5.log" 2>&1 )
want "solo refuses a double close" 2 $?

# Both arms must land in the same place or `bench/collect` reads one of them
# and reports half a comparison as though it were whole. dispatch resolves its
# workspace by sourcing .agy/config and then applying `:=`, so environment
# beats config beats default; solo has to resolve it the same way.
#
# Every assertion above sets AGY_WORKSPACE explicitly, so a solo that ignored
# .agy/config entirely and hardcoded the default would pass all of them — and
# would write to the wrong directory in every repo installed on a milestone,
# which is most of them. This fixture is the only row that can see it: the
# environment is unset, so the config is the sole source of the answer.
SF="$TMP/solocfg"
mkdir -p "$SF/src"
(
	cd "$SF" || exit 1
	git init -q . && git config user.email t@t && git config user.name T
	printf 'x\n' > src/x.txt && git add -A && git commit -qm init
	bash "$SKILL_DIR/scripts/install" --project SF --milestone msolo >install.log 2>&1
) || bad "solo config fixture installs" "setup failed"
scfg="$( cd "$SF" && unset AGY_WORKSPACE && . ./.agy/config >/dev/null 2>&1; printf '%s' "${AGY_WORKSPACE:-}" )"
if [ "$scfg" != ".agy/work/msolo" ]; then
	bad "the config fixture points at its own milestone" "config resolves to '$scfg'"
else
	ok "the config fixture points at its own milestone"
	( cd "$SF" && unset AGY_WORKSPACE && bash .agy/solo 7 > "$SF/s.log" 2>&1 )
	want "  solo opens a bracket with no environment override" 0 $?
	if [ -n "$(ls -t "$SF/$scfg"/logs/solo-*.class 2>/dev/null)" ]; then
		ok "  and writes into the workspace .agy/config names"
	else
		bad "  and writes into the workspace .agy/config names" \
			"nothing under $scfg/logs; .agy/work/logs holds: $(ls "$SF/.agy/work/logs" 2>/dev/null | tr '\n' ' ')"
	fi
fi

# And the other side of the same rule: a repo with no config is not a repo with
# a default config. dispatch refuses; solo, writing into the same workspace on
# the same terms, has to refuse identically rather than inventing one.
SN="$TMP/soloncfg"
mkdir -p "$SN"
(
	cd "$SN" || exit 1
	git init -q . && git config user.email t@t && git config user.name T
	printf 'x\n' > x.txt && git add -A && git commit -qm init
) >/dev/null 2>&1
( cd "$SN" && bash "$REPO/.agy/solo" 1 > "$SN/s.log" 2>&1 )
want "solo in a repo with no .agy/config refuses" 2 $?
has "  and names what is missing" "no .agy/config" "$SN/s.log"

printf '\n=== milestone advance ==============================================\n'
# A project outlives the milestone it was installed on. Passing --milestone used
# to scaffold the new workspace and change nothing else: the adoption scan
# ignored the flag whenever any workspace was already on disk, and a config that
# exists is kept. So .agy/work/m6 appeared, AGY_WORKSPACE still said m5, and the
# only file that named a milestone out loud — the project skill — kept naming
# the one from install day. Everything still ran; it ran on the old milestone.
cd "$REPO" || exit 1
printf '\n# EDITED BY THE USER\n' >> .agy/config
bash "$SKILL_DIR/scripts/install" --milestone m2 >"$TMP/m1.log" 2>&1
want "installing a new milestone exits 0" 0 $?

[ -f .agy/work/m2/progress.md ] \
	&& ok "scaffolds the new workspace" \
	|| bad "scaffolds the new workspace" "no .agy/work/m2/progress.md"

ws="$(unset AGY_WORKSPACE; . ./.agy/config >/dev/null 2>&1; printf '%s' "${AGY_WORKSPACE:-}")"
[ "$ws" = ".agy/work/m2" ] \
	&& ok "repoints AGY_WORKSPACE at it" \
	|| bad "repoints AGY_WORKSPACE at it" "config still resolves to '${ws:-<empty>}'"
has "  says so out loud"           "repoint"            "$TMP/m1.log"
has "  offers the context carry-over" "dispatch-context.md" "$TMP/m1.log"
# The new milestone's context is scaffolded from the template, and a context
# that does not name the co-author is one dispatch refuses to run against. So
# the substitution has to survive every path that writes that file, not only
# first install — otherwise advancing a milestone would brick the project until
# somebody hand-edited a file they were never told about.
has "  the new context still carries the co-author" \
	"antigravity@antigravity.invalid" .agy/work/m2/dispatch-context.md

# The repoint edits one line. If it regenerated the config instead it would take
# the gates, the models and the project environment with it — which is exactly
# why --force was never an acceptable way to advance a milestone.
has "  keeps the rest of an edited config" "EDITED BY THE USER" .agy/config
[ -f .agy/work/m1/progress.md ] \
	&& ok "  leaves the finished milestone on disk" \
	|| bad "  leaves the finished milestone on disk" "m1 was removed"

# With two milestones on disk, a bare re-run must not wander back to the older
# one. The glob would have: m1 sorts first.
bash "$SKILL_DIR/scripts/install" >"$TMP/m2.log" 2>&1
ws="$(unset AGY_WORKSPACE; . ./.agy/config >/dev/null 2>&1; printf '%s' "${AGY_WORKSPACE:-}")"
[ "$ws" = ".agy/work/m2" ] \
	&& ok "a later bare re-install stays on the current milestone" \
	|| bad "a later bare re-install stays on the current milestone" "rebound to '$ws'"

# A repoint that cannot find the line it is meant to rewrite must say so rather
# than report a move it did not make.
printf 'AGY_WORKSPACE=.agy/work/mX\n' >> .agy/config
bash "$SKILL_DIR/scripts/install" --milestone m3 >"$TMP/m3.log" 2>&1
has "an unmatched binding fails loudly" "COULD NOT REPOINT" "$TMP/m3.log"
has "  and counts as a problem" "need attention" "$TMP/m3.log"

# =================================================================== bench: clip
printf '\n=== bench: clip ====================================================\n'
BENCH="$SKILL_DIR/assets/bench"

# Asserted rather than skipped over. A machine without node cannot run the
# readers, and six unexplained module errors is a worse way to learn that than
# one row that says it. Same bargain as the tripwire's PowerShell check: a
# gate that disables itself quietly is worse than one that fails out loud.
command -v node >/dev/null 2>&1 \
	&& ok "node is available to run the bench readers" \
	|| bad "node is available to run the bench readers" \
		"the bench libraries are node; nothing below can run without it"

node -e '
const {clipActive, elapsed, IDLE_GAP_DEFAULT} = require(process.argv[1] + "/lib/clip.js");
const t = n => Date.parse("2026-08-14T10:00:00Z") + n * 1000;
const eq = (got, want, what) => { if (got !== want) throw new Error(what + ": " + got + " != " + want); };
const a = [t(0), t(60), t(120)];
eq(clipActive(a, 600), 120, "contiguous");
const b = [t(0), t(60), t(60 + 8 * 3600), t(60 + 8 * 3600 + 30)];
eq(clipActive(b, 600), 90, "clipped");
eq(elapsed(b), 60 + 8 * 3600 + 30, "elapsed");
eq(clipActive([t(0)], 600), 0, "single stamp");
eq(clipActive([], 600), 0, "empty");
eq(elapsed([t(0)]), 0, "elapsed single");
eq(IDLE_GAP_DEFAULT, 600, "default gap");
eq(clipActive([t(120), t(0), t(60)], 600), 120, "unsorted");
eq(clipActive([t(0), t(600)], 600), 600, "gap exactly at the threshold is active");
eq(clipActive([t(0), t(601)], 600), 0, "one second past the threshold is not");
' "$BENCH" > "$TMP/clip.log" 2>&1
want "clip: contiguous, clipped, elapsed, degenerate, unsorted, boundary" 0 $? "$(head -3 "$TMP/clip.log")"

# A threshold that cannot be used must not behave like a threshold of zero.
# BENCH_IDLE_GAP=10m is Number -> NaN, and `d <= NaN` is false for every gap,
# so a malformed setting clips the entire run and reports 0s active for both
# arms — a number that looks like a result. This is the project's standing rule
# at its sharpest: an absent measurement is never a zero one. The refusal is
# loud at the one point where the mistake is still cheap.
for badgap in NaN 0 -1 undefined '"600"'; do
	node -e '
	const {clipActive} = require(process.argv[1] + "/lib/clip.js");
	const t = Date.parse("2026-08-14T10:00:00Z");
	let threw = false;
	try { clipActive([t, t + 60000], eval(process.argv[2])); } catch (e) { threw = true; }
	if (!threw) throw new Error("accepted an unusable gap: " + process.argv[2]);
	' "$BENCH" "$badgap" > "$TMP/clipgap.log" 2>&1
	want "  clip refuses an unusable idle gap: $badgap" 0 $? "$(head -2 "$TMP/clipgap.log")"
done

# ============================================================ bench: agy reader
printf '\n=== bench: agy reader ==============================================\n'
FIX="$TMP/fixlogs"
rm -rf "$FIX"; mkdir -p "$FIX"

# A fully instrumented run. The thread rows are part of what "fully"
# means now: without tokens_scope the reader cannot tell a turn's own
# usage from a whole thread's running total, and it downgrades the run
# to partial rather than pass an unattributable number off as measured.
# Strip them from this fixture and the row below stops describing a
# current run.
cat > "$FIX/task-7-20260814-100000.class" <<'CLS'
quota=none
tools=24
status=success
killed=0
idle=0
deferred=0
wall=412
tokens_in=1200
tokens_out=800
tokens_think=100
tokens_total=2100
model=gemini-3-pro
commits=1
conversation=conv-read-7
thread_turns=2
tokens_scope=thread
continued=0
range=aaaa..bbbb
raw=
CLS
printf '{"event":"init"}\n' > "$FIX/task-7-20260814-100000.ndjson"

# A run logged before the instrumentation existed. It is a real run and must be
# counted, but its missing numbers must never read as zero.
cat > "$FIX/task-6-20260813-090000.class" <<'CLS'
quota=none
tools=9
status=success
killed=0
idle=0
deferred=0
raw=
CLS
printf '{"event":"init"}\n' > "$FIX/task-6-20260813-090000.ndjson"

# A deferred run: its stream is truncated by definition, and it did real work.
# Skipping it would undercount exactly the longest runs.
cat > "$FIX/task-8-20260814-110000.class" <<'CLS'
quota=none
tools=31
status=
killed=0
idle=1
deferred=1
wall=900
tokens_in=5
tokens_out=5
tokens_think=0
tokens_total=10
model=gemini-3-pro
commits=1
conversation=conv-read-8
thread_turns=
tokens_scope=thread
continued=0
range=cccc..dddd
raw=
CLS
printf '{"event":"init"\n' > "$FIX/task-8-20260814-110000.ndjson"

# A stream whose parser never finished, so no sidecar exists. This is the only
# genuine "not measured" case.
printf '{"event":"init"}\n' > "$FIX/task-9-20260814-120000.ndjson"

node -e '
const {readRuns} = require(process.argv[1] + "/lib/agy.js");
const {runs, skipped} = readRuns(process.argv[2]);
const by = t => runs.find(r => r.task === t);
if (runs.length !== 3) throw new Error("runs: " + runs.length);
const a = by("task-7");
if (a.quality !== "full") throw new Error("task-7 quality " + a.quality);
if (a.wall !== 412 || a.tokens.total !== 2100 || a.tools !== 24) throw new Error("task-7 numbers");
if (a.commits !== 1 || a.range !== "aaaa..bbbb") throw new Error("task-7 git");
if (a.arm !== "agy") throw new Error("task-7 arm");
const b = by("task-6");
if (b.quality !== "partial") throw new Error("task-6 must be partial, got " + b.quality);
if (b.wall !== null || b.tokens.total !== null) throw new Error("task-6 must not read as zero");
const c = by("task-8");
if (!c) throw new Error("deferred run was dropped");
if (c.status !== "deferred") throw new Error("task-8 status " + c.status);
if (skipped.length !== 1) throw new Error("skipped: " + JSON.stringify(skipped));
if (!/task-9/.test(skipped[0].path)) throw new Error("wrong skip");
' "$BENCH" "$FIX" > "$TMP/agyread.log" 2>&1
want "agy reader: full, partial, deferred, skipped" 0 $? "$(head -3 "$TMP/agyread.log")"

# The solo arm goes through the same reader, or the two arms drift apart.
cat > "$FIX/solo-task-4-20260814-130000.class" <<'CLS'
arm=solo
task=task-4
started=1786000000
head=aaaa
status=success
ended=1786001000
wall=1000
commits=1
range=aaaa..eeee
CLS
node -e '
const {readRuns} = require(process.argv[1] + "/lib/agy.js");
const r = readRuns(process.argv[2]).runs.find(x => x.arm === "solo");
if (!r) throw new Error("solo run not read");
if (r.task !== "task-4" || r.wall !== 1000 || r.commits !== 1) throw new Error("solo fields");
if (r.tokens.total !== null) throw new Error("solo tokens come from Claude, not here");
' "$BENCH" "$FIX" > "$TMP/soloread.log" 2>&1
want "agy reader reads the solo arm too" 0 $? "$(head -3 "$TMP/soloread.log")"

# An open bracket is a task still being worked on. Counted as a run it reports
# as finished in whatever time has passed so far, which is not a measurement of
# anything. The reader has always had this rule; nothing exercised it.
OPENFIX="$TMP/fixopen"
rm -rf "$OPENFIX"; mkdir -p "$OPENFIX"
cat > "$OPENFIX/solo-task-5-20260814-140000.class" <<'CLS'
arm=solo
task=task-5
started=1786000000
head=aaaa
status=open
CLS
node -e '
const {readRuns} = require(process.argv[1] + "/lib/agy.js");
const {runs, skipped} = readRuns(process.argv[2]);
if (runs.length !== 0) throw new Error("an open bracket was counted as a run");
if (skipped.length !== 1) throw new Error("skipped: " + JSON.stringify(skipped));
if (!/solo --done/.test(skipped[0].reason)) throw new Error("skip reason does not say how to close it: " + skipped[0].reason);
' "$BENCH" "$OPENFIX" > "$TMP/openread.log" 2>&1
want "agy reader skips a solo bracket still open" 0 $? "$(head -3 "$TMP/openread.log")"

# The shell reads these files with class_val(), which is `head -1`: first match
# wins. A JS reader that took the last value would disagree with every shell
# caller about the same bytes on disk — and the record it disagrees about is
# exactly the one 1.8.16's solo close path exists to prevent, `status=open`
# above `status=success`. Whichever rule is right, there can only be one.
DUPFIX="$TMP/fixdup"
rm -rf "$DUPFIX"; mkdir -p "$DUPFIX"
cat > "$DUPFIX/solo-task-6-20260814-150000.class" <<'CLS'
arm=solo
task=task-6
started=1786000000
status=open
wall=1000
status=success
CLS
node -e '
const {readRuns, parseClass} = require(process.argv[1] + "/lib/agy.js");
const c = parseClass("k=first\nk=second\n");
if (c.k !== "first") throw new Error("parseClass took the last value: " + c.k);
const {runs, skipped} = readRuns(process.argv[2]);
if (runs.length !== 0) throw new Error("a duplicated status read as closed, disagreeing with class_val()");
if (skipped.length !== 1) throw new Error("skipped: " + JSON.stringify(skipped));
' "$BENCH" "$DUPFIX" > "$TMP/dupread.log" 2>&1
want "agy reader takes the first value of a repeated key" 0 $? "$(head -3 "$TMP/dupread.log")"

# Sidecars are written LF, and a CR that reaches one fails here in a shape worth
# naming: Number("1000\r") is 1000, so every numeric field survives intact and
# the record looks healthy, while `status === "open"` quietly stops matching.
# The damage lands only on the string comparisons — which is to say, only on the
# rules that decide whether a record counts at all.
CRFIX="$TMP/fixcr"
rm -rf "$CRFIX"; mkdir -p "$CRFIX"
printf 'arm=solo\r\ntask=task-7\r\nstarted=1786000000\r\nstatus=open\r\n' \
	> "$CRFIX/solo-task-7-20260814-160000.class"
node -e '
const {readRuns} = require(process.argv[1] + "/lib/agy.js");
const {runs, skipped} = readRuns(process.argv[2]);
if (runs.length !== 0) throw new Error("a CR made an open bracket read as closed");
if (skipped.length !== 1) throw new Error("skipped: " + JSON.stringify(skipped));
' "$BENCH" "$CRFIX" > "$TMP/crread.log" 2>&1
want "agy reader parses a CRLF sidecar" 0 $? "$(head -3 "$TMP/crread.log")"

# ========================================================= bench: claude reader
printf '\n=== bench: claude reader ===========================================\n'
CPROJ="$TMP/claudeproj/d--Fake-Repo"
rm -rf "$TMP/claudeproj"; mkdir -p "$CPROJ"
node -e '
const fs = require("fs");
const t = n => new Date(Date.parse("2026-08-14T10:00:00Z") + n * 1000).toISOString();
const turn = (n, side, out) => JSON.stringify({
  type: "assistant", timestamp: t(n), isSidechain: side,
  sessionId: "s1",
  message: {model: "claude-opus-5", usage: {
    input_tokens: 10, output_tokens: out, cache_read_input_tokens: 500,
    cache_creation_input_tokens: 200,
    output_tokens_details: {thinking_tokens: 5}}}});
const lines = [
  JSON.stringify({type: "user", timestamp: t(0), message: {role: "user"}}),
  turn(30, false, 100),
  turn(90, true, 40),
  turn(90 + 8 * 3600, false, 60)
];
fs.writeFileSync(process.argv[1] + "/sess.jsonl", lines.join("\n") + "\n");
' "$CPROJ"

# None of these four turns carries a message.id, which is the second thing this
# row asserts without saying so: turns that cannot be deduplicated are kept, not
# collapsed onto one another under a shared undefined key.
node -e '
const {readTurns, summarise, slugFor} = require(process.argv[1] + "/lib/claude.js");
if (slugFor("d:\\Claude Code\\DTS Skills") !== "d--Claude-Code-DTS-Skills")
  throw new Error("slug: " + slugFor("d:\\Claude Code\\DTS Skills"));
const turns = readTurns(process.argv[2], "d--Fake-Repo");
if (turns.length !== 3) throw new Error("turns: " + turns.length);
const s = summarise(turns, 600);
if (s.main.turns !== 2) throw new Error("main turns: " + s.main.turns);
if (s.sidechain.turns !== 1) throw new Error("sidechain turns: " + s.sidechain.turns);
if (s.sidechain.out !== 40) throw new Error("sidechain out: " + s.sidechain.out);
if (s.main.cache_read !== 1000) throw new Error("cache read: " + s.main.cache_read);
if (s.active_s !== 60) throw new Error("active must clip the 8h gap, got " + s.active_s);
if (s.elapsed_s !== 90 + 8 * 3600 - 30) throw new Error("elapsed: " + s.elapsed_s);
' "$BENCH" "$TMP/claudeproj" > "$TMP/cread.log" 2>&1
want "claude reader: slug, sidechain split, cache, clipping" 0 $? "$(head -3 "$TMP/cread.log")"

# Claude Code rewrites earlier turns into the new session file when a session
# resumes, so the same turn is on disk several times over. Measured against this
# project's own 27 transcripts: 1161 usage-bearing turns, 585 distinct ids, one
# turn written out nine times. Summed naively that is 2.25x the real output
# tokens and 1.91x the real cache reads — in the arm the whole benchmark exists
# to compare against the other one.
#
# The copies are not always equal. Exactly one id in those 585 disagrees with
# itself, and it disagrees in the shape that decides the rule: two copies
# carrying real usage against four carrying zeroes. File order is
# readdirSync().sort(), alphabetical by session uuid and otherwise arbitrary, so
# "keep the first copy seen" would record that turn as free whenever the zero
# copy sorted first. Keep the fullest copy, and date it from the earliest, since
# the turn happened once and the timestamps are what clipping is computed from.
#
# The fixture puts the zero copy in the file that sorts first and gives the full
# copy the later stamp, so first-seen and latest-stamp each fail a row of their
# own rather than both failing the same one.
DPROJ="$TMP/dupproj/d--Dup-Repo"
rm -rf "$TMP/dupproj"; mkdir -p "$DPROJ"
node -e '
const fs = require("fs");
const t = n => new Date(Date.parse("2026-08-14T10:00:00Z") + n * 1000).toISOString();
const turn = (id, n, u) => JSON.stringify({
  type: "assistant", timestamp: t(n), isSidechain: false, sessionId: "s1",
  message: {id: id, model: "claude-opus-5", usage: {
    input_tokens: u ? 10 : 0, output_tokens: u,
    cache_read_input_tokens: u ? 500 : 0,
    cache_creation_input_tokens: u ? 200 : 0,
    output_tokens_details: {thinking_tokens: u ? 5 : 0}}}});
const d = process.argv[1];
fs.writeFileSync(d + "/a.jsonl",
  [turn("m1", 0, 0), turn("m2", 60, 50), turn("m3", 120, 70)].join("\n") + "\n");
fs.writeFileSync(d + "/b.jsonl",
  [turn("m3", 120, 70), turn("m1", 300, 100)].join("\n") + "\n");
' "$DPROJ"

node -e '
const {readTurns, summarise} = require(process.argv[1] + "/lib/claude.js");
const turns = readTurns(process.argv[2], "d--Dup-Repo");
if (turns.length !== 3) throw new Error("five copies of three turns read as " + turns.length);
const s = summarise(turns, 600);
if (s.main.turns !== 3) throw new Error("main turns: " + s.main.turns);
if (s.main.cache_read !== 1500) throw new Error("cache read: " + s.main.cache_read + ", want 1500");
if (s.main.in !== 30) throw new Error("in: " + s.main.in);
' "$BENCH" "$TMP/dupproj" > "$TMP/cdup.log" 2>&1
want "claude reader counts a replayed turn once" 0 $? "$(head -3 "$TMP/cdup.log")"

node -e '
const {readTurns, summarise} = require(process.argv[1] + "/lib/claude.js");
const s = summarise(readTurns(process.argv[2], "d--Dup-Repo"), 600);
if (s.main.out !== 220) throw new Error("out: " + s.main.out + ", want 220 (0 means the zero-filled copy won)");
if (s.main.think !== 15) throw new Error("think: " + s.main.think);
' "$BENCH" "$TMP/dupproj" > "$TMP/cfull.log" 2>&1
want "  and keeps the fuller copy of a replayed turn" 0 $? "$(head -3 "$TMP/cfull.log")"

node -e '
const {readTurns, summarise} = require(process.argv[1] + "/lib/claude.js");
const s = summarise(readTurns(process.argv[2], "d--Dup-Repo"), 600);
if (s.elapsed_s !== 120) throw new Error("elapsed: " + s.elapsed_s + ", want 120 (240 means a replay stretched the session)");
if (s.active_s !== 120) throw new Error("active: " + s.active_s);
' "$BENCH" "$TMP/dupproj" > "$TMP/cstamp.log" 2>&1
want "  and dates it from the earliest copy" 0 $? "$(head -3 "$TMP/cstamp.log")"

# A slug that resolves to nothing is the arm being unmeasurable, not the arm
# having done nothing. Swallowed, it yields active 0, elapsed 0 and every total
# 0 — a complete-looking result that says Claude worked for no time at no cost.
node -e '
const {readTurns} = require(process.argv[1] + "/lib/claude.js");
let threw = null;
try { readTurns(process.argv[2], "d--No-Such-Repo"); } catch (e) { threw = e; }
if (!threw) throw new Error("a missing project directory read as zero turns");
if (!/d--No-Such-Repo/.test(threw.message)) throw new Error("refusal does not name the directory: " + threw.message);
' "$BENCH" "$TMP/claudeproj" > "$TMP/cmiss.log" 2>&1
want "claude reader refuses a project directory that is not there" 0 $? "$(head -3 "$TMP/cmiss.log")"

# And the other half, without which the row above is a statement about
# emptiness rather than about absence: a directory that exists and holds no
# sessions is a real answer of none.
mkdir -p "$TMP/claudeproj/d--Empty-Repo"
node -e '
const {readTurns} = require(process.argv[1] + "/lib/claude.js");
const turns = readTurns(process.argv[2], "d--Empty-Repo");
if (turns.length !== 0) throw new Error("turns: " + turns.length);
' "$BENCH" "$TMP/claudeproj" > "$TMP/cempty.log" 2>&1
want "  but an empty project directory is simply no turns" 0 $? "$(head -3 "$TMP/cempty.log")"

# ========================================================== bench: git and cost
printf '\n=== bench: git and cost ============================================\n'
GREPO="$TMP/costrepo"
rm -rf "$GREPO"; mkdir -p "$GREPO"
(
	cd "$GREPO" || exit 1
	git init -q . && git config user.email t@t && git config user.name T
	printf 'one\n' > a.txt && git add -A && git commit -qm first
	printf 'one\ntwo\nthree\n' > a.txt && git add -A && git commit -qm second
) >/dev/null 2>&1 || bad "cost fixture repo" "setup failed"

node -e '
const {numstat} = require(process.argv[1] + "/lib/gitwork.js");
const repo = process.argv[2];
const {execFileSync} = require("child_process");
const head = execFileSync("git", ["rev-parse", "HEAD"], {cwd: repo}).toString().trim();
const base = execFileSync("git", ["rev-parse", "HEAD~1"], {cwd: repo}).toString().trim();
const r = numstat(base + ".." + head, repo);
if (r.commits !== 1) throw new Error("commits: " + r.commits);
if (r.insertions < 1) throw new Error("insertions: " + r.insertions);
if (r.measured !== true) throw new Error("a range git resolved must be measured");
const empty = numstat("", repo);
if (empty.measured !== false) throw new Error("an empty range is not a measurement");
const bogus = numstat("nope..nope", repo);
if (bogus.measured !== false) throw new Error("a bad range must not throw, and must not measure");
' "$BENCH" "$GREPO" > "$TMP/git.log" 2>&1
want "gitwork: numstat, empty range, bad range" 0 $? "$(head -3 "$TMP/git.log")"

# .agy/solo already wrote this rule down, about this exact quantity: a rewritten
# history is not zero commits, it is a range nothing can measure, and recording
# it as 0 tells every reader that a session which may have committed a dozen
# times committed none. The reader has to carry the same distinction the writer
# does, or the writer's care is discarded one module downstream.
node -e '
const {numstat} = require(process.argv[1] + "/lib/gitwork.js");
const bogus = numstat("nope..nope", process.argv[2]);
if (bogus.commits === 0) throw new Error("an unresolvable range read as zero commits landed");
if (bogus.commits !== null || bogus.insertions !== null || bogus.deletions !== null)
  throw new Error("counts must be null, got " + JSON.stringify(bogus));
if (!bogus.reason) throw new Error("nothing said why it could not be measured");
const empty = numstat("", process.argv[2]);
if (empty.commits !== null) throw new Error("an absent range read as zero commits landed");
' "$BENCH" "$GREPO" > "$TMP/gitnull.log" 2>&1
want "gitwork does not report an unmeasurable range as zero work" 0 $? "$(head -3 "$TMP/gitnull.log")"

# The failure mode this one guards is not an error. `git log --numstat
# --format=%H --all` succeeds, and hands one task the entire history of the
# repository. A wrong answer that large arrives with no exit code to notice it.
node -e '
const {numstat} = require(process.argv[1] + "/lib/gitwork.js");
const {execFileSync} = require("child_process");
const repo = process.argv[2];
const all = Number(execFileSync("git", ["rev-list", "--count", "--all"], {cwd: repo}).toString().trim());
if (all < 2) throw new Error("fixture has no history to mis-attribute");
const r = numstat("--all", repo);
if (r.commits === all) throw new Error("--all attributed the whole repository (" + all + " commits) to one task");
if (r.measured !== false) throw new Error("--all was accepted as a range");
if (!/range/.test(r.reason)) throw new Error("reason: " + r.reason);
' "$BENCH" "$GREPO" > "$TMP/gitdash.log" 2>&1
want "  and a range that is not one is refused, not run" 0 $? "$(head -3 "$TMP/gitdash.log")"

node -e '
const {loadPrices, priceOf} = require(process.argv[1] + "/lib/cost.js");
const p = loadPrices(process.argv[1] + "/prices.json");
const tk = {in: 1e6, out: 0, think: 0, cache_read: 0, cache_write: 0};
const known = priceOf("claude-opus-5", tk, p);
if (!known.priced) throw new Error("claude-opus-5 must be priced");
if (typeof known.usd !== "number" || known.usd <= 0) throw new Error("usd: " + known.usd);
const cheap = priceOf("claude-opus-5", {in: 0, out: 0, think: 0, cache_read: 1e6, cache_write: 0}, p);
if (!(cheap.usd < known.usd)) throw new Error("a cache read must cost less than fresh input");
const unknown = priceOf("some-model-9", tk, p);
if (unknown.priced !== false || unknown.usd !== null)
  throw new Error("an unknown model must be null, not zero");
' "$BENCH" > "$TMP/cost.log" 2>&1
want "cost: known, cache discount, unknown-is-null" 0 $? "$(head -3 "$TMP/cost.log")"

# The two model ids are read out of .agy/dispatch rather than written here, so
# changing a default without adding its rate fails this row instead of shipping
# a cost panel that is null for every run of the arm being measured.
DEF_MODEL="$(sed -n 's/^: "${AGY_MODEL:=\(.*\)}"$/\1/p' "$SKILL_DIR/assets/dispatch")"
DEF_RESERVE="$(sed -n 's/^: "${AGY_FALLBACK_MODEL:=\(.*\)}"$/\1/p' "$SKILL_DIR/assets/dispatch")"
node -e '
const {loadPrices, priceOf} = require(process.argv[1] + "/lib/cost.js");
const p = loadPrices(process.argv[1] + "/prices.json");
const tk = {in: 1e6, out: 0, think: 0, cache_read: 0, cache_write: 0};
for (const m of process.argv.slice(2)) {
  if (!m) throw new Error("could not read a default model out of dispatch");
  const r = priceOf(m, tk, p);
  if (!r.priced) throw new Error(m + " is a shipped default and prices to null");
  if (!(r.usd > 0)) throw new Error(m + " usd: " + r.usd);
  if (!r.source) throw new Error(m + " is priced with no stated source");
}
' "$BENCH" "$DEF_MODEL" "$DEF_RESERVE" > "$TMP/costdef.log" 2>&1
want "cost prices the models agy actually defaults to" 0 $? "$(head -3 "$TMP/costdef.log")"

# Both tables hold the same two rates and differ only in which line was typed
# first. If the answer moves, the rate a run is billed at is decided by JSON
# authoring order.
node -e '
const {priceOf} = require(process.argv[1] + "/lib/cost.js");
const broad = {in: 99, out: 0, cache_read: 0, cache_write: 0, source: "x"};
const exact = {in: 1, out: 0, cache_read: 0, cache_write: 0, source: "x"};
const a = {models: {"gemini-3": broad, "gemini-3.7-flash": exact}};
const b = {models: {"gemini-3.7-flash": exact, "gemini-3": broad}};
const tk = {in: 1e6, out: 0, think: 0, cache_read: 0, cache_write: 0};
const ua = priceOf("gemini-3.7-flash-high", tk, a).usd;
const ub = priceOf("gemini-3.7-flash-high", tk, b).usd;
if (ua !== ub) throw new Error("key order decided the rate: " + ua + " vs " + ub);
if (ua !== 1) throw new Error("the broader prefix won: " + ua);
' "$BENCH" > "$TMP/costpfx.log" 2>&1
want "  by the longest matching prefix, not the first key written" 0 $? "$(head -3 "$TMP/costpfx.log")"

# Anthropic bills a five-minute cache write at 1.25x input and a one-hour write
# at 2x. Every cache write in this project is a one-hour write — 4,411,940
# tokens of them against zero five-minute ones — and cache writes are about half
# the Claude arm's notional cost, so one rate for both understates the arm the
# benchmark is comparing against by roughly a fifth.
node -e '
const {loadPrices, priceOf} = require(process.argv[1] + "/lib/cost.js");
const p = loadPrices(process.argv[1] + "/prices.json");
const base = {in: 0, out: 0, think: 0, cache_read: 0, cache_write: 1e6};
const m5 = priceOf("claude-opus-5", base, p);
const h1 = priceOf("claude-opus-5", Object.assign({}, base, {cache_write_1h: 1e6}), p);
if (!(h1.usd > m5.usd)) throw new Error("an hour-long cache write cost no more than a five-minute one");
if (m5.usd !== 6.25) throw new Error("five-minute write: " + m5.usd);
if (h1.usd !== 10) throw new Error("one-hour write: " + h1.usd);
const half = priceOf("claude-opus-5", Object.assign({}, base, {cache_write_1h: 5e5}), p);
if (half.usd !== 8.125) throw new Error("a half-and-half write: " + half.usd);
' "$BENCH" > "$TMP/costttl.log" 2>&1
want "cost charges a one-hour cache write at the one-hour rate" 0 $? "$(head -3 "$TMP/costttl.log")"

# And the rate is only reachable if the reader carries the split through.
TTLP="$TMP/ttlproj/d--Ttl-Repo"
rm -rf "$TMP/ttlproj"; mkdir -p "$TTLP"
node -e '
const fs = require("fs");
fs.writeFileSync(process.argv[1] + "/s.jsonl", JSON.stringify({
  type: "assistant", timestamp: "2026-08-14T10:00:00Z", isSidechain: false,
  sessionId: "s1",
  message: {id: "t1", model: "claude-opus-5", usage: {
    input_tokens: 10, output_tokens: 20,
    cache_read_input_tokens: 0, cache_creation_input_tokens: 500,
    cache_creation: {ephemeral_1h_input_tokens: 400, ephemeral_5m_input_tokens: 100}}}}) + "\n");
' "$TTLP"
node -e '
const {readTurns, summarise} = require(process.argv[1] + "/lib/claude.js");
const t = readTurns(process.argv[2], "d--Ttl-Repo")[0];
if (t.tokens.cache_write !== 500) throw new Error("cache_write: " + t.tokens.cache_write);
if (t.tokens.cache_write_1h !== 400) throw new Error("cache_write_1h: " + t.tokens.cache_write_1h);
const s = summarise([t], 600);
if (s.main.cache_write_1h !== 400) throw new Error("the split did not survive summarise");
' "$BENCH" "$TMP/ttlproj" > "$TMP/ttlread.log" 2>&1
want "  and claude.js reports the hour-long writes separately" 0 $? "$(head -3 "$TMP/ttlread.log")"

# Thinking is 39.2% of this project's output tokens. Both vendors report it as a
# breakdown of output rather than beside it — Google's table row is labelled
# "Output price (including thinking tokens)" — so charging it again adds two
# fifths to one arm's output bill. The parameter is accepted and deliberately
# unused, which reads as an oversight to anyone who has not been told otherwise.
node -e '
const {loadPrices, priceOf} = require(process.argv[1] + "/lib/cost.js");
const p = loadPrices(process.argv[1] + "/prices.json");
const plain = {in: 0, out: 1e6, think: 0, cache_read: 0, cache_write: 0};
const a = priceOf("claude-opus-5", plain, p);
const b = priceOf("claude-opus-5", Object.assign({}, plain, {think: 1e6}), p);
if (a.usd !== b.usd) throw new Error("thinking was charged on top of output: " + a.usd + " vs " + b.usd);
if (a.usd !== 25) throw new Error("output usd: " + a.usd);
' "$BENCH" > "$TMP/costthink.log" 2>&1
want "cost does not charge thinking tokens twice" 0 $? "$(head -3 "$TMP/costthink.log")"

# One token of opus-5 input is $0.000005. Rounded to four places at the point of
# pricing it is $0, and a thousand such runs sum to nothing at all. Rounding is
# a thing a view does, once, to a number it is about to print.
node -e '
const {loadPrices, priceOf} = require(process.argv[1] + "/lib/cost.js");
const p = loadPrices(process.argv[1] + "/prices.json");
const one = {in: 1, out: 0, think: 0, cache_read: 0, cache_write: 0};
let sum = 0;
for (let i = 0; i < 1000; i++) sum += priceOf("claude-opus-5", one, p).usd;
if (!(sum > 0)) throw new Error("a thousand priced runs summed to " + sum);
const once = priceOf("claude-opus-5", {in: 1000, out: 0, think: 0, cache_read: 0, cache_write: 0}, p).usd;
if (Math.abs(sum - once) > 1e-9) throw new Error("summed " + sum + ", but the same tokens priced at once are " + once);
' "$BENCH" > "$TMP/costround.log" 2>&1
want "cost does not round a small run away" 0 $? "$(head -3 "$TMP/costround.log")"

# 28 turns per project carry model "<synthetic>" — Claude Code writing down its
# own interrupts and errors — with every count zero. Zero tokens have a cost
# that needs no rate. Reserving null for the case where there are tokens and no
# rate is what keeps a null meaning "nobody knows" rather than "nothing here".
node -e '
const {loadPrices, priceOf} = require(process.argv[1] + "/lib/cost.js");
const p = loadPrices(process.argv[1] + "/prices.json");
const nothing = {in: 0, out: 0, think: 0, cache_read: 0, cache_write: 0};
const free = priceOf("<synthetic>", nothing, p);
if (free.priced !== true || free.usd !== 0)
  throw new Error("a turn that spent nothing priced as unpriceable: " + JSON.stringify(free));
const spent = priceOf("<synthetic>", {in: 1e6, out: 0, think: 0, cache_read: 0, cache_write: 0}, p);
if (spent.priced !== false || spent.usd !== null)
  throw new Error("an unknown model that spent tokens must stay null: " + JSON.stringify(spent));
' "$BENCH" > "$TMP/costzero.log" 2>&1
want "an unknown model that spent nothing costs nothing" 0 $? "$(head -3 "$TMP/costzero.log")"

# =================================================== bench: agy thread accounting
printf '\n=== bench: agy thread accounting ===================================\n'
# agy reports usage for the THREAD, not for the run. Measured against the real
# binary on 2026-08-21 — three calls, the second and third on --continue:
#
#   turns 1:  in 13751  out 25  think 24  total 13776
#   turns 2:  in 27734  out 49  think 47  total 27783
#   turns 3:  in 41948  out 73  think 70  total 42021
#
# Every count accumulates. protocol.md sends fix rounds 1-3 back on
# `.agy/dispatch --continue`, each writing its own sidecar, so summing them
# counts the first turn once per round that follows it. The reserve handover is
# worse than a multiple: it continues the same thread under a different model,
# so the failed primary's tokens are billed a second time at the reserve's rate.
# Both errors inflate the agy arm, on exactly the long runs.
TLOGS="$TMP/threadlogs"
rm -rf "$TLOGS"; mkdir -p "$TLOGS"

# tclass <file> <key=value>... - a sidecar with the caller's keys first and
# the common ones defaulted after them. The order matters and is the point:
# the reader is first-match-wins, deliberately, so that .agy/solo's rewritten
# `status=open` line beats the one below it. Writing the defaults last is what
# makes them defaults; writing them first would have quietly pinned every run
# in this fixture to one model and one status, and the two rows that turn on
# a per-run override would have passed by agreeing with the wrong value.
tclass() {
	f="$TLOGS/$1"; shift
	{
		for kv in "$@"; do printf '%s\n' "$kv"; done
		printf 'arm=agy\nstatus=success\nwall=100\n'
		printf 'model=gemini-3.7-flash-high\ntokens_scope=thread\n'
	} > "$f"
}

# --- one thread, three runs. Positions 1, 3 and 7, because a dispatch makes
# several turns of its own and the gaps between rounds are normal. Differencing
# has to follow the recorded position, not assume consecutive numbering.
tclass task-1-20260101-000001.class conversation=T-A thread_turns=1 continued=0 \
	tokens_in=1000 tokens_out=100 tokens_think=40 tokens_cache_read=10 tokens_total=1100
tclass task-1-20260101-000002.class conversation=T-A thread_turns=3 continued=1 \
	tokens_in=3000 tokens_out=300 tokens_think=120 tokens_cache_read=30 tokens_total=3300
tclass task-1-20260101-000003.class conversation=T-A thread_turns=7 continued=1 \
	tokens_in=6000 tokens_out=600 tokens_think=250 tokens_cache_read=60 tokens_total=6600

# --- a reserve handover on --continue: same thread, different model. The
# filenames sort the reserve FIRST ('-' before '.'), which is deliberate: the
# order has to come from the recorded position, not from the directory listing.
tclass task-2-20260101-000001.class conversation=T-B thread_turns=1 continued=0 \
	status=error tokens_in=5000 tokens_out=500 tokens_think=200 tokens_cache_read=0 tokens_total=5500
tclass task-2-20260101-000001-reserve.class conversation=T-B thread_turns=5 continued=1 \
	model=claude-opus-4-6-thinking \
	tokens_in=9000 tokens_out=900 tokens_think=400 tokens_cache_read=0 tokens_total=9900

# --- a handover that could not resume, so it opened its own thread. num_turns 4
# with continued=0: four turns that are all its own.
tclass task-3-20260101-000001.class conversation=T-C1 thread_turns=1 continued=0 \
	status=error tokens_in=2000 tokens_out=200 tokens_think=80 tokens_cache_read=0 tokens_total=2200
tclass task-3-20260101-000001-reserve.class conversation=T-C2 thread_turns=4 continued=0 \
	model=claude-opus-4-6-thinking \
	tokens_in=7000 tokens_out=700 tokens_think=300 tokens_cache_read=0 tokens_total=7700

# --- continued, with nothing in the log to continue from (the earlier rounds
# were pruned). The total carries turns nobody can subtract.
tclass task-4-20260101-000001.class conversation=T-D thread_turns=6 continued=1 \
	tokens_in=8000 tokens_out=800 tokens_think=350 tokens_cache_read=0 tokens_total=8800

# --- continued, but agy reported no position at all.
tclass task-5-20260101-000001.class conversation=T-E thread_turns=1 continued=0 \
	tokens_in=1000 tokens_out=100 tokens_think=40 tokens_cache_read=0 tokens_total=1100
tclass task-5-20260101-000002.class conversation=T-E thread_turns= continued=1 \
	tokens_in=4000 tokens_out=400 tokens_think=150 tokens_cache_read=0 tokens_total=4400

# --- a running total that shrank. One of the two sidecars is not what it says.
tclass task-6-20260101-000001.class conversation=T-F thread_turns=1 continued=0 \
	tokens_in=5000 tokens_out=500 tokens_think=200 tokens_cache_read=0 tokens_total=5500
tclass task-6-20260101-000002.class conversation=T-F thread_turns=3 continued=1 \
	tokens_in=4000 tokens_out=400 tokens_think=150 tokens_cache_read=0 tokens_total=4400

# --- written before any of this existed: no thread keys at all.
printf 'arm=agy\nstatus=success\nwall=50\nmodel=gemini-3.7-flash-high\n' \
	> "$TLOGS/task-7-20260101-000001.class"
printf 'tokens_in=1234\ntokens_out=234\ntokens_think=100\ntokens_total=1468\n' \
	>> "$TLOGS/task-7-20260101-000001.class"

# The bench paths go in as arguments, not spliced into the -e source: the
# shell hands node a POSIX path and only argv gets translated back to a
# Windows one on the way in. A path pasted into the script text arrives as
# /tmp/... and node reports the directory as unreadable, which readRuns
# correctly reports as a skip -- so every row would fail for the same wrong
# reason and none of them would be testing what it says it tests.
tnode() { # tnode <label> <js>
	node -e "
	const { readRuns } = require(process.argv[1] + '/lib/agy.js');
	const { runs } = readRuns(process.argv[2]);
	const by = {}; for (const r of runs) by[r.label] = r;
	const t = l => by[l].tokens;
	const shape = l => [t(l).in, t(l).out, t(l).think, t(l).cache_read, t(l).total].join('/');
	const eq = (l, want) => { const g = shape(l);
		if (g !== want) throw new Error(l + ': ' + g + ', want ' + want); };
	$2
	" "$BENCH" "$TLOGS" > "$TMP/thr.log" 2>&1
	want "$1" 0 $? "$(grep -m1 '^Error:' "$TMP/thr.log")"
}

tnode "a continued run is counted for its own turn, not the thread's total" '
	eq("task-1-20260101-000001", "1000/100/40/10/1100");
	eq("task-1-20260101-000002", "2000/200/80/20/2200");
	eq("task-1-20260101-000003", "3000/300/130/30/3300");
	if (by["task-1-20260101-000003"].tokensOf !== "turn") throw new Error("not marked as a turn");
'

tnode "  so a reserve handover does not bill the failed attempt twice" '
	eq("task-2-20260101-000001", "5000/500/200/0/5500");
	eq("task-2-20260101-000001-reserve", "4000/400/200/0/4400");
	if (by["task-2-20260101-000001-reserve"].model !== "claude-opus-4-6-thinking")
		throw new Error("the reserve run lost its own model");
'

tnode "  and a handover that opened a new thread is left alone" '
	eq("task-3-20260101-000001-reserve", "7000/700/300/0/7700");
	if (by["task-3-20260101-000001-reserve"].tokensOf !== "turn")
		throw new Error("a fresh thread was not trusted with its own tokens");
'

tnode "a continued run whose earlier turns are gone is unmeasured, not inflated" '
	const r = by["task-4-20260101-000001"];
	if (r.tokens.total !== null) throw new Error("kept an inflated total: " + r.tokens.total);
	if (r.tokens.in !== null) throw new Error("kept an inflated input count");
	if (r.tokensOf !== "unknown") throw new Error("tokensOf: " + r.tokensOf);
	if (r.quality !== "partial") throw new Error("quality: " + r.quality);
	if (!r.tokensNote) throw new Error("nulled the count without saying why");
'

tnode "  and a run that never reported its thread position is not trusted" '
	const r = by["task-5-20260101-000002"];
	if (r.tokens.total !== null) throw new Error("kept " + r.tokens.total);
	if (!r.tokensNote) throw new Error("no reason recorded");
	if (by["task-5-20260101-000001"].tokens.total !== 1100)
		throw new Error("the turn that WAS measurable was dropped too");
'

tnode "a thread total that goes backwards is refused, not negated" '
	const r = by["task-6-20260101-000002"];
	if (r.tokens.in !== null) throw new Error("reported " + r.tokens.in);
	if (typeof r.tokens.in === "number" && r.tokens.in < 0) throw new Error("negative tokens");
'

tnode "a sidecar written before this instrumentation is partial, not a turn count" '
	const r = by["task-7-20260101-000001"];
	if (r.tokens.in !== 1234) throw new Error("threw away the only figures there are");
	if (r.tokensOf !== "unknown") throw new Error("tokensOf: " + r.tokensOf);
	if (r.quality !== "partial") throw new Error("quality: " + r.quality);
'

# The reader has to carry the cache reads dispatch now records, or the row added
# to the sidecar is a row nothing downstream can spend.
tnode "the reader carries the cache reads through to the run" '
	if (by["task-1-20260101-000001"].tokens.cache_read !== 10)
		throw new Error("cache_read: " + by["task-1-20260101-000001"].tokens.cache_read);
'

# =============================================================== bench: collect
printf '\n=== bench: collect =================================================\n'
# collect is the only thing that reads a log and the only thing that writes
# runs.json. Everything below is about what it does with a source it cannot
# read: the whole point of the file is that a hole in it is visible as a hole.

CREPO="$TMP/collectrepo"
rm -rf "$CREPO"; mkdir -p "$CREPO"
git -C "$CREPO" init -q
git -C "$CREPO" config user.email bench@example.invalid
git -C "$CREPO" config user.name bench
printf 'one\n' > "$CREPO/f.txt"
git -C "$CREPO" add -A >/dev/null; git -C "$CREPO" commit -qm base
CBASE="$(git -C "$CREPO" rev-parse HEAD)"
printf 'one\ntwo\nthree\nfour\n' > "$CREPO/f.txt"
git -C "$CREPO" add -A >/dev/null; git -C "$CREPO" commit -qm work
CTIP="$(git -C "$CREPO" rev-parse HEAD)"
CLOGS="$CREPO/.agy/work/logs"
mkdir -p "$CLOGS"

# cclass <file> <key=value>... - caller's keys first, defaults after, for the
# same first-match-wins reason as the thread fixture above.
cclass() {
	f="$CLOGS/$1"; shift
	{
		for kv in "$@"; do printf '%s\n' "$kv"; done
		printf 'arm=agy\nstatus=success\nwall=100\ntools=3\nquota=none\n'
		printf 'model=gemini-3.7-flash\ntokens_scope=thread\ncontinued=0\n'
		printf 'thread_turns=1\nconversation=C-1\nraw=\n'
	} > "$f"
}

# A run that landed the second commit.
cclass task-1-20260101-000001.class range="$CBASE..$CTIP" \
	tokens_in=1000 tokens_out=100 tokens_think=40 tokens_cache_read=200 tokens_total=1100
# The solo arm goes through the same reader and the same git attribution.
cclass solo-task-2-20260101-000002.class arm=solo task=task-2 \
	range="$CBASE..$CTIP" \
	tokens_in=500 tokens_out=50 tokens_think=10 tokens_cache_read=0 tokens_total=550
# A range git cannot resolve: the commits were rebased away.
cclass task-3-20260101-000003.class range=deadbee..f00dfac \
	tokens_in=1000 tokens_out=100 tokens_think=40 tokens_cache_read=0 tokens_total=1100
# Continued with nothing in its thread to continue from: no attributable tokens.
cclass task-4-20260101-000004.class range="$CBASE..$CTIP" \
	conversation=C-9 thread_turns=4 continued=1 \
	tokens_in=9000 tokens_out=900 tokens_think=300 tokens_cache_read=0 tokens_total=9900
# The same run as task-1 but with no cache reads, so the two can be compared.
cclass task-5-20260101-000005.class range="$CBASE..$CTIP" conversation=C-5 \
	tokens_in=1000 tokens_out=100 tokens_think=40 tokens_cache_read=0 tokens_total=1100

# The Claude side. The last turn is a <synthetic> one, which is what a real
# transcript very often ends on, and it is not a model.
CPROJ2="$TMP/collectproj/d--Coll-Repo"
rm -rf "$TMP/collectproj"; mkdir -p "$CPROJ2"
node -e '
const fs = require("fs");
const t = n => new Date(Date.parse("2026-08-14T10:00:00Z") + n * 1000).toISOString();
const turn = (n, id, model, side, out) => JSON.stringify({
  type: "assistant", timestamp: t(n), isSidechain: side, sessionId: "s1",
  message: {id: id, model: model, usage: {
    input_tokens: 100, output_tokens: out, cache_read_input_tokens: 500,
    cache_creation_input_tokens: 200,
    output_tokens_details: {thinking_tokens: 5}}}});
// A real synthetic turn carries every count at zero -- it is Claude Code own
// interrupt and error records, not a model call. That is what makes it safe to
// price at an unknown rate, and it is why the fixture must not invent tokens
// for it: a synthetic turn with tokens would be unpriced for a real reason and
// the row below would pass or fail for something other than what it tests.
const synth = JSON.stringify({
  type: "assistant", timestamp: t(90), isSidechain: false, sessionId: "s1",
  message: {id: "m3", model: "<synthetic>", usage: {
    input_tokens: 0, output_tokens: 0, cache_read_input_tokens: 0,
    cache_creation_input_tokens: 0,
    output_tokens_details: {thinking_tokens: 0}}}});
const lines = [
  turn(30, "m1", "claude-opus-5", false, 100),
  turn(60, "m2", "claude-opus-5", true, 40),
  synth
];
fs.writeFileSync(process.argv[1] + "/sess.jsonl", lines.join("\n") + "\n");
' "$CPROJ2"

crun() { # crun <projects-dir> <slug> -> exit code in $CRC, log in $TMP/collect.log
	( cd "$CREPO" && AGY_WORKSPACE=".agy/work" \
		CLAUDE_PROJECTS_DIR="$1" CLAUDE_PROJECT_SLUG="$2" \
		node "$BENCH/collect" ) > "$TMP/collect.log" 2>&1
	CRC=$?
}

crun "$TMP/collectproj" d--Coll-Repo
want "collect runs" 0 "$CRC" "$(head -5 "$TMP/collect.log")"
CRJ="$CREPO/.agy/work/bench/runs.json"
if [ -f "$CRJ" ]; then ok "  and writes runs.json"; else bad "  and writes runs.json" "missing"; fi
has "  and names the file it wrote" "runs.json" "$TMP/collect.log"

cnode() { # cnode <label> <js over `j`>
	node -e "
	const j = JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8'));
	const by = t => j.runs.find(r => r.task === t);
	$2
	" "$CRJ" > "$TMP/cj.log" 2>&1
	want "$1" 0 $? "$(grep -m1 '^Error:' "$TMP/cj.log")"
}

cnode "runs.json carries both arms, the claude block and the skipped list" '
	if (!Array.isArray(j.runs)) throw new Error("no runs array");
	if (!j.generated) throw new Error("no generated stamp");
	if (j.idle_gap_s !== 600) throw new Error("gap: " + j.idle_gap_s);
	if (!j.claude || typeof j.claude.active_s !== "number") throw new Error("no claude block");
	if (j.claude.sidechain.turns !== 1) throw new Error("sidechain not carried through");
	if (!Array.isArray(j.skipped)) throw new Error("no skipped array");
	const solo = j.runs.find(r => r.arm === "solo");
	if (!solo) throw new Error("solo arm missing from runs.json");
	if (solo.insertions !== 3) throw new Error("solo not attributed by git: " + solo.insertions);
'

# git could not resolve the range. Zero insertions would read as a run that
# landed nothing, which is a different claim and a false one.
cnode "a range git cannot resolve is a hole, not a run that landed nothing" '
	const r = by("task-3");
	if (r.insertions !== null) throw new Error("insertions: " + r.insertions);
	if (r.work_measured !== false) throw new Error("work_measured: " + r.work_measured);
	if (!r.work_reason) throw new Error("no reason recorded for the hole");
	if (by("task-1").work_measured !== true) throw new Error("a measurable run was marked unmeasured");
'

cnode "a run whose tokens cannot be attributed prices to null, not to free" '
	const r = by("task-4");
	if (r.usd !== null) throw new Error("usd: " + r.usd);
	if (r.priced !== false) throw new Error("priced: " + r.priced);
	if (by("task-1").usd === null) throw new Error("a measurable run lost its price");
'

# The cache-read row exists in the sidecar now. If collect still passes a
# hardcoded 0 the two runs below cost exactly the same, and the row is a row
# nothing spends.
cnode "cache reads reach the price, so recording them changes the bill" '
	const withRead = by("task-1").usd, without = by("task-5").usd;
	if (!(withRead > without)) throw new Error(withRead + " vs " + without);
'

# Pricing the arm at turns[last].model bills every turn at whatever answered
# last -- and what answers last is very often <synthetic>, which is not a model.
cnode "the claude arm is priced per turn, not at whatever answered last" '
	if (!(j.claude.usd_main > 0)) throw new Error("usd_main: " + j.claude.usd_main);
	if (j.claude.priced !== true) throw new Error("one synthetic turn left the arm unpriced");
	if (j.claude.model !== "claude-opus-5") throw new Error("headline model: " + j.claude.model);
	const syn = j.claude.models.find(m => m.model === "<synthetic>");
	if (!syn) throw new Error("the synthetic turns were not accounted for at all");
	if (syn.usd !== 0) throw new Error("a synthetic turn was charged: " + syn.usd);
'

# claude.js throws on an unreadable project directory rather than answering []
# so it cannot be mistaken for an arm that spent nothing. That is only worth
# something if collect records the throw instead of dying on it -- the git work
# is already done by then, and crashing would write no file at all.
crun "$TMP/collectproj" d--Not-There
want "an unreadable transcript directory is a skip, not a crash" 0 "$CRC" \
	"$(head -3 "$TMP/collect.log")"
cnode "  the run it did measure still reaches the file" '
	if (by("task-1").insertions !== 3) throw new Error("git work was thrown away");
	if (!j.skipped.some(s => /d--Not-There/.test(s.path))) throw new Error("the miss was not recorded");
	if (j.claude.main.turns !== 0) throw new Error("turns invented: " + j.claude.main.turns);
'
has "  and the run says so on the way out" "SKIPPED" "$TMP/collect.log"

# A directory that is there and holds no sessions is a different fact from one
# that is not there, and claude.js answers [] for it rather than throwing --
# because [] is true. It still has to reach runs.json as a skip: an arm with no
# transcripts reads as an arm that spent nothing, which is the same wrong answer
# arrived at politely.
mkdir -p "$TMP/collectproj/d--Empty-Coll"
crun "$TMP/collectproj" d--Empty-Coll
want "a transcript directory with no sessions is still a skip" 0 "$CRC" \
	"$(head -3 "$TMP/collect.log")"
cnode "  because an arm with no transcripts reads as an arm that spent nothing" '
	if (!j.skipped.some(s => /d--Empty-Coll/.test(s.path)))
		throw new Error("an empty transcript directory passed as a measurement");
'

printf '\n====================================================================\n'
printf '  %d passed, %d failed\n\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ] || exit 1
