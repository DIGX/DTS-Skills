#!/usr/bin/env bash
#
# Deploy the Claude Manager + Antigravity Implementer protocol into a project.
#
#   install [options]
#
#   --root <path>        project root (default: git root of the cwd)
#   --project <name>     display name (default: the root directory's name)
#   --milestone <slug>   workspace slug (default: m1, or the one already bound)
#   --workspace <path>   use an existing workspace instead of .agy/work/<slug>
#   --gates <path>       use an existing gate runner instead of writing .agy/gates
#   --guard-tree <path>  an external read-only tree to fence (a dev site, a
#                        data dir). Fingerprinted by size+mtime, not content.
#   --plan <path>        the plan the ledger should reference
#   --coauthor <trailer> the one Co-Authored-By: value landed commits may carry,
#                        e.g. 'Antigravity <agy@example.com>'. Also read from
#                        AGY_COAUTHOR; empty switches the check off. Defaults to
#                        an address nobody can own — see .agy/config.
#   --force              overwrite config, gates and templates that already exist
#   --dry-run            print what would happen, change nothing
#
# Idempotent by default: re-running never clobbers a config or a gate runner
# you have edited. The scripts themselves are always refreshed, because they
# are the skill's to own.

set -uo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ASSETS="$SKILL_DIR/assets"

ROOT=""; PROJECT=""; MILESTONE=""; WORKSPACE=""; GATES=""; GUARD_TREE=""
PLAN=""; FORCE=0; DRY=0; COAUTHOR_OPT=""

while [ $# -gt 0 ]; do
	case "$1" in
	--root)       ROOT="$2"; shift 2 ;;
	--project)    PROJECT="$2"; shift 2 ;;
	--milestone)  MILESTONE="$2"; shift 2 ;;
	--workspace)  WORKSPACE="$2"; shift 2 ;;
	--gates)      GATES="$2"; shift 2 ;;
	--guard-tree) GUARD_TREE="$2"; shift 2 ;;
	--plan)       PLAN="$2"; shift 2 ;;
	--coauthor)   COAUTHOR_OPT="$2"; COAUTHOR_SET=1; shift 2 ;;
	--force)      FORCE=1; shift ;;
	--dry-run)    DRY=1; shift ;;
	-h|--help)    sed -n '2,30p' "$0"; exit 0 ;;
	*) printf 'install: unknown option %s\n' "$1" >&2; exit 2 ;;
	esac
done

if [ -z "$ROOT" ]; then
	ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
		printf 'install: not a git repository, and no --root given.\n' >&2
		printf 'The fence judges git history, so the protocol needs one. Run\n' >&2
		printf '`git init` first, or pass --root <path-to-a-repo>.\n' >&2
		exit 2
	}
fi
cd "$ROOT" || exit 1
ROOT="$PWD"
[ -n "$PROJECT" ] || PROJECT="$(basename "$ROOT")"

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
TODAY="$(date +%Y-%m-%d)"

# The commit trailer, resolved once, here. It is written into .agy/config for the
# check to read and substituted into dispatch-context.md for the model to copy —
# one source, two renderings, so the rule and its enforcement cannot drift.
#
# Four sources, most specific first:
#   1. --coauthor    you said so, on this run
#   2. .agy/config   this project already decided, and committed the decision
#   3. AGY_COAUTHOR  one machine's preference, for repos with no opinion yet
#   4. the shipped default
#
# A config that already names it outranking the environment is the one that
# looks backwards, because the config's own header promises the environment
# always wins. That promise is about *runtime*: `${VAR:=x}` is how a single
# dispatch gets overridden. This is install time, and the question is a
# different one — what address to write into dispatch-context.md, a file that
# is committed and read by everyone on the project. A maintainer with
# AGY_COAUTHOR exported, installing into somebody else's repo, must not rewrite
# that repo's shared context to name their own mailbox. Their export still wins
# at runtime, where the drift refusal will stop them dispatching against a rule
# the context does not carry — which is that refusal working, not fighting it.
#
# The consequence, and it is the intended one: once a project has decided, only
# an explicit --coauthor changes it. Not --force, which regenerates scaffolding
# and has no business silently repointing who gets credited on a contributor
# graph. Whatever resolves, it is printed, so no run leaves it to be guessed.
#
# The shipped default is unroutable ON PURPOSE, and changing it is not a
# housekeeping edit. This installer runs in other people's repositories, so
# whatever address is baked in here is stamped on the contributor graph of every
# repo any stranger installs it into. That is the exact bug this check exists to
# stop, and putting a maintainer's own address here would only reverse who it is
# done to. A default must credit nobody; an address that credits *someone* is a
# choice each project makes for itself.
#
# `.invalid` is reserved by RFC 2606 and can never be registered, so no account
# can ever verify an address there. Empty switches the check off.
COAUTHOR="Antigravity <antigravity@antigravity.invalid>"
COAUTHOR_SRC="the shipped default — credits nobody"
# Sourced rather than parsed: the value may be set by any shell form, and the
# config is a file we already execute on every dispatch. `grep` first because an
# absent key and a key deliberately set empty are different answers — empty is
# how a project switches the check off, and sourcing alone cannot tell them
# apart.
CFG_HAS_CA=0
CFG_CA=""
if [ -f .agy/config ] && grep -qE '\bAGY_COAUTHOR\b' .agy/config 2>/dev/null; then
	CFG_HAS_CA=1
	CFG_CA="$( unset AGY_COAUTHOR; . ./.agy/config >/dev/null 2>&1
	           printf '%s' "${AGY_COAUTHOR-}" )"
	COAUTHOR="$CFG_CA"
	COAUTHOR_SRC="already set in .agy/config"
elif [ -n "${AGY_COAUTHOR+set}" ]; then
	COAUTHOR="$AGY_COAUTHOR"
	COAUTHOR_SRC="AGY_COAUTHOR in the environment"
fi
if [ -n "$COAUTHOR_OPT" ] || [ -n "${COAUTHOR_SET:-}" ]; then
	COAUTHOR="$COAUTHOR_OPT"
	COAUTHOR_SRC="--coauthor on this run"
fi

say()  { printf '  %-8s %s\n' "$1" "$2"; }
do_it() { [ "$DRY" -eq 1 ] && return 1; return 0; }

printf '\nagy-agents installer\n'
printf 'root         %s\n' "$ROOT"
printf 'project      %s\n' "$PROJECT"
[ "$DRY" -eq 1 ] && printf 'mode         DRY RUN — nothing will be written\n'
printf '\n'

# ---------------------------------------------------------------- adoption scan
# Anything already here that this protocol should use rather than duplicate.
#
# The config's own AGY_WORKSPACE, read the way every .agy script reads it, so an
# edited config (a bare assignment, a different default) resolves the same here.
# AGY_WORKSPACE is unset first: the file uses `:=`, so an installer inherited it
# from the environment would read back its own environment, not the project's.
cfg_workspace() {
	[ -f .agy/config ] || return 0
	( unset AGY_WORKSPACE; . ./.agy/config >/dev/null 2>&1
	  printf '%s' "${AGY_WORKSPACE:-}" )
}
CONFIG_WORKSPACE="$(cfg_workspace)"
CONFIG_WORKSPACE="${CONFIG_WORKSPACE#./}"

# Where the work lives, in order of authority:
#   1. --workspace / --milestone — you said so, on this run
#   2. .agy/config — the live binding every dispatch, fence and gate run reads
#   3. a workspace found on disk (first adoption; newest ledger wins)
#   4. .agy/work/m1
#
# 2 sits above 3 because a project past its first milestone has several
# `.agy/work/*/progress.md` on disk and only the config knows which one is
# current. A glob picking the alphabetically-first one would silently rebind an
# established repo to a finished milestone.
ADOPTED=""
if [ -z "$WORKSPACE" ] && [ -n "$MILESTONE" ]; then
	WORKSPACE=".agy/work/$MILESTONE"
fi
if [ -z "$WORKSPACE" ] && [ -n "$CONFIG_WORKSPACE" ]; then
	WORKSPACE="$CONFIG_WORKSPACE"
	ADOPTED="$ADOPTED config"
fi
if [ -z "$WORKSPACE" ]; then
	newest=""
	for candidate in .superpowers/sdd/*/ .agy/work/*/; do
		[ -d "$candidate" ] || continue
		[ -f "${candidate}progress.md" ] || continue
		if [ -z "$newest" ] || [ "${candidate}progress.md" -nt "$newest" ]; then
			newest="${candidate}progress.md"
			WORKSPACE="${candidate%/}"
		fi
	done
	[ -n "$WORKSPACE" ] && ADOPTED="$ADOPTED workspace"
fi
[ -n "$WORKSPACE" ] || WORKSPACE=".agy/work/${MILESTONE:-m1}"
WORKSPACE="${WORKSPACE#./}"

if [ -z "$GATES" ]; then
	for candidate in scripts/gates bin/gates ./gates; do
		if [ -f "$candidate" ]; then
			GATES="${candidate#./}"
			ADOPTED="$ADOPTED gates"
			break
		fi
	done
fi
[ -n "$GATES" ] || GATES=".agy/gates"

printf -- '--- plan -----------------------------------------------------------\n'
say workspace "$WORKSPACE"
if [ -n "$CONFIG_WORKSPACE" ] && [ "$CONFIG_WORKSPACE" != "$WORKSPACE" ]; then
	say milestone "moving: $CONFIG_WORKSPACE -> $WORKSPACE (AGY_WORKSPACE is repointed)"
fi
say gates     "$GATES"
say branch    "$BRANCH"
[ -n "$GUARD_TREE" ] && say tree "$GUARD_TREE (size+mtime fence)"
[ -n "$ADOPTED" ] && say adopted "existing:$ADOPTED"
printf '\n'

# ------------------------------------------------------------------- detection
# Guard surfaces: .agy always (a run must not edit its own fence), plus any
# specification or agent-instruction directory that exists. Source directories
# are deliberately NOT guarded — the implementer must edit those, and git is
# the guard there.
# .agy and .claude are unconditional: this installer is about to populate both,
# so "does it exist yet" is the wrong question for them.
#
# Both lists are built ONE PATH PER LINE, and written into the config that way.
# A whitespace-separated list cannot express a path containing a space, and the
# way it fails is silent: "Client Site app" becomes three nonexistent surfaces,
# each fingerprints nothing, and the fence reports clean while guarding nothing.
# $HOME alone is enough to hit this on Windows ("C:\Users\Firstname Lastname").
# The newline form is what the tripwire's split_list reads as one path per line,
# so writing it here is both the fix and the worked example for anyone editing
# the config later.
GUARD_DIRS=".agy
.claude"
for d in docs spec specs .github; do
	[ -d "$d" ] && GUARD_DIRS="$GUARD_DIRS
$d"
done

# Config files outside the repo that a run must not rewrite.
GUARD_FILES=""
for f in "$HOME/.gemini/antigravity-cli/settings.json" \
	"$HOME/.gemini/config/config.json" \
	"$HOME/.claude/settings.json"; do
	[ -f "$f" ] && GUARD_FILES="${GUARD_FILES:+$GUARD_FILES
}${f/#$HOME/\~}"
done

# A surface that must never legitimately come back empty. Computed now, from
# what is actually on disk, so the fence can tell "nothing changed" apart from
# "the fingerprinter broke".
REQUIRE=""
while IFS= read -r d; do
	[ -n "$d" ] || continue
	name="$(printf '%s' "$d" | sed -e 's#^\.##' -e 's#[/ ]#-#g')"
	# .agy and .claude are about to be populated; count them regardless.
	if [ "$d" = ".agy" ] || [ "$d" = ".claude" ] || [ -n "$(find "$d" -type f -print -quit 2>/dev/null)" ]; then
		REQUIRE="$REQUIRE $name"
	fi
done <<< "$GUARD_DIRS"
[ -n "$GUARD_TREE" ] && REQUIRE="$REQUIRE tree"
REQUIRE="${REQUIRE# }"

# Gate detection. Emits `gate`/`gate_line` lines for .agy/gates. Anything it is
# not sure about is emitted commented-out with a TODO, never silently dropped.
detect_gates() {
	local found=0

	if [ -f composer.json ]; then
		[ -f vendor/bin/phpunit ]  && { printf "gate_line   tests   '^(OK|Tests:|FAILURES|ERRORS)' php vendor/bin/phpunit\n"; found=1; }
		[ -f vendor/bin/phpcs ]    && { printf 'gate        lint    php vendor/bin/phpcs\n'; found=1; }
		[ -f vendor/bin/phpstan ]  && { printf 'gate        types   php vendor/bin/phpstan analyse --no-progress\n'; found=1; }
	fi

	if [ -f package.json ] && command -v node >/dev/null 2>&1; then
		local scripts
		scripts="$(node -e '
			try {
				const p = require(process.cwd() + "/package.json");
				const s = p.scripts || {};
				const want = ["test","lint","typecheck","type-check","tsc","build","check"];
				for (const k of want) if (s[k]) console.log(k);
			} catch (e) {}
		' 2>/dev/null)"
		local k
		for k in $scripts; do
			case "$k" in
			test)  printf "gate_line   tests   '(pass|fail|tests?)' npm test --silent\n" ;;
			build) printf 'gate        build   npm run build --silent\n' ;;
			*)     printf 'gate        %-7s npm run %s --silent\n' "$k" "$k" ;;
			esac
			found=1
		done
	fi

	if [ -f Cargo.toml ]; then
		printf "gate_line   tests   'test result' cargo test --quiet\n"
		printf 'gate        lint    cargo clippy --quiet -- -D warnings\n'
		printf 'gate        fmt     cargo fmt --check\n'
		found=1
	fi

	if [ -f go.mod ]; then
		printf 'gate        tests   go test ./...\n'
		printf 'gate        vet     go vet ./...\n'
		found=1
	fi

	if [ -f pyproject.toml ] || [ -f requirements.txt ]; then
		command -v pytest >/dev/null 2>&1 && printf "gate_line   tests   '(passed|failed|error)' pytest -q\n"
		command -v ruff   >/dev/null 2>&1 && printf 'gate        lint    ruff check .\n'
		command -v mypy   >/dev/null 2>&1 && printf 'gate        types   mypy .\n'
		found=1
	fi

	if [ "$found" -eq 0 ]; then
		printf '# TODO: no toolchain was detected here. Add your real gates, e.g.\n'
		printf '#   gate      tests   <your test command>\n'
		printf '#   gate      lint    <your lint command>\n'
		printf '#\n'
		printf '# Until at least one uncommented gate exists, this script exits 1 on\n'
		printf '# purpose. That is the protocol working: an unverified dispatch is\n'
		printf '# worse than no dispatch, because its report gets believed.\n'
	fi
}

# ------------------------------------------------------------------- write it
printf -- '--- writing --------------------------------------------------------\n'

if do_it; then mkdir -p .agy "$WORKSPACE/logs"; fi
say mkdir ".agy/ and $WORKSPACE/logs/"

for f in dispatch tripwire review-pkg fingerprint-tree.ps1; do
	if do_it; then
		cp "$ASSETS/$f" ".agy/$f" || exit 1
		case "$f" in *.ps1) ;; *) chmod +x ".agy/$f" ;; esac
	fi
	say script ".agy/$f"
done

# Gates: never clobber one that already exists and may have been tuned.
if [ "$GATES" = ".agy/gates" ]; then
	if [ -f .agy/gates ] && [ "$FORCE" -eq 0 ]; then
		say keep '.agy/gates (already present — pass --force to regenerate)'
	else
		if do_it; then
			detected="$(detect_gates)"
			# Substitute at the marker without a shell expansion of the payload.
			awk -v repl="$detected" '
				/#AGY_INSTALLER_GATES#/ { print repl; next }
				{ print }
			' "$ASSETS/gates" > .agy/gates || exit 1
			chmod +x .agy/gates
		fi
		say write ".agy/gates ($( detect_gates | grep -c '^gate' ) gate(s) detected)"
	fi
else
	say adopt "$GATES (left exactly as it is)"
fi

# An adopted runner is the project's own script and does not source .agy/config.
# Exports here still reach it through the dispatch's environment, but they will
# NOT be there if you run the runner by hand — which is exactly when a missing
# PATH entry looks like a real gate failure. Say so rather than let it surprise.
if [ "$GATES" = ".agy/gates" ]; then
	ENV_CAVEAT=""
else
	ENV_CAVEAT="
#
# \`$GATES\` is your own script and does not read this file, so a bare
# \`$GATES\` run will not have these. Add \`[ -f .agy/config ] && . .agy/config\`
# to it if you want the two paths to behave identically."
fi

# Config: the one file that is genuinely the project's. Never silently rewritten.
#
# The text is generated on every run whether or not it will be installed, into a
# temp file, because a kept config has to be compared against it. Otherwise a key
# introduced by a later version of this skill never reaches a repo installed
# before it existed — and the repos that most need a new control are exactly the
# ones already running the harness. AGY_COAUTHOR is what made that visible: the
# four scripts ARE refreshed on every install, so an old repo got the trailer
# check and no value for it to check against, and an unset AGY_COAUTHOR means
# off. The check arrived and did nothing, which is worse than not shipping it.
CONFIG_KEPT=0
REPOINT_FAILED=0
CFG_ADDED=""
CA_MOVED=0
CFG_NEW="${TMPDIR:-/tmp}/agy-config.$$"
cat > "$CFG_NEW" <<CONFIG
# .agy/config — sourced by every .agy script.
#
# Every value uses the \`: "\${VAR:=default}"\` form, so an environment variable
# of the same name always wins over what is written here. That is how a
# one-off override works:  AGY_FALLBACK=force .agy/dispatch 4
#
# Written by the agy-agents installer on $TODAY. Yours to edit thereafter.

# ---------------------------------------------------------------- where things are
: "\${AGY_WORKSPACE:=$WORKSPACE}"
: "\${AGY_LEDGER:=\$AGY_WORKSPACE/progress.md}"
: "\${AGY_GATES:=$GATES}"

# ------------------------------------------------------------------------- models
# Gemini is primary. The Claude/GPT group is a separate quota bucket that
# drains much faster for the same work, so it is a reserve, entered only on a
# clear *weekly* Gemini exhaustion. See .agy/dispatch's header.
: "\${AGY_MODEL:=gemini-3.7-flash-high}"
: "\${AGY_FALLBACK_MODEL:=claude-opus-4-6-thinking}"
: "\${AGY_FALLBACK:=auto}"
: "\${AGY_EFFORT:=high}"
: "\${AGY_TIMEOUT:=45m}"

# ------------------------------------------------------------------------- fence
# Surfaces the implementer must never touch. Source directories are absent on
# purpose: the implementer has to edit those, and git is the guard there.
#
# Note that .agy guards the harness against itself. The workspace inside it is
# pruned automatically (every dispatch writes logs there), but the ledger is
# guarded as a file — so do not edit progress.md while a dispatch is running.
#
# ONE PATH PER LINE. A list containing a newline is split on newlines, so a
# path with a space in it stays one path. Written on a single line instead, it
# splits on spaces into fragments that do not exist — and a surface that
# fingerprints nothing reports clean. Adding a path? Give it its own line.
# A path listed here that is not on disk makes the fence refuse to arm.
: "\${AGY_GUARD_DIRS:=$GUARD_DIRS}"
: "\${AGY_GUARD_FILES:=$GUARD_FILES}"

# An external read-only tree (a dev site, a data directory). Fingerprinted by
# size+mtime rather than content, because content-hashing tens of thousands of
# files is slow enough that the fence stops being run. Leave empty if none.
: "\${AGY_GUARD_TREE:=$GUARD_TREE}"
: "\${AGY_GUARD_TREE_SKIP:=uploads database upgrade cache tmp *.log *.sqlite*}"

# Surfaces that must never come back empty. If one does, the fingerprinter
# broke — and a broken fence reporting "clean" is worse than no fence.
: "\${AGY_REQUIRE:=$REQUIRE}"

# ------------------------------------------------------------------ attribution
# The one \`Co-Authored-By:\` address a landed commit may carry. This value was
# substituted into dispatch-context.md at install, so the instruction the model
# reads and the check the harness runs come from here — one source, two
# renderings, nothing to drift apart. Change it in one place and the other stops
# matching, which \`.agy/dispatch\` refuses to run on; change both, or re-install.
#
# GitHub matches co-author trailers to accounts BY EMAIL — the display name is
# cosmetic and ignored — and counts them on the contributor graph. So there are
# exactly two defensible answers here, and the space between them is the bug:
#
#   AN ADDRESS YOU OWN. Credits your account or your organisation for work your
#   harness produced. True, and visible as such. Prefer a dedicated mailbox
#   (agy@example.com) over a personal or general one: it reads as machine
#   authorship in \`git log\` instead of quietly inflating a human's graph.
#
#   AN ADDRESS NOBODY CAN OWN. Credits no account at all. \`.invalid\` is
#   reserved by RFC 2606 and can never be registered, so nobody can ever verify
#   an address there. This is the shipped default, because a default that
#   credits somebody credits the wrong somebody.
#
# What is never right is an address belonging to a third party. This defaulted
# to antigravity@google.com once, and every repo the harness touched published a
# claim of authorship against a live account whose owner had never had access.
# \`<name>@users.noreply.github.com\` is not the safe-looking middle: that form
# resolves to the GitHub user of that name, and \`antigravity\` is a real one.
#
# Set empty to switch the check off entirely — \`AGY_COAUTHOR=\` here, or in the
# environment. Note the assignment below is \`=\` and not \`:=\` for exactly that
# reason: with \`:=\` an empty value is indistinguishable from an unset one and
# the default would come straight back, so there would be no way to opt out
# short of deleting the check. Opt out by emptying it, never by widening it to
# something that matches anything.
: "\${AGY_COAUTHOR=$COAUTHOR}"

# --------------------------------------------------------------- project environment
# Anything the gates and the implementer both need. \`.agy/dispatch\` sources
# this file before it runs \`$GATES\`, so exports here reach the gates on every
# dispatch.$ENV_CAVEAT
#
# export PATH="\$PWD/dev-tools/php:\$PATH"
# export APP_ENV=test
CONFIG

if [ -f .agy/config ] && [ "$FORCE" -eq 0 ]; then
	CONFIG_KEPT=1
	say keep '.agy/config (already present — pass --force to regenerate)'

	# Additions only. Nothing already in the file is read for its value,
	# rewritten, or reordered — it stays the project's. Appending is safe on its
	# own terms too: every binding is `${VAR:=...}` or `${VAR=...}`, so a value
	# set earlier in the file wins over an assignment below it and a late block
	# cannot override a deliberate edit even if the name match were wrong.
	for key in $(sed -n 's/^:[[:space:]]*"\${\([A-Z_][A-Z_0-9]*\)[:=].*/\1/p' "$CFG_NEW"); do
		grep -qE "\b$key\b" .agy/config 2>/dev/null || CFG_ADDED="$CFG_ADDED $key"
	done
	# --coauthor against a config that already carries one. The flag is the most
	# specific source there is, and the docs name it as the way to change this
	# address — so it cannot be the one thing a kept config silently ignores.
	# That would be the migration trap again, one level up: the documented fix
	# doing nothing on the only repos that need it. Same surgery as the
	# milestone repoint — one line, in place, verified by re-reading.
	if [ "$CFG_HAS_CA" -eq 1 ] && [ "$COAUTHOR" != "$CFG_CA" ]; then
		if do_it; then
			tmp_cfg=".agy/config.coauthor.$$"
			awk -v new="$COAUTHOR" '
				/^[[:space:]]*:[[:space:]]*"\$\{AGY_COAUTHOR=/ {
					print ": \"${AGY_COAUTHOR=" new "}\""; next
				}
				{ print }
			' .agy/config > "$tmp_cfg" && mv "$tmp_cfg" .agy/config
			rm -f "$tmp_cfg"
			now="$( unset AGY_COAUTHOR; . ./.agy/config >/dev/null 2>&1
			        printf '%s' "${AGY_COAUTHOR-}" )"
			if [ "$now" = "$COAUTHOR" ]; then
				say repoint "AGY_COAUTHOR: ${CFG_CA:-<empty>} -> ${COAUTHOR:-<empty>}"
				CA_MOVED=1
			else
				say repoint "COULD NOT REPOINT — AGY_COAUTHOR still resolves to '${now:-<empty>}'"
				say ''      'Edit .agy/config by hand. The trailer check reads that'
				say ''      'value, and dispatch refuses while it and the context differ.'
				REPOINT_FAILED=1
			fi
		else
			say repoint "AGY_COAUTHOR: ${CFG_CA:-<empty>} -> ${COAUTHOR:-<empty>}"
		fi
	fi

	if [ -n "$CFG_ADDED" ]; then
		for key in $CFG_ADDED; do
			say add ".agy/config: $key — new in this version, was not set here"
		done
		if do_it; then
			{
				printf '\n# ------------------------------------- added by the installer on %s\n' "$TODAY"
				printf '# Keys this version of agy-agents defines that this file did not carry.\n'
				printf '# Appended, never merged: nothing above this line was read or changed.\n'
				# A key's comment block is the run of `#` lines directly above it,
				# and it travels with the key. A control that arrives without the
				# paragraph explaining it is a line somebody deletes later for
				# looking like noise.
				awk -v want=" $CFG_ADDED " '
					/^#/             { buf = buf $0 "\n"; next }
					/^[[:space:]]*$/ { buf = ""; next }
					{
						if (match($0, /\$\{[A-Z_][A-Z_0-9]*/)) {
							k = substr($0, RSTART + 2, RLENGTH - 2)
							if (index(want, " " k " ")) printf "\n%s%s\n", buf, $0
						}
						buf = ""
					}
				' "$CFG_NEW"
			} >> .agy/config
		fi
	fi
else
	if do_it; then cp "$CFG_NEW" .agy/config; fi
	say write '.agy/config'
fi
rm -f "$CFG_NEW"

# Printed on every run, kept or written. This value lands on a contributor
# graph, and which of four sources supplied it is not something to leave the
# reader to work out from what they did not pass.
if [ -n "$COAUTHOR" ]; then
	say trailer "$COAUTHOR ($COAUTHOR_SRC)"
else
	say trailer "none — the co-author check is OFF ($COAUTHOR_SRC)"
fi

# Advancing a milestone. `--milestone m6` used to scaffold .agy/work/m6 and then
# leave AGY_WORKSPACE pointing at m5, because a config that exists is kept and
# --force (the only way to rewrite it) also clobbers the gates. Every script
# kept using m5 while the new workspace sat there looking adopted. So the one
# line that binds the milestone is repointed on its own, and the rest of the
# config — gates, models, guard lists, project environment — is left untouched.
if [ "$CONFIG_KEPT" -eq 1 ] && [ -n "$CONFIG_WORKSPACE" ] && [ "$CONFIG_WORKSPACE" != "$WORKSPACE" ]; then
	if do_it; then
		tmp_cfg=".agy/config.repoint.$$"
		awk -v new="$WORKSPACE" '
			/^[[:space:]]*:[[:space:]]*"\$\{AGY_WORKSPACE:=/ {
				print ": \"${AGY_WORKSPACE:=" new "}\""; next
			}
			{ print }
		' .agy/config > "$tmp_cfg" && mv "$tmp_cfg" .agy/config
		rm -f "$tmp_cfg"
		# Verified by re-reading, not assumed: a hand-edited config may hold the
		# binding in a form the rewrite above does not match, and a repoint that
		# silently did nothing is the exact failure this is here to end.
		now="$(cfg_workspace)"
		if [ "${now#./}" = "$WORKSPACE" ]; then
			say repoint "AGY_WORKSPACE: $CONFIG_WORKSPACE -> $WORKSPACE"
		else
			say repoint "COULD NOT REPOINT — AGY_WORKSPACE still resolves to '${now:-<empty>}'"
			say ''      "Edit .agy/config by hand. Dispatch, fence and gates all read"
			say ''      "that value; nothing reads this run's --milestone."
			REPOINT_FAILED=1
		fi
	else
		say repoint "AGY_WORKSPACE: $CONFIG_WORKSPACE -> $WORKSPACE"
	fi
fi

# Workspace scaffolding.
subst() {
	sed -e "s#{{PROJECT}}#$PROJECT#g" \
		-e "s#{{WORKSPACE}}#$WORKSPACE#g" \
		-e "s#{{ROOT}}#$ROOT#g" \
		-e "s#{{BRANCH}}#$BRANCH#g" \
		-e "s#{{DATE}}#$TODAY#g" \
		-e "s#{{GATES}}#$GATES#g" \
		-e "s#{{PLAN_PATH}}#${PLAN:-<no plan recorded>}#g" \
		-e "s#{{PROTOCOL}}#$SKILL_DIR/reference/protocol.md#g" \
		-e "s#{{MODEL}}#gemini-3.7-flash-high#g" \
		-e "s#{{FALLBACK_MODEL}}#claude-opus-4-6-thinking#g" \
		-e "s#{{COAUTHOR}}#$COAUTHOR#g" \
		"$1"
}

for pair in "dispatch-context.md:$WORKSPACE/dispatch-context.md" \
	"progress.md:$WORKSPACE/progress.md" \
	"task-dispatch.md:$WORKSPACE/task-dispatch.template.md" \
	"plan-dispatch.md:$WORKSPACE/plan-dispatch.template.md"; do
	src="${pair%%:*}"; dst="${pair#*:}"
	if [ -f "$dst" ] && [ "$FORCE" -eq 0 ]; then
		say keep "$dst"
	else
		if do_it; then subst "$ASSETS/templates/$src" > "$dst" || exit 1; fi
		say write "$dst"
	fi
done

# Project-local skill: how a fresh session in this repo discovers the protocol.
if [ -f .claude/skills/agy-task-cycle/SKILL.md ] && [ "$FORCE" -eq 0 ]; then
	say keep '.claude/skills/agy-task-cycle/SKILL.md'
else
	if do_it; then
		mkdir -p .claude/skills/agy-task-cycle
		subst "$ASSETS/templates/project-skill.md" > .claude/skills/agy-task-cycle/SKILL.md || exit 1
	fi
	say write '.claude/skills/agy-task-cycle/SKILL.md'
fi

# Logs and fence snapshots are noise; briefs, reports, reviews and the ledger
# are the project's decision record and stay in git.
if [ ! -f .agy/.gitignore ] || [ "$FORCE" -eq 1 ]; then
	if do_it; then
		printf 'work/*/logs/\nwork/*/*.diff\n' > .agy/.gitignore
	fi
	say write '.agy/.gitignore (logs and review packages only)'
fi

# ------------------------------------------------------------------ verify it
printf '\n--- checking -------------------------------------------------------\n'
if [ "$DRY" -eq 1 ]; then
	printf '  dry run — nothing written, nothing checked\n'
	exit 0
fi

problems=0

# A config still bound to the previous milestone is worse than an obvious
# failure: the new workspace exists, looks live, and nothing writes to it.
[ "$REPOINT_FAILED" -eq 1 ] && problems=$((problems + 1))

if command -v agy >/dev/null 2>&1 || [ -x "$HOME/AppData/Local/agy/bin/agy.exe" ]; then
	say agy 'found'
else
	say agy 'NOT FOUND — install the Antigravity CLI before dispatching'
	problems=$((problems + 1))
fi

if command -v node >/dev/null 2>&1; then
	say node 'found'
else
	say node 'NOT FOUND — the fence differ and the stream parser both need it'
	problems=$((problems + 1))
fi

# A Windows-form PATH entry is accepted by the shell and then never searched, so
# whatever you put there is skipped without a word and the next match on PATH
# answers instead. That is how a drill against a stubbed `agy` dispatched the
# real one and spent live quota. Cheap to detect, invisible otherwise.
case "$(uname -s 2>/dev/null)" in
MINGW*|MSYS*|CYGWIN*)
	if printf '%s' "$PATH" | grep -qE '(^|:)[A-Za-z]:[\\/]'; then
		say path 'a Windows-form entry (C:\...) is on PATH — MSYS ignores those'
		say ''   'silently. Convert it with `cygpath -u` or the binary you think'
		say ''   'is being used will not be the one that runs.'
		problems=$((problems + 1))
	fi
	;;
esac

# The templates ship unfilled on purpose — only you know what goes in them — but
# nothing used to check that they were ever filled, and dispatch-context.md is
# the file every implementer and reviewer inherits. `.agy/dispatch` now refuses
# on it; say so here rather than letting the first dispatch be the messenger.
CTX="$WORKSPACE/dispatch-context.md"
unfilled="$(grep -c -e '{{[^}]*}}' -e 'Delete this quote block' "$CTX" 2>/dev/null || true)"
if [ "${unfilled:-0}" -gt 0 ]; then
	say context "$unfilled unfilled line(s) in $CTX"
	say ''      '.agy/dispatch REFUSES to run until they are filled — see step 1.'
	# The shared context describes the project, not the milestone, so on a move
	# it is almost always the previous one you want rather than a blank template.
	if [ -n "$CONFIG_WORKSPACE" ] && [ "$CONFIG_WORKSPACE" != "$WORKSPACE" ] \
		&& [ -f "$CONFIG_WORKSPACE/dispatch-context.md" ]; then
		say '' "the previous milestone has one — carry it over rather than refill:"
		say '' "cp '$CONFIG_WORKSPACE/dispatch-context.md' '$CTX'"
	fi
	problems=$((problems + 1))
else
	say context "$CTX is filled in"
fi

# Adding AGY_COAUTHOR to a config that never carried it turns the trailer check
# on, and `.agy/dispatch` refuses to run while the context does not name the
# same address. That refusal is correct, and arriving at it on the next dispatch
# — in a repo where nothing about this install looked like it changed the rules
# — is how a correct refusal gets read as a broken harness. So it is said here,
# with the line to paste, by the run that caused it.
ca_changed=0
case " $CFG_ADDED " in *' AGY_COAUTHOR '*) ca_changed=1 ;; esac
[ "$CA_MOVED" -eq 1 ] && ca_changed=1
if [ "$ca_changed" -eq 1 ] && [ -n "$COAUTHOR" ] && [ -f "$CTX" ]; then
	ca_addr="$(printf '%s' "$COAUTHOR" |
		sed -n 's/.*<\([^>]*\)>.*/\1/p' | tr 'A-Z' 'a-z')"
	[ -n "$ca_addr" ] || ca_addr="$(printf '%s' "$COAUTHOR" | tr 'A-Z' 'a-z')"
	if ! tr 'A-Z' 'a-z' <"$CTX" | grep -qF -- "$ca_addr"; then
		# The context is a kept file, so it is repaired only where its shape is
		# ours to know: a `Co-Authored-By:` line came from our template and is
		# safe to rewrite. Anything else is the user's prose, and the most this
		# can honestly do there is say what to paste.
		if grep -q '^[[:space:]]*Co-Authored-By:' "$CTX" 2>/dev/null && do_it; then
			tmp_ctx="$CTX.coauthor.$$"
			sed "s#^\([[:space:]]*\)Co-Authored-By:.*#\1Co-Authored-By: $COAUTHOR#" \
				"$CTX" > "$tmp_ctx" && mv "$tmp_ctx" "$CTX"
			rm -f "$tmp_ctx"
			say trailer "rewrote the trailer in $CTX to match"
		else
			say trailer "the co-author check is now ON and $CTX does not carry it"
			say ''      '.agy/dispatch REFUSES to run until it does. Add this to the'
			say ''      '"Definition of done" block, exactly:'
			say ''      "Co-Authored-By: $COAUTHOR"
			problems=$((problems + 1))
		fi
	fi
fi

printf '\n'
if bash .agy/tripwire check >/dev/null 2>&1; then
	say fence 'arms and verifies clean'
else
	say fence 'FAILS ITS OWN SELF-TEST — run `bash .agy/tripwire check` and read it'
	problems=$((problems + 1))
fi

if bash "$GATES" >/dev/null 2>&1; then
	say gates 'green'
else
	rc=$?
	if [ "$GATES" = ".agy/gates" ] && ! grep -qE '^\s*gate(_line)?\s' .agy/gates; then
		say gates 'none configured — .agy/gates exits 1 until you add real ones'
		problems=$((problems + 1))
	else
		say gates "$rc failing (that may be the truth about this tree, not a wiring problem)"
	fi
fi

printf '\n--- next -----------------------------------------------------------\n'
cat <<NEXT
  1. Fill in $WORKSPACE/dispatch-context.md — every {{marker}} in it,
     and delete the quoted note at the top. Every agent reads this file, so an
     omission there is inherited by all of them; .agy/dispatch refuses to run
     while any marker is left.
  2. Make $GATES real, and confirm it fails when the tree is broken.
     A gate you have never seen go red is not yet a gate.
  3. Review the fence: bash .agy/tripwire surfaces
  4. Write $WORKSPACE/task-1-dispatch.md from
     $WORKSPACE/task-dispatch.template.md, then: .agy/dispatch 1
NEXT

[ "$problems" -gt 0 ] && printf '\n  %d thing(s) above need attention before the first dispatch.\n' "$problems"
exit 0
